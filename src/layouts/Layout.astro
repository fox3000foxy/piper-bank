---
import { localizedPath, t, type Locale } from '../i18n/ui';

const { title, rawTitle, active, description, pageUrl, image, locale = 'fr' as Locale, noindex = false, breadcrumbs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = 'https://piperhub.org';
const desc = description || t(locale, 'site.description');
const url = site + localizedPath(base, locale, pageUrl || '/');
const img = image ? site + image : site + base + 'logo.png';
const frenchUrl = site + localizedPath(base, 'fr', pageUrl || '/');
const englishUrl = site + localizedPath(base, 'en', pageUrl || '/');
const fullTitle = rawTitle || `${title} · PiperHub`;
const isHome = (pageUrl || '/') === '/' && !noindex;
const jsonLd: Record<string, unknown>[] = [];
if (isHome) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'PiperHub',
    alternateName: ['Piper Hub', 'piperhub.org'],
    url: site + '/',
    inLanguage: ['en', 'fr'],
  });
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'PiperHub',
    url: site + '/',
    logo: site + '/logo.png',
    sameAs: ['https://github.com/fox3000foxy/piper-bank'],
  });
}
if (breadcrumbs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b: { name: string; path: string }, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: site + localizedPath(base, locale, b.path),
    })),
  });
}
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}android-icon-192x192.png`} />
    <link rel="apple-touch-icon" sizes="57x57" href={`${base}apple-icon-57x57.png`} />
    <link rel="apple-touch-icon" sizes="60x60" href={`${base}apple-icon-60x60.png`} />
    <link rel="apple-touch-icon" sizes="72x72" href={`${base}apple-icon-72x72.png`} />
    <link rel="apple-touch-icon" sizes="76x76" href={`${base}apple-icon-76x76.png`} />
    <link rel="apple-touch-icon" sizes="114x114" href={`${base}apple-icon-114x114.png`} />
    <link rel="apple-touch-icon" sizes="120x120" href={`${base}apple-icon-120x120.png`} />
    <link rel="apple-touch-icon" sizes="144x144" href={`${base}apple-icon-144x144.png`} />
    <link rel="apple-touch-icon" sizes="152x152" href={`${base}apple-icon-152x152.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-icon-180x180.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-icon.png`} />
    <link rel="manifest" href={`${base}manifest.json`} />
    <link rel="alternate" type="application/rss+xml" title="PiperHub · nouvelles voix" href={`${base}rss.xml`} />
    <meta name="msapplication-TileColor" content="#7c3aed" />
    <meta name="msapplication-TileImage" content={`${base}ms-icon-144x144.png`} />
    <meta name="theme-color" content="#7c3aed" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('piper-theme');
        const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    <link rel="preload" href={`${base}fonts/archivo-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://huggingface.co" />
    <link rel="preconnect" href="https://huggingface.co" crossorigin />
    <link rel="stylesheet" href={`${base}site.css`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PiperHub" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={img} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="fr" href={frenchUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={img} />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={localizedPath(base, locale, '/')} aria-label={`PiperHub, ${t(locale, 'nav.home').toLowerCase()}`}><img src={`${base}logo.png`} alt="" /><span class="wordmark-name"><span class="wordmark-piper">Piper</span><span class="wordmark-bank">Hub</span></span></a>
      <nav class="topnav" aria-label={t(locale, 'nav.main')}>
        <a class={active === 'home' ? 'nav-on' : ''} href={localizedPath(base, locale, '/')}>{t(locale, 'nav.home')}</a>
        <a class={active === 'voices' ? 'nav-on' : ''} href={localizedPath(base, locale, '/voices/')}>{t(locale, 'nav.voices')}</a>
        <a class={active === 'datasets' ? 'nav-on' : ''} href={localizedPath(base, locale, '/datasets/')}>{t(locale, 'nav.datasets')}</a>
        <a class={active === 'guides' ? 'nav-on' : ''} href={localizedPath(base, locale, '/guides/')}>{t(locale, 'nav.guides')}</a>
      </nav>
      <div class="header-end">
        <a class="header-project" href="https://github.com/fox3000foxy/piper-bank" target="_blank" rel="noreferrer">{t(locale, 'nav.project')} <span aria-hidden="true">↗</span></a>
        <nav class="locale-picker" aria-label={t(locale, 'language.label')}>
          <a href={localizedPath(base, 'fr', pageUrl || '/')} aria-current={locale === 'fr' ? 'page' : undefined}>FR</a>
          <span aria-hidden="true">·</span>
          <a href={localizedPath(base, 'en', pageUrl || '/')} aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
        </nav>
        <label class="theme-toggle" for="theme-toggle" aria-label={t(locale, 'theme.change')} title={t(locale, 'theme.change')}>
          <input type="checkbox" id="theme-toggle" class="theme-checkbox" />
          <svg class="icon-sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.4"/><path d="M10 1.75v2M10 16.25v2M18.25 10h-2M3.75 10h-2m14.08-5.83-1.41 1.41M5.58 14.42l-1.41 1.41m11.66 0-1.41-1.41M5.58 5.58 4.17 4.17"/></svg>
          <svg class="icon-moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16.8 12.4A7 7 0 0 1 7.6 3.2a7.2 7.2 0 1 0 9.2 9.2Z"/></svg>
        </label>
      </div>
    </header>
    <script is:inline>
      (() => {
        const box = document.getElementById('theme-toggle');
        if (!(box instanceof HTMLInputElement)) return;
        let saved = null;
        try { saved = localStorage.getItem('piper-theme'); } catch {}
        const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        box.checked = dark;
        const sync = () => { document.documentElement.dataset.theme = box.checked ? 'dark' : 'light'; };
        sync();
        box.addEventListener('change', () => {
          try { localStorage.setItem('piper-theme', box.checked ? 'dark' : 'light'); } catch {}
          sync();
        });
      })();
    </script>
    <slot />
    <footer class="site-footer">
      <a class="wordmark footer-mark" href={localizedPath(base, locale, '/')}><img src={`${base}logo.png`} alt="" /><span class="wordmark-name"><span class="wordmark-piper">Piper</span><span class="wordmark-bank">Hub</span></span></a>
      <p>{t(locale, 'footer.description')}<br />{t(locale, 'footer.licenses')}</p>
      <nav aria-label={t(locale, 'nav.footerLinks')}>
        <a href={localizedPath(base, locale, '/voices/')}>{t(locale, 'nav.voices')}</a>
        <a href={localizedPath(base, locale, '/datasets/')}>{t(locale, 'nav.datasets')}</a>
        <a href={localizedPath(base, locale, '/guides/')}>{t(locale, 'nav.guides')}</a>
        <a href={localizedPath(base, locale, '/privacy/')}>{t(locale, 'footer.privacy')}</a>
        <a href={localizedPath(base, locale, '/terms/')}>{t(locale, 'footer.terms')}</a>
          <a href={localizedPath(base, locale, '/legal/')}>{t(locale, 'footer.legal')}</a>
          <a href={localizedPath(base, locale, '/contact/')}>{t(locale, 'footer.contact')}</a>
        <a href={`${base}rss.xml`}>{t(locale, 'footer.rss')}</a>
        <a href="https://github.com/fox3000foxy/piper-bank" target="_blank" rel="noreferrer">{t(locale, 'footer.source')} ↗</a>
      </nav>
      <span class="footer-note">{t(locale, 'footer.local')}</span>
    </footer>
    <script is:inline define:vars={{ swUrl: `${base}sw.js` }}>
      if ('serviceWorker' in navigator) window.addEventListener('load', () => {
        navigator.serviceWorker.register(swUrl).catch(() => {});
      });
    </script>
  </body>
</html>
