---
import { LOCALES, localeMeta, localizedPath, ogLocale, t, type Locale } from '../i18n/ui';
import Icon from '../components/Icon.astro';
import { docsNav } from '../lib/docs-nav';

const { title, rawTitle, active, description, pageUrl, image, locale = 'fr' as Locale, noindex = false, breadcrumbs = [], jsonLdExtra = [] as Record<string, unknown>[] } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = 'https://piperhub.org';
const desc = description || t(locale, 'site.description');
const url = site + localizedPath(base, locale, pageUrl || '/');
const img = image ? site + image : site + base + 'logo.png';
const englishUrl = site + localizedPath(base, 'en', pageUrl || '/');
const fullTitle = rawTitle || `${title} · PiperHub`;
const isHome = (pageUrl || '/') === '/' && !noindex;
const home = localizedPath(base, locale, '/');
const L = (p: string) => localizedPath(base, locale, p);
const docs = docsNav(locale);
// Localized static entries for the search palette (models/datasets come from /search-index.json).
const paletteStatic = [
  { t: t(locale, 'nav.voices'), d: t(locale, 'search.pageVoices'), u: L('/voices/'), i: 'mic', g: 'p' },
  { t: t(locale, 'nav.datasets'), d: t(locale, 'search.pageDatasets'), u: L('/datasets/'), i: 'database', g: 'p' },
  ...docs.flatMap((g) => g.items.map((it) => ({ t: it.title, d: g.label, u: L(it.path), i: it.icon, g: 'p' }))),
  { t: t(locale, 'footer.contact'), d: 'PiperHub', u: L('/contact/'), i: 'doc', g: 'p' },
];
const paletteUi = {
  home, base, locale, tag: localeMeta(locale).tag,
  voices: t(locale, 'nav.voices'), datasets: t(locale, 'nav.datasets'), languages: t(locale, 'search.languages'),
  pages: t(locale, 'search.pages'), empty: t(locale, 'search.noResults'), all: t(locale, 'search.seeAll'),
  speakers: t(locale, 'voices.speakerCount'), one: t(locale, 'common.oneSpeaker'), models: t(locale, 'voices.models'),
  q: { high: t(locale, 'quality.high'), medium: t(locale, 'quality.medium'), low: t(locale, 'quality.low'), unknown: t(locale, 'quality.unknown') },
};
const jsonLd: Record<string, unknown>[] = [];
if (isHome) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'PiperHub',
    alternateName: ['Piper Hub', 'piperhub.org'],
    url: site + '/',
    inLanguage: LOCALES.map((l) => l.code),
  });
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'PiperHub',
    url: site + '/',
    logo: site + '/logo.png',
    sameAs: ['https://github.com/fox3000foxy/piper-bank'],
  });
}
if (breadcrumbs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b: { name: string; path: string }, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: site + localizedPath(base, locale, b.path),
    })),
  });
}
---
<html lang={localeMeta(locale).tag} dir={localeMeta(locale).dir} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={`${base}favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}android-icon-192x192.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}favicon-48x48.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="57x57" href={`${base}apple-icon-57x57.png`} />
    <link rel="apple-touch-icon" sizes="60x60" href={`${base}apple-icon-60x60.png`} />
    <link rel="apple-touch-icon" sizes="72x72" href={`${base}apple-icon-72x72.png`} />
    <link rel="apple-touch-icon" sizes="76x76" href={`${base}apple-icon-76x76.png`} />
    <link rel="apple-touch-icon" sizes="114x114" href={`${base}apple-icon-114x114.png`} />
    <link rel="apple-touch-icon" sizes="120x120" href={`${base}apple-icon-120x120.png`} />
    <link rel="apple-touch-icon" sizes="144x144" href={`${base}apple-icon-144x144.png`} />
    <link rel="apple-touch-icon" sizes="152x152" href={`${base}apple-icon-152x152.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-icon-180x180.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-icon.png`} />
    <link rel="manifest" href={`${base}manifest.json`} />
    <link rel="alternate" type="application/rss+xml" title={`PiperHub · ${t(locale, 'footer.rss')}`} href={site + localizedPath(base, locale, '/rss.xml')} />
    <meta name="msapplication-TileColor" content="#7c3aed" />
    <meta name="msapplication-TileImage" content={`${base}ms-icon-144x144.png`} />
    <meta name="theme-color" content="#7c3aed" />
    {isHome && (
    <script is:inline define:vars={{ base }}>
      // First visit on the home page: follow the browser language once per session,
      // never after an explicit choice. Googlebot announces en-US: no SEO effect.
      try {
        if (!localStorage.getItem('piper-locale') && !sessionStorage.getItem('piper-locale-auto')) {
          var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en']);
          var codes = ['en', 'fr', 'de', 'es', 'it', 'pt', 'ru', 'tr', 'ja', 'ko', 'zh', 'id', 'hi', 'ar', 'vi', 'th'];
          var pick = 'en';
          var top = String(langs[0] || 'en').toLowerCase();
          for (var i = 0; i < codes.length; i++) {
            if (top === codes[i] || top.indexOf(codes[i] + '-') === 0) { pick = codes[i]; break; }
          }
          sessionStorage.setItem('piper-locale-auto', '1');
          if (pick !== 'en') {
            var b = base === '/' ? '' : String(base).replace(/\/+$/, '');
            location.replace(b + '/' + pick + '/');
          }
        }
      } catch (e) {}
    </script>
    )}
    <script is:inline>
      // Dark by default (brand). A saved choice wins.
      try { if (localStorage.getItem('piper-theme') === 'light') document.documentElement.dataset.theme = 'light'; } catch (e) {}
    </script>
    <link rel="preconnect" href="https://huggingface.co" />
    <link rel="preconnect" href="https://huggingface.co" crossorigin />
    <link rel="stylesheet" href={`${base}site.css`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PiperHub" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={img} />
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <link rel="canonical" href={url} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l.code} href={site + localizedPath(base, l.code, pageUrl || '/')} />)}
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {[...jsonLd, ...jsonLdExtra].map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={img} />
  </head>
  <body>
    <a class="skip-link" href="#content">{t(locale, 'a11y.skip')}</a>
    <header class="appbar">
      <div class="appbar-inner">
        <a class="brand" href={home} aria-label="PiperHub">
          <img class="brand-mark" src={`${base}brand/logo.png`} alt="" width="44" height="44" />
          <span class="brand-name" aria-hidden="true">Piper<b>Hub</b></span>
        </a>
        <nav class="appnav" aria-label={t(locale, 'nav.main')}>
          <a aria-current={active === 'voices' ? 'page' : undefined} href={L('/voices/')}>{t(locale, 'nav.voices')}</a>
          <a aria-current={active === 'datasets' ? 'page' : undefined} href={L('/datasets/')}>{t(locale, 'nav.datasets')}</a>
          <a aria-current={active === 'guides' ? 'page' : undefined} href={L('/guides/')}>{t(locale, 'nav.docs')}</a>
        </nav>
        <button class="search-trigger" type="button" data-palette-open aria-label={t(locale, 'search.open')}>
          <Icon name="search" size={16} />
          <span class="search-trigger-label">{t(locale, 'search.trigger')}</span>
          <kbd class="kbd" data-kbd-mod>Ctrl K</kbd>
        </button>
        <div class="appbar-tools">
          <details class="flyout lang-flyout">
            <summary class="icon-btn" aria-label={t(locale, 'language.label')} title={t(locale, 'language.label')}><Icon name="globe" size={18} /><span class="lang-code">{locale.toUpperCase()}</span></summary>
            <div class="flyout-panel" role="menu">
              {LOCALES.map((l) => <a role="menuitemradio" aria-checked={locale === l.code ? 'true' : 'false'} lang={l.tag} data-locale={l.code} href={localizedPath(base, l.code, pageUrl || '/')}><span>{l.name}</span>{locale === l.code && <Icon name="check" size={16} />}</a>)}
            </div>
          </details>
          <button class="icon-btn" type="button" id="theme-toggle" aria-label={t(locale, 'theme.change')} title={t(locale, 'theme.change')}>
            <span class="theme-dark-icon"><Icon name="moon" size={18} /></span><span class="theme-light-icon"><Icon name="sun" size={18} /></span>
          </button>
          <a class="icon-btn lib-link" href={L('/library/')} aria-label={t(locale, 'library.title')} title={t(locale, 'library.title')}><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M10 16.5s-6.25-3.6-6.25-8.1A3.4 3.4 0 0 1 10 6.3a3.4 3.4 0 0 1 6.25 2.1c0 4.5-6.25 8.1-6.25 8.1Z"/></svg><span class="lib-count" data-fav-count hidden>0</span></a>
          <a class="icon-btn hide-sm" href="https://github.com/fox3000foxy/piper-bank" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub"><Icon name="github" size={18} /></a>
          <button class="icon-btn menu-flyout-btn" type="button" id="menu-open" aria-label={t(locale, 'nav.main')} aria-expanded="false" aria-controls="menu-drawer" data-menu-btn><Icon name="menu" size={18} /></button>
          <details class="flyout menu-dropdown" data-menu-dropdown>
            <summary class="icon-btn menu-flyout-btn" aria-label={t(locale, 'nav.main')}><Icon name="menu" size={18} /></summary>
            <div class="flyout-panel" role="menu">
              <a role="menuitem" href={L('/voices/')}><Icon name="mic" size={16} />{t(locale, 'nav.voices')}</a>
              <a role="menuitem" href={L('/datasets/')}><Icon name="database" size={16} />{t(locale, 'nav.datasets')}</a>
              <a role="menuitem" href={L('/guides/')}><Icon name="book" size={16} />{t(locale, 'nav.docs')}</a>
              <a role="menuitem" href="https://github.com/fox3000foxy/piper-bank" target="_blank" rel="noreferrer"><Icon name="github" size={16} />GitHub</a>
              <span class="flyout-sep" aria-hidden="true"></span>
              <span class="flyout-label">{t(locale, 'language.label')}</span>
              {LOCALES.map((l) => <a role="menuitemradio" aria-checked={locale === l.code ? 'true' : 'false'} lang={l.tag} data-locale={l.code} href={localizedPath(base, l.code, pageUrl || '/')}><span>{l.name}</span>{locale === l.code && <Icon name="check" size={16} />}</a>)}
            </div>
          </details>
        </div>
      </div>
    </header>
    <div class="menu-scrim" id="menu-scrim"></div>
    <nav class="flyout menu-flyout" id="menu-drawer" aria-label={t(locale, 'nav.main')}>
        <div class="flyout-head"><span>{t(locale, 'nav.main')}</span><button class="icon-btn" type="button" id="menu-close" aria-label={t(locale, 'search.hintClose')}><Icon name="close" size={18} /></button></div>
        <div class="flyout-panel" role="menu">
          <a role="menuitem" href={L('/voices/')}><Icon name="mic" size={16} />{t(locale, 'nav.voices')}</a>
          <a role="menuitem" href={L('/datasets/')}><Icon name="database" size={16} />{t(locale, 'nav.datasets')}</a>
          <a role="menuitem" href={L('/guides/')}><Icon name="book" size={16} />{t(locale, 'nav.docs')}</a>
          <a role="menuitem" href="https://github.com/fox3000foxy/piper-bank" target="_blank" rel="noreferrer"><Icon name="github" size={16} />GitHub</a>
          <span class="flyout-sep" aria-hidden="true"></span>
          <span class="flyout-label">{t(locale, 'language.label')}</span>
          {LOCALES.map((l) => <a role="menuitemradio" aria-checked={locale === l.code ? 'true' : 'false'} lang={l.tag} data-locale={l.code} href={localizedPath(base, l.code, pageUrl || '/')}><span>{l.name}</span>{locale === l.code && <Icon name="check" size={16} />}</a>)}
        </div>
      </nav>
    <div id="content" class="page">
      <slot />
    </div>
    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="brand brand-lg" href={home} aria-label="PiperHub">
            <img class="brand-mark" src={`${base}brand/logo.png`} alt="" width="60" height="60" loading="lazy" />
            <span class="brand-name" aria-hidden="true">Piper<b>Hub</b></span>
          </a>
          <p>{t(locale, 'footer.description')} {t(locale, 'footer.licenses')}</p>
        </div>
        <nav class="footer-col" aria-label={t(locale, 'footer.catalog')}>
          <h2>{t(locale, 'footer.catalog')}</h2>
          <a href={L('/voices/')}>{t(locale, 'nav.voices')}</a>
          <a href={L('/datasets/')}>{t(locale, 'nav.datasets')}</a>
          <a href={L('/rss.xml')}>{t(locale, 'footer.rss')}</a>
        </nav>
        <nav class="footer-col" aria-label={t(locale, 'nav.docs')}>
          <h2>{t(locale, 'nav.docs')}</h2>
          {docs.flatMap((g) => g.items).slice(1).map((it) => <a href={L(it.path)}>{it.title}</a>)}
        </nav>
        <nav class="footer-col" aria-label={t(locale, 'footer.community')}>
          <h2>{t(locale, 'footer.community')}</h2>
          <a href="https://discord.gg/xDmDJwfbfp" target="_blank" rel="noreferrer">{t(locale, 'footer.discord')}</a>
          <a href="https://github.com/fox3000foxy/piper-bank" target="_blank" rel="noreferrer">{t(locale, 'footer.source')}</a>
          <a href={L('/contact/')}>{t(locale, 'footer.contact')}</a>
        </nav>
        <nav class="footer-col" aria-label={t(locale, 'footer.legalGroup')}>
          <h2>{t(locale, 'footer.legalGroup')}</h2>
          <a href={L('/privacy/')}>{t(locale, 'footer.privacy')}</a>
          <a href={L('/terms/')}>{t(locale, 'footer.terms')}</a>
          <a href={L('/legal/')}>{t(locale, 'footer.legal')}</a>
        </nav>
      </div>
      <div class="footer-base">
        <span>© {new Date().getFullYear()} PiperHub</span>
        <span class="footer-local"><Icon name="shield" size={16} />{t(locale, 'footer.local')}</span>
      </div>
    </footer>

    <dialog id="palette" class="palette" aria-label={t(locale, 'search.open')}>
      <div class="palette-box">
        <label class="palette-input">
          <Icon name="search" size={20} />
          <input id="palette-q" type="text" autocomplete="off" spellcheck="false" placeholder={t(locale, 'search.placeholder')} aria-controls="palette-list" aria-autocomplete="list" role="combobox" aria-expanded="true" />
          <kbd class="kbd">Esc</kbd>
        </label>
        <div id="palette-list" class="palette-list" role="listbox"></div>
        <div class="palette-foot">
          <span><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> {t(locale, 'search.hintNavigate')}</span>
          <span><kbd class="kbd">↵</kbd> {t(locale, 'search.hintOpen')}</span>
          <span><kbd class="kbd">Esc</kbd> {t(locale, 'search.hintClose')}</span>
        </div>
      </div>
    </dialog>
    <script is:inline type="application/json" id="palette-static" set:html={JSON.stringify(paletteStatic)} />
    <script is:inline type="application/json" id="palette-ui" set:html={JSON.stringify(paletteUi)} />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        if (btn) btn.addEventListener('click', function () {
          var next = root.dataset.theme === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try { localStorage.setItem('piper-theme', next); } catch (e) {}
        });
        document.querySelectorAll('[data-locale]').forEach(function (a) {
          a.addEventListener('click', function () { try { localStorage.setItem('piper-locale', a.getAttribute('data-locale')); } catch (e) {} });
        });
        // Menu drawer (same pattern as the voice filters).
        var menuBtn = document.getElementById('menu-open');
        var menuClose = document.getElementById('menu-close');
        var menuDrawer = document.getElementById('menu-drawer');
        var menuScrim = document.getElementById('menu-scrim');
        var setMenu = function (open) {
          if (menuDrawer) menuDrawer.classList.toggle('is-open', open);
          if (menuScrim) menuScrim.classList.toggle('is-open', open);
          if (menuBtn) menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        };
        if (menuBtn) menuBtn.addEventListener('click', function () { setMenu(true); });
        if (menuClose) menuClose.addEventListener('click', function () { setMenu(false); });
        if (menuScrim) menuScrim.addEventListener('click', function () { setMenu(false); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && menuDrawer && menuDrawer.classList.contains('is-open')) setMenu(false);
        });
        // Close flyouts on outside click / Escape.
        document.addEventListener('click', function (e) {
          document.querySelectorAll('details.flyout[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') document.querySelectorAll('details.flyout[open]').forEach(function (d) { d.removeAttribute('open'); });
        });
        if (/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelectorAll('[data-kbd-mod]').forEach(function (k) { k.textContent = '⌘ K'; });
      })();
    </script>
    <script>
      import { initPalette } from '../lib/palette';
      import { getFavorites, onFavoritesChange } from '../lib/favorites';
      initPalette();
      const syncFavCount = () => { const n = getFavorites().length; document.querySelectorAll<HTMLElement>('[data-fav-count]').forEach((el) => { el.textContent = String(n); el.hidden = n === 0; }); };
      onFavoritesChange(syncFavCount);
      syncFavCount();
    </script>
    <script is:inline define:vars={{ swUrl: `${base}sw.js` }}>
      if ('serviceWorker' in navigator) window.addEventListener('load', () => {
        navigator.serviceWorker.register(swUrl).catch(() => {});
      });
    </script>
  </body>
</html>
