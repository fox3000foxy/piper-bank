---
import data from '../data/models.json';

const models = data.filter((m) => m.usable);
const languages = [...new Set(models.map((m) => m.langName))].sort();
const qualities = [...new Set(models.map((m) => m.quality))];
const totalVoices = models.reduce((acc, m) => acc + m.voices, 0);
const base = import.meta.env.BASE_URL;

function slugOf(m, i) {
  return m.slug || ('model-' + i);
}
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Piper TTS Explorer</title>
  </head>
  <body>
    <header class="hero">
      <img src={`${base}logo.png`} alt="PiperBot" class="logo" />
      <div>
        <h1>Piper <span class="accent">TTS Explorer</span></h1>
        <p class="subtitle">{models.length} modèles · {totalVoices.toLocaleString('fr-FR')} voix · 100 % local</p>
      </div>
    </header>

    <section class="filters">
      <input id="search" type="search" placeholder="Rechercher…" autocomplete="off" />
      <div class="chips" id="lang-chips">{languages.map((l) => <button class="chip" data-lang={l}>{l}</button>)}</div>
      <div class="chips" id="quality-chips">{qualities.map((q) => <button class="chip" data-quality={q}>{q}</button>)}</div>
      <label class="multiselect"><input type="checkbox" id="multivoice-only" />Multi-voices</label>
      <select id="sort">
        <option value="name">A → Z</option>
        <option value="voices-desc">Voix ↓</option>
        <option value="voices-asc">Voix ↑</option>
      </select>
      <span id="count" class="count"></span>
    </section>

    <main id="grid" class="grid">
      {models.map((m, i) => (
        <a
          class="card"
          href={`${base}model/${slugOf(m, i)}/`}
          data-name={m.name}
          data-lang={m.langName}
          data-quality={m.quality}
          data-multivoice={m.voices > 1 ? '1' : '0'}
          data-search={`${m.name} ${m.author} ${m.langName} ${m.repo}`.toLowerCase()}
        >
          <h2>{m.name}</h2>
          <div class="meta">
            <span class="badge lang">{m.langName}</span>
            <span class={`spec q-${m.quality}`}>{m.quality}</span>
            {m.voices > 1 && <span class="voices">{m.voices} voix</span>}
          </div>
          <p class="author">{m.author}</p>
        </a>
      ))}
    </main>

    <footer>PiperBot · data: rhasspy/piper-voices + communauté</footer>

    <style is:global>
      :root { --bg:#000; --card:#0a0a0a; --border:#17171a; --text:#e4e4e7; --dim:#71717a;
        --accent:#a855f7; --accent-2:#d8b4fe; --q-high:#4ade80; --q-medium:#facc15; --q-low:#ef4444; }
      * { box-sizing: border-box; }
      body { margin:0; background:var(--bg); color:var(--text); font-family:system-ui,sans-serif;
        padding:2rem 1rem 4rem; max-width:1200px; margin-inline:auto; }
      a { color:var(--accent); text-decoration:none; }
      .hero { display:flex; align-items:center; gap:1rem; margin-bottom:2rem; }
      .logo { width:56px; height:56px; border-radius:10px; }
      h1 { font-size:1.5rem; margin:0; font-weight:600; }
      .accent { color:var(--accent-2); }
      .subtitle { color:var(--dim); margin:.25rem 0 0; font-size:.92rem; }
      .filters { display:flex; flex-wrap:wrap; gap:.7rem; align-items:center; margin-bottom:1.5rem; }
      #search { flex:1 1 320px; padding:.6rem .9rem; border-radius:8px; background:var(--card);
        border:1px solid var(--border); color:var(--text); font-size:.92rem; outline:none; }
      #search:focus { border-color:#3f3f46; }
      .chips { display:flex; gap:.35rem; flex-wrap:wrap; }
      .chip { padding:.3rem .7rem; border-radius:999px; font-size:.78rem; cursor:pointer;
        background:var(--card); border:1px solid var(--border); color:var(--dim); font-family:inherit; }
      .chip.on { background:var(--accent); color:#000; border-color:var(--accent); font-weight:600; }
      .count { color:var(--dim); font-size:.85rem; margin-left:auto; }
      .multiselect { display:flex; gap:.4rem; align-items:center; color:var(--dim); font-size:.84rem; }
      #sort { padding:.35rem .55rem; border-radius:8px; background:var(--card); border:1px solid var(--border);
        color:var(--text); font-size:.8rem; }
      .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:.9rem; }
      .card { background:var(--card); border:1px solid var(--border); border-radius:12px;
        padding:1rem 1.1rem; display:flex; flex-direction:column; gap:.55rem;
        transition:border-color .12s, background .12s; color:var(--text); }
      .card:hover { border-color:#2e2e3a; background:#0d0d0f; }
      .card h2 { margin:0; font-size:1rem; line-height:1.35; font-weight:500; }
      .meta { display:flex; flex-wrap:wrap; gap:.4rem; align-items:center; }
      .badge { font-size:.72rem; padding:.12rem .5rem; border-radius:999px;
        background:#141414; border:1px solid var(--border); color:var(--accent-2); }
      .spec { font-size:.72rem; color:var(--dim); }
      .spec.q-high { color:var(--q-high); } .spec.q-medium { color:var(--q-medium); }
      .spec.q-low { color:var(--q-low); }
      .voices { color:#7dd3fc; font-size:.75rem; }
      .author { margin:0; color:var(--dim); font-size:.8rem; }
      footer { margin-top:3rem; text-align:center; color:#52525b; font-size:.78rem; }
    </style>

    <script>
      const search = document.getElementById('search');
      const langChips = [...document.querySelectorAll('#lang-chips .chip')];
      const qualityChips = [...document.querySelectorAll('#quality-chips .chip')];
      const multivoiceOnly = document.getElementById('multivoice-only');
      const count = document.getElementById('count');
      const grid = document.getElementById('grid');
      const sort = document.getElementById('sort');
      const cards = [...grid.querySelectorAll('.card')];
      const state = { search: '', lang: '', quality: '', multivoice: false };

      function apply() {
        let visible = 0;
        for (const card of cards) {
          const ok = (!state.search || card.dataset.search.includes(state.search))
            && (!state.lang || card.dataset.lang === state.lang)
            && (!state.quality || card.dataset.quality === state.quality)
            && (!state.multivoice || card.dataset.multivoice === '1');
          card.style.display = ok ? '' : 'none';
          if (ok) visible++;
        }
        count.textContent = `${visible} / ${cards.length}`;
      }
      function bindChips(chips, key) {
        chips.forEach((chip) => chip.addEventListener('click', () => {
          const already = chip.classList.contains('on');
          chips.forEach((c) => c.classList.remove('on'));
          chip.classList.toggle('on', !already);
          state[key] = already ? '' : chip.dataset[key];
          apply();
        }));
      }
      bindChips(langChips, 'lang');
      bindChips(qualityChips, 'quality');
      search.addEventListener('input', () => { state.search = search.value.toLowerCase().trim(); apply(); });
      multivoiceOnly.addEventListener('change', () => { state.multivoice = multivoiceOnly.checked; apply(); });
      sort.addEventListener('change', () => {
        const arr = [...grid.children];
        const byName = (a, b) => a.dataset.name.localeCompare(b.dataset.name);
        const voicesOf = (c) => parseInt((c.querySelector('.voices')?.textContent || '0'), 10) || 0;
        arr.sort(sort.value === 'name' ? byName
          : sort.value === 'voices-desc' ? (a, b) => voicesOf(b) - voicesOf(a) || byName(a, b)
          : (a, b) => voicesOf(a) - voicesOf(b) || byName(a, b)).forEach((c) => grid.appendChild(c));
      });
      apply();
    </script>
  </body>
</html>
