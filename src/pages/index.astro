---
import data from '../data/models.json';

const models = data.filter((m) => m.usable);
const languages = [...new Set(models.map((m) => m.langName))].sort();
const qualities = [...new Set(models.map((m) => m.quality))];
const totalVoices = models.reduce((acc, m) => acc + m.voices, 0);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Piper TTS Explorer</title>
  </head>
  <body>
    <header class="hero">
      <img src="/logo.png" alt="PiperBot" class="logo" />
      <div>
        <h1>
          <span class="accent">Piper</span> TTS Explorer
        </h1>
        <p class="subtitle">{models.length} modèles · {totalVoices.toLocaleString('fr-FR')} voix · 100% local, CPU only</p>
      </div>
    </header>

    <section class="filters">
      <input id="search" type="search" placeholder="Rechercher un modèle, une voix, un auteur…" autocomplete="off" />
      <div class="chips" id="lang-chips">{
        languages.map((lang) => <button class="chip lang-chip" data-lang={lang}>{lang}</button>)
      }</div>
      <div class="chips" id="quality-chips">{
        qualities.map((q) => <button class="chip quality-chip" data-quality={q}>{q}</button>)
      }</div>
      <label class="multiselect"> <input type="checkbox" id="multivoice-only" /> Multi-voices </label>
      <select id="sort" class="sort-select">
        <option value="name">A → Z</option>
        <option value="voices-desc">Voix ↓</option>
        <option value="voices-asc">Voix ↑</option>
      </select>
      <span id="count" class="count"></span>
    </section>

    <main id="grid" class="list">
      {models.map((m, i) => (
        <article
          class="row"
          data-lang={m.langName}
          data-quality={m.quality}
          data-multivoice={m.voices > 1 ? '1' : '0'}
          data-search={`${m.name} ${m.author} ${m.langName} ${m.repo}`.toLowerCase()}
        >
          <div class="row-main" data-idx={i}>
            <h2>{m.name}</h2>
            {m.voices > 1 && <span class="voices-count">{m.voices} voix</span>}
          </div>
          <div class="row-side">
            <span class="spec">{m.langName}</span>
            <span class={`spec q-${m.quality}`}>{m.quality}</span>
            <span class="spec author">{m.author}</span>
          </div>
          {m.voices > 1 && (
            <ul class="voice-list" id={`vl-${i}`} hidden>
              {m.voiceNames.slice(0, 24).map((vn) => <li>{vn}</li>)}
              {m.voiceNames.length > 24 && <li class="dim">… + {m.voiceNames.length - 24} autres</li>}
            </ul>
          )}
          <div class="row-links">
            <a href={`https://huggingface.co/${m.repo}`} target="_blank" rel="noopener">HF</a>
            {m.thread && <a href={`https://discord.com/channels/1523276835712929946/${m.thread}`} target="_blank" rel="noopener">thread</a>}
          </div>
        </article>
      ))}
    </main>

    <footer>
      <p>PiperBot · Discord <a href="https://discord.gg" target="_blank">PiperTTS</a> · Data: <a href="https://huggingface.co/rhasspy/piper-voices" target="_blank">rhasspy/piper-voices</a> + community</p>
    </footer>

    <style is:global>
      :root {
        --bg: #000000;
        --card: #0a0a0a;
        --border: #1a1a1a;
        --text: #e4e4e7;
        --dim: #71717a;
        --accent: #a855f7;
        --accent-2: #d8b4fe;
        --q-high: #4ade80;
        --q-medium: #facc15;
        --q-low: #ef4444;
        --q-unknown: #71717a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: system-ui, -apple-system, sans-serif;
        padding: 2rem 1rem 4rem;
        max-width: 1200px; margin-inline: auto;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      .hero { display: flex; align-items: center; gap: 1rem; margin-bottom: 2.5rem; }
      .logo { width: 52px; height: 52px; border-radius: 8px; }
      h1 { margin: 0; font-size: 1.4rem; font-weight: 500; letter-spacing: -0.02em; }
      .accent { color: var(--accent-2); }
      .subtitle { color: var(--dim); margin: 0.2rem 0 0; font-size: 0.9rem; }

      .filters { display: flex; flex-wrap: wrap; gap: 0.9rem; align-items: center; margin-bottom: 1.8rem; }
      #search {
        flex: 1 1 340px; padding: 0.55rem 0.75rem; border-radius: 6px;
        background: var(--card); border: 1px solid var(--border); color: var(--text);
        font-size: 0.9rem; outline: none; transition: border-color .15s;
      }
      #search:focus { border-color: #3f3f46; }
      #search::placeholder { color: #52525b; }
      .chips { display: flex; gap: 0.35rem; flex-wrap: wrap; }
      .chip {
        padding: 0.25rem 0.55rem; font-size: 0.78rem; cursor: pointer;
        background: none; border: none; color: var(--dim);
        border-bottom: 1px solid transparent; font-family: inherit;
      }
      .chip.on { color: var(--accent-2); border-bottom: 1px solid var(--accent-2); }
      .count { color: #52525b; font-size: 0.82rem; margin-left: auto; }
      .multiselect { display: flex; gap: 0.4rem; align-items: center; color: var(--dim); font-size: 0.82rem; }
      .sort-select {
        background: none; border: none; border-bottom: 1px solid var(--border); color: var(--dim);
        font-size: 0.78rem; padding: 0.25rem 0.1rem; cursor: pointer;
      }

      .list { display: flex; flex-direction: column; max-width: 860px; margin-inline: auto; }
      .row {
        display: grid; grid-template-columns: 1fr auto; gap: .2rem .9rem;
        padding: 0.75rem 0.5rem; border-bottom: 1px solid var(--border);
        transition: background .12s;
      }
      .row:hover { background: #060606; }
      .row .voice-list, .row .row-links { grid-column: 1 / -1; }
      .row-main { display: flex; align-items: baseline; gap: 0.7rem; min-width: 0; }
      .row-main h2 { margin: 0; font-size: 0.95rem; font-weight: 450; color: var(--text); cursor: pointer; text-overflow: ellipsis; }
      .voices-count { color: #93c5fd; font-size: 0.75rem; white-space: nowrap; cursor: pointer; }
      .row-side { display: flex; gap: 0.8rem; align-items: baseline; }
      .spec { color: var(--dim); font-size: 0.78rem; white-space: nowrap; }
      .spec.q-high { color: var(--q-high); }
      .spec.q-medium { color: var(--q-medium); }
      .spec.q-low { color: var(--q-low); }
      .spec.author { opacity: .75; }
      .voice-list {
        margin: 0.3rem 0 0; padding: 0.4rem 0 0 0.8rem;
        border-left: 2px solid var(--border); color: var(--dim); font-size: 0.78rem;
        display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; list-style: none;
      }
      .voice-list .dim { opacity: .55; }
      .row-links { display: flex; gap: 1rem; font-size: 0.75rem; }
      .row-links a { color: #52525b; text-transform: lowercase; }
      .row-links a:hover { color: var(--accent-2); text-decoration: none; }
      .sort-select {
        padding: 0.4rem 0.6rem; border-radius: 8px; background: var(--card);
        border: 1px solid var(--border); color: var(--text); font-size: 0.85rem;
      }
      .voice-list {
        margin: 0; padding: 0.5rem 0 0 1rem; color: var(--dim); font-size: 0.8rem;
        display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; column-gap: 0.8rem;
      }
      .voice-list .dim { opacity: 0.6; }
      .btn-voices { cursor: pointer; }

      footer { margin-top: 3rem; color: var(--dim); font-size: 0.8rem; text-align: center; }
    </style>

    <script>
      const search = document.getElementById('search');
      const langChips = [...document.querySelectorAll('.lang-chip')];
      const qualityChips = [...document.querySelectorAll('.quality-chip')];
      const multivoiceOnly = document.getElementById('multivoice-only');
      const count = document.getElementById('count');
      const cards = [...document.querySelectorAll('.row')];

      const state = { search: '', lang: '', quality: '', multivoice: false };

      function activeChips(chips) { return chips.filter((c) => c.classList.contains('on')); }
      function renderChips(chips, key) {
        chips.forEach((chip) => {
          chip.addEventListener('click', () => {
            const value = chip.dataset[key];
            const isActive = chip.classList.contains('on');
            activeChips(chips).forEach((c) => c.classList.remove('on'));
            chip.classList.toggle('on', !isActive);
            state[key] = isActive ? '' : value;
            apply();
          });
        });
      }
      renderChips(langChips, 'lang');
      renderChips(qualityChips, 'quality');

      search.addEventListener('input', () => { state.search = search.value.toLowerCase().trim(); apply(); });
      multivoiceOnly.addEventListener('change', () => { state.multivoice = multivoiceOnly.checked; apply(); });

      const grid = document.getElementById('grid');
      const sort = document.getElementById('sort');
      sort.addEventListener('change', () => {
        const rows = [...grid.children];
        const byName = (a, b) => a.querySelector('h2').textContent.localeCompare(b.querySelector('h2').textContent);
        const byVoices = (a, b) => {
          const va = parseInt((a.querySelector('.voices-count')?.textContent || '0'), 10) || 0;
          const vb = parseInt((b.querySelector('.voices-count')?.textContent || '0'), 10) || 0;
          return sort.value === 'voices-desc' ? vb - va || byName(a, b) : va - vb || byName(a, b);
        };
        rows.sort(sort.value === 'name' ? byName : byVoices).forEach((r) => grid.appendChild(r));
      });

      document.querySelectorAll('.row-main[h2], .voices-count').forEach - 0;

      document.querySelectorAll('.voices-count').forEach((el) => {
        const idx = el.closest('.row')?.querySelector('.row-main')?.dataset.idx;
        el.addEventListener('click', () => { document.getElementById(`vl-${el.closest('.row').querySelector('.row-main').dataset.idx}`).hidden ^= 1; });
      });

      function apply() {
        let visible = 0;
        for (const card of cards) {
          const matchSearch = !state.search || card.dataset.search.includes(state.search);
          const matchLang = !state.lang || card.dataset.lang === state.lang;
          const matchQuality = !state.quality || card.dataset.quality === state.quality;
          const matchMulti = !state.multivoice || card.dataset.multivoice === '1';
          const show = matchSearch && matchLang && matchQuality && matchMulti;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        count.textContent = `${visible} / ${cards.length} modèles`;
      }
      apply();
    </script>
  </body>
</html>
