---
import Layout from '../layouts/Layout.astro';
import data from '../data/models.json';

const models = data.filter((m) => m.usable);
const languages = [...new Set(models.map((m) => m.langName))].sort();
const qualities = [...new Set(models.map((m) => m.quality))];
const totalVoices = models.reduce((acc, m) => acc + m.voices, 0);
const base = import.meta.env.BASE_URL;
---

<Layout title="Voice bank" active="voices" pageUrl="/" subtitle={`${models.length} models · ${totalVoices.toLocaleString("fr-FR")} voices · 100% local`}>


    <section class="filters">
      <input id="search" type="search" placeholder="Search a voice, character, author…" autocomplete="off" />
      <div class="chips" id="lang-chips">{languages.map((l) => <button class="chip" data-lang={l}>{l}</button>)}</div>
      <div class="chips" id="quality-chips">{qualities.map((q) => <button class="chip" data-quality={q}>{q}</button>)}</div>
      <label class="multiselect"><input type="checkbox" id="multivoice-only" />Multi-voice</label>
      <select id="sort">
        <option value="name">A → Z</option>
        <option value="voices-desc">Voix ↓</option>
        <option value="voices-asc">Voix ↑</option>
      </select>
      <span id="count" class="count"></span>
    </section>

    <main id="grid" class="grid">
      {models.map((m) => (
        <a
          class="card"
          href={`${base}model/${m.slug}/`}
          data-name={m.name}
          data-lang={m.langName}
          data-quality={m.quality}
          data-multivoice={m.voices > 1 ? '1' : '0'}
          data-search={`${m.name} ${m.author} ${m.langName} ${m.repo} ${(m.voiceNames || []).join(' ')}`.toLowerCase()}
        >
          <span class="avatar-wrap">
            <span class="avatar" style={`--h:${m.avatar?.hue ?? 260}`}>
              {m.avatar?.icon
                ? <img src={`${base}${m.avatar.icon}`} alt="" loading="lazy" />
                : (m.avatar?.emoji ?? '?')}
            </span>
            {m.avatar?.certified && <img class="cert" src={`${base}icons/certified.svg`} alt="certifié" title="voix officielle rhasspy" loading="lazy" />}
          </span>
          <span class="card-body">
            <h2>{m.name}</h2>
            <span class="meta">
              <span class="badge lang">{m.langName}</span>
              <span class={`spec q-${m.quality}`}>{m.quality}</span>
              {m.voices > 1 && <span class="voices">{m.voices} voix</span>}
            </span>
            <span class="author">{m.author}</span>
          </span>
        </a>
      ))}
    </main>


    <link rel="stylesheet" href={`${base}site.css`} />
    <style is:global>


      .filters { position:sticky; top:0; z-index:10; display:flex; flex-wrap:wrap; gap:.65rem; align-items:center;
        margin-bottom:1.4rem; background:#000000d9; backdrop-filter:blur(10px); padding:.7rem 0; }
      #search { flex:1 1 300px; padding:.62rem .95rem; border-radius:10px; background:var(--card);
        border:1px solid var(--border); color:var(--text); font-size:.92rem; outline:none; transition:border-color .15s, box-shadow .15s; }
      #search:focus { border-color:var(--accent); box-shadow:0 0 0 3px #a855f722; }
      .chips { display:flex; gap:.32rem; flex-wrap:wrap; }
      .chip { padding:.3rem .68rem; border-radius:999px; font-size:.76rem; cursor:pointer;
        background:var(--card); border:1px solid var(--border); color:var(--dim); font-family:inherit; transition:all .12s; }
      .chip:hover { color:var(--text); border-color:#33333d; }
      .chip.on { background:var(--accent); color:#000; border-color:var(--accent); font-weight:600; }
      .count { color:var(--dim); font-size:.82rem; margin-left:auto; font-variant-numeric:tabular-nums; }
      .multiselect { display:flex; gap:.4rem; align-items:center; color:var(--dim); font-size:.82rem; cursor:pointer; }
      #sort { padding:.38rem .55rem; border-radius:8px; background:var(--card); border:1px solid var(--border);
        color:var(--text); font-size:.78rem; cursor:pointer; }

      .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(310px,1fr)); gap:.85rem; }
      .card { display:flex; gap:.85rem; align-items:flex-start; background:linear-gradient(180deg,#0d0d11,#0a0a0d);
        border:1px solid var(--border); border-radius:14px; padding:.95rem 1rem; color:var(--text);
        transition:transform .14s, border-color .14s, box-shadow .14s; }
      .card:hover { transform:translateY(-2px); border-color:#a855f744; box-shadow:0 8px 28px #00000088, 0 0 0 1px #a855f722; }
      .avatar { flex:0 0 auto; width:52px; height:52px; border-radius:13px; display:grid; place-items:center;
        font-size:1.5rem; font-weight:700;
        background:linear-gradient(135deg, hsl(var(--h) 65% 26%), hsl(calc(var(--h) + 40) 70% 12%));
        border:1px solid hsl(var(--h) 60% 32% / .55); text-shadow:0 2px 8px #0009; }
      .card-body { display:flex; flex-direction:column; gap:.4rem; min-width:0; }
      .avatar img { width:62%; height:62%; object-fit:contain; }
      .avatar-wrap { position:relative; flex:0 0 auto; display:grid; }
      .cert { position:absolute; right:-4px; bottom:-4px; width:20px; height:20px;
        filter:drop-shadow(0 1px 3px #000); }
      .card-body h2 { margin:0; font-size:.98rem; line-height:1.32; font-weight:550; }
      .meta { display:flex; flex-wrap:wrap; gap:.4rem; align-items:center; }
      .badge { font-size:.7rem; padding:.12rem .5rem; border-radius:999px;
        background:#ffffff0d; border:1px solid var(--border); color:var(--accent-2); }
      .spec { font-size:.7rem; color:var(--dim); text-transform:capitalize; }
      .spec.q-high { color:var(--q-high); } .spec.q-medium { color:var(--q-medium); }
      .spec.q-low { color:var(--q-low); }
      .voices { color:#7dd3fc; font-size:.73rem; font-weight:600; }
      .author { color:var(--dim); font-size:.78rem; }

    </style>

    <script>
      const search = document.getElementById('search');
      const langChips = [...document.querySelectorAll('#lang-chips .chip')];
      const qualityChips = [...document.querySelectorAll('#quality-chips .chip')];
      const multivoiceOnly = document.getElementById('multivoice-only');
      const count = document.getElementById('count');
      const grid = document.getElementById('grid');
      const sort = document.getElementById('sort');
      const cards = [...grid.querySelectorAll('.card')];
      const state = { search: '', lang: '', quality: '', multivoice: false };
      function apply() {
        let visible = 0;
        for (const card of cards) {
          const ok = (!state.search || card.dataset.search.includes(state.search))
            && (!state.lang || card.dataset.lang === state.lang)
            && (!state.quality || card.dataset.quality === state.quality)
            && (!state.multivoice || card.dataset.multivoice === '1');
          card.style.display = ok ? '' : 'none';
          if (ok) visible++;
        }
        count.textContent = `${visible} / ${cards.length}`;
      }
      function bindChips(chips, key) {
        chips.forEach((chip) => chip.addEventListener('click', () => {
          const already = chip.classList.contains('on');
          chips.forEach((c) => c.classList.remove('on'));
          chip.classList.toggle('on', !already);
          state[key] = already ? '' : chip.dataset[key];
          apply();
        }));
      }
      bindChips(langChips, 'lang');
      bindChips(qualityChips, 'quality');
      search.addEventListener('input', () => { state.search = search.value.toLowerCase().trim(); apply(); });
      multivoiceOnly.addEventListener('change', () => { state.multivoice = multivoiceOnly.checked; apply(); });
      sort.addEventListener('change', () => {
        const arr = [...grid.children];
        const byName = (a, b) => a.dataset.name.localeCompare(b.dataset.name);
        const voicesOf = (c) => parseInt((c.querySelector('.voices')?.textContent || '0'), 10) || 0;
        arr.sort(sort.value === 'name' ? byName
          : sort.value === 'voices-desc' ? (a, b) => voicesOf(b) - voicesOf(a) || byName(a, b)
          : (a, b) => voicesOf(a) - voicesOf(b) || byName(a, b)).forEach((c) => grid.appendChild(c));
      });
      apply();
    </script>
</Layout>
