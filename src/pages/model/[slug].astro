---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/models.json';

export async function getStaticPaths() {
  const models = data.filter((m) => m.usable);
  return models.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}

const { model: m } = Astro.props;
const base = import.meta.env.BASE_URL;
const avatar = m.avatar || { emoji: '?', hue: 260 };
const voicePairs = (m.voiceNames || []).map((vn, i) => ({
  name: vn, sid: (m.voiceIds || [])[i] ?? i,
}));
---

<Layout title={m.name} active="voices" narrow subtitle={`par ${m.author}`}>

    <a class="back" href={`${base}`}>← all models</a>
    <div class="hero model-hero">
      <span class="avatar big" style={`--h:${avatar.hue}`}>{avatar.emoji}</span>
      <div>
        <h1>{m.name}</h1>
        <p class="subtitle">par {m.author} · {m.repo}</p>
      </div>
    </div>

    <section class="tags">
      <span class="tag lang">{m.langName}</span>
      <span class={`tag q-${m.quality}`}>{m.quality}</span>
      {m.voices > 1
        ? <span class="tag voices">{m.voices} voix</span>
        : <span class="tag">single voice</span>}
      <span class="tag type">{m.phonemeType === 'text' ? 'phonemes: text' : `phonemes: ${((m.configs || {}).espeak || {}).voice || 'espeak'}`}</span>
      <span class="tag">{m.sampleRate} Hz</span>
    </section>

    <section class="sec">
      <h2>Downloads</h2>
      <div class="dl-row">
        <a class="btn-dl" href={`https://huggingface.co/${m.repo}/resolve/main/${m.onnx}`}>⬇ model.onnx</a>
        <a class="btn-dl" href={`https://huggingface.co/${m.repo}/resolve/main/${m.json}`}>⬇ model.onnx.json</a>
        <a class="btn-dl ghost" href={`https://huggingface.co/${m.repo}`}>repo HF</a>
        {m.thread && <a class="btn-dl ghost" href={`https://discord.com/channels/1523276835712929946/${m.thread}`}>thread</a>}
      </div>
    </section>

    <section class="sec">
      <h2>Voices & samples ({m.voices})</h2>
      <p class="dim">click ▶ to listen · click the name to use it for synthesis</p>
      <div id="voice-list">
        {voicePairs.slice(0, 120).map((v, i) => (
          <div class="player" style={`--vc:${(avatar.hue + i * 47) % 360}`} data-sid={v.sid} data-vname={v.name}>
            <button class="pp" aria-label={`listen ${v.name}`}>▶</button>
            <div class="pbody">
              <div class="prow">
                <button class="pname" title={v.name}>{v.name}</button>
                <span class="ptime">0:00</span>
              </div>
              <div class="pbar"><div class="pfill"></div></div>
              <div class="psamples">
                <audio preload="none" data-n="0"></audio>
                <audio preload="none" data-n="1"></audio>
              </div>
            </div>
          </div>
        ))}
        {voicePairs.length > 120 && <p class="dim">… +{voicePairs.length - 120} voices (synthesis available for all)</p>}
      </div>
    </section>

    <section class="sec">
      <h2>Synthesize</h2>
      <p class="dim" id="sel-voice-line">voice: <b id="sel-voice">default</b></p>
      <textarea id="text" rows="2" placeholder="Text to synthesize…"></textarea>
      <div class="opts">
        <label>speed <input id="len" type="number" step="0.05" min="0.2" max="3" placeholder="1.0" /></label>
        <label>noise <input id="noise" type="number" step="0.05" min="0" max="1.5" placeholder="0.667" /></label>
        <button id="go">Generate</button>
      </div>
      <audio id="player" controls hidden></audio>
      <p id="status" class="dim"></p>
    </section>

    <section class="sec">
      <h2>Linked dataset</h2>
      <div id="dataset-link"><p class="dim">recherche…</p></div>
    </section>

    <link rel="stylesheet" href={`${base}site.css`} />
    <style is:global>
      .avatar.big { width:76px; height:76px; font-size:2.4rem; border-radius:20px; display:grid; place-items:center; flex:0 0 auto;
        background:linear-gradient(135deg, hsl(var(--h) 65% 26%), hsl(calc(var(--h) + 40) 70% 12%));
        border:1px solid hsl(var(--h) 60% 32% / .55); text-shadow:0 2px 8px #0009; }

      .dl-row { display:flex; flex-wrap:wrap; gap:.5rem; }
      .btn-dl { display:inline-flex; align-items:center; gap:.4rem; font-size:.84rem; font-weight:550;
        padding:.5rem .95rem; border-radius:10px; color:var(--text);
        background:linear-gradient(180deg,#a855f722,#a855f711); border:1px solid #a855f755; transition:all .12s; }
      .btn-dl:hover { border-color:var(--accent); box-shadow:0 0 18px #a855f733; }
      .btn-dl.ghost { background:none; border-color:var(--border); color:var(--dim); font-weight:400; }
      .btn-dl.ghost:hover { color:var(--text); border-color:#3f3f46; box-shadow:none; }

      .player { display:flex; gap:.7rem; align-items:center; padding:.6rem .7rem; margin-bottom:.5rem;
        border-radius:12px; background:#0a0a0d;
        border:1px solid hsl(var(--vc) 55% 30% / .5); transition:border-color .15s, box-shadow .15s; }
      .player:hover { border-color:hsl(var(--vc) 70% 45% / .8); }
      .player.playing { border-color:hsl(var(--vc) 80% 55%); box-shadow:0 0 16px hsl(var(--vc) 80% 50% / .25); }
      .pp { flex:0 0 auto; width:38px; height:38px; border-radius:50%; cursor:pointer; font-size:.85rem;
        background:transparent; color:hsl(var(--vc) 85% 70%);
        border:1.5px solid hsl(var(--vc) 70% 55%); transition:all .12s; font-family:inherit; }
      .pp:hover { background:hsl(var(--vc) 70% 50% / .2); }
      .player.playing .pp { background:hsl(var(--vc) 70% 50%); color:#000; border-color:transparent; }
      .pbody { flex:1; min-width:0; display:flex; flex-direction:column; gap:.3rem; }
      .prow { display:flex; align-items:baseline; gap:.6rem; }
      .pname { background:none; border:none; padding:0; cursor:pointer; font-family:inherit;
        color:var(--text); font-size:.86rem; font-weight:550; white-space:nowrap; overflow:hidden;
        text-overflow:ellipsis; text-align:left; }
      .pname:hover { color:hsl(var(--vc) 85% 72%); }
      .pname.sel { color:hsl(var(--vc) 85% 72%); text-decoration:underline; text-underline-offset:3px; }
      .ptime { margin-left:auto; color:var(--dim); font-size:.72rem; font-variant-numeric:tabular-nums; white-space:nowrap; }
      .pbar { height:4px; border-radius:99px; background:#ffffff12; cursor:pointer; }
      .pfill { height:100%; width:0%; border-radius:99px; background:hsl(var(--vc) 75% 58%); transition:width .1s linear; }
      .sample { margin-bottom:.7rem; }
      .sample audio { width:100%; margin-top:.25rem; }
      .sample p { margin:0 0 .2rem; font-size:.82rem; color:var(--dim); }

      #text { width:100%; background:#0a0a0a; border:1px solid var(--border); border-radius:9px;
        color:var(--text); padding:.6rem .75rem; font-family:inherit; font-size:.92rem; resize:vertical; min-height:64px; }
      #text:focus { border-color:#3f3f46; outline:none; }
      .opts { display:flex; flex-wrap:wrap; gap:.6rem; align-items:center; margin-top:.6rem; }
      .opts label { color:var(--dim); font-size:.78rem; display:flex; gap:.3rem; align-items:center; }
      .opts input { width:64px; background:#0a0a0a; border:1px solid var(--border); border-radius:6px;
        color:var(--text); padding:.22rem .35rem; font-size:.8rem; }
      #go { margin-left:auto; background:var(--accent); color:#000; border:none; border-radius:8px;
        padding:.45rem 1rem; cursor:pointer; font-weight:600; font-size:.88rem; font-family:inherit; }
      #go:disabled { opacity:.5; cursor:wait; }
      #player { width:100%; margin-top:.7rem; }
      #status { font-size:.78rem; margin-top:.4rem; min-height:1.2em; }
      .files { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:.3rem; }
      .files a { font-size:.88rem; }
    </style>

    <script type="application/json" id="model-data" set:html={JSON.stringify(m)} />
    <script define:vars={{ siteBase: base, modelName: m.name, modelRepo: m.repo }}>
      // linked dataset (same class / same source repo)
      (async () => {
        const box = document.getElementById('dataset-link');
        try {
          const ds = await (await fetch(`${siteBase}data/datasets.json`)).json();
          const hay = (modelName + ' ' + modelRepo).toLowerCase();
          const hit = ds.find((d) => {
            const cls = (d.class || '').toLowerCase();
            if (cls.length > 2 && hay.includes(cls)) return true;
            const dr = (d.repo || '').toLowerCase();
            if (dr && modelRepo.toLowerCase().split('/')[0] === dr.split('/')[0]) {
              const a = dr.replace(/[-_]ljspeech.*$/, ''), b = modelRepo.toLowerCase();
              const aa = a.split('/')[1] || '', bb = b.split('/')[1] || '';
              if (aa && bb && (aa.includes(bb.split('-')[0]) || bb.includes(aa.split('-')[0]))) return true;
            }
            return false;
          });
          if (hit) {
            box.innerHTML = `<a href="${siteBase}datasets/">${hit.name}</a> <span class="dim">· ${hit.source || ''} · ${hit.repo || ''}</span>`;
          } else {
            box.innerHTML = '<p class="dim">no linked dataset</p>';
          }
        } catch { box.innerHTML = '<p class="dim">no linked dataset</p>'; }
      })();
    </script>
    <script define:vars={{ siteBase: base }}>window.__BASE__ = siteBase;</script>
    <script type="module">
      const model = JSON.parse(document.getElementById('model-data').textContent);
      const siteBase = window.__BASE__;
      const HF_SAMPLES = 'https://huggingface.co/datasets/fox3000foxy/piper-samples/resolve/main/';
      const safe = (s) => s.replace(/[^a-zA-Z0-9\-_.]/g, '_');
      const sampleBase = safe(model.repo.replace('/', '--') + '__' + model.onnx.replace('/', '_').replace(/\.onnx$/, ''));
      const sampleUrl = (sid, n) => `${HF_SAMPLES}${sampleBase}__sp${sid}__${n}.wav`;

      // custom players: 2 samples per voice, rotating colors
      let currentAudio = null, currentCard = null;
      const fmt = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
      document.querySelectorAll('.player').forEach((card) => {
        const sid = parseInt(card.dataset.sid, 10);
        const btn = card.querySelector('.pp');
        const fill = card.querySelector('.pfill');
        const time = card.querySelector('.ptime');
        const audios = [...card.querySelectorAll('audio')];
        audios.forEach((a, n) => { a.src = sampleUrl(sid, n); });
        let idx = 0;
        const audio = audios[0];
        const paint = () => {
          const d = audio.duration || 0, c = audio.currentTime || 0;
          fill.style.width = (d ? (c / d) * 100 : 0) + '%';
          time.textContent = fmt(c) + (d ? ' / ' + fmt(d) : '');
        };
        audio.addEventListener('timeupdate', paint);
        audio.addEventListener('loadedmetadata', paint);
        audio.addEventListener('ended', () => {
          if (idx < audios.length - 1 && audios[idx + 1].src) {
            idx++;
            // pre-check existence before playing
            fetch(audios[idx].src, { method: 'HEAD' }).then((r) => {
              if (r.ok) { audios[idx].play().catch(() => stop()); }
              else stop();
            }).catch(() => stop());
          } else stop();
        });
        audio.addEventListener('error', () => {
          if (idx === 0) {
            // no sample for this voice (generation running) -> hide player
            card.style.display = 'none';
          } else stop();
        }, true);
        const stop = () => {
          audio.pause(); idx = 0;
          card.classList.remove('playing'); btn.textContent = '▶';
        };
        btn.addEventListener('click', () => {
          if (currentAudio && currentAudio !== audio) {
            currentAudio.pause();
            if (currentCard) {
              currentCard.classList.remove('playing');
              currentCard.querySelector('.pp').textContent = '▶';
            }
          }
          if (audio.paused) {
            currentAudio = audio; currentCard = card;
            audio.play().then(() => { card.classList.add('playing'); btn.textContent = '⏸'; })
              .catch(() => { card.style.display = 'none'; });
          } else {
            stop(); currentAudio = null; currentCard = null;
          }
        });
        card.querySelector('.pbar').addEventListener('click', (e) => {
          const r = e.currentTarget.getBoundingClientRect();
          if (audio.duration) audio.currentTime = ((e.clientX - r.left) / r.width) * audio.duration;
        });
        // voice selection for synthesis
        card.querySelector('.pname').addEventListener('click', () => {
          document.querySelectorAll('.pname').forEach((x) => x.classList.remove('sel'));
          card.querySelector('.pname').classList.add('sel');
          window.__selSid = sid;
          document.getElementById('sel-voice').textContent = card.dataset.vname;
        });
      });

      const { synthesize } = await new Function('u', 'return import(u)')(window.__BASE__ + 'piper-infer.js');
      const go = document.getElementById('go');
      go.addEventListener('click', async () => {
        const text = document.getElementById('text').value.trim();
        const status = document.getElementById('status');
        if (!text) { status.textContent = 'Enter some text.'; return; }
        go.disabled = true;
        try {
          const blob = await synthesize({
            repo: model.repo, onnx: model.onnx, configs: model.configs,
            phonemeType: model.phonemeType, phonemeIdMap: model.phonemeIdMap,
            sampleRate: model.sampleRate, text,
            speakerId: window.__selSid ?? null,
            lengthScale: parseFloat(document.getElementById('len').value) || undefined,
            noiseScale: parseFloat(document.getElementById('noise').value) || undefined,
          }, (s) => { status.textContent = '⏳ ' + s; });
          const player = document.getElementById('player');
          player.src = URL.createObjectURL(blob); player.hidden = false; player.play();
          status.textContent = '✅ local synthesis (browser)';
        } catch (e) { status.textContent = '❌ ' + (e.message || e); }
        finally { go.disabled = false; }
      });
    </script>
</Layout>
