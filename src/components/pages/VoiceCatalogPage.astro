---
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import ModelAvatar from '../ModelAvatar.astro';
import Flag from '../Flag.astro';
import data from '../../data/models.json';
import { formatNumber, languageLabel, localizedPath, localeMeta, t, tp, type Locale, type MessageKey } from '../../i18n/ui';
import { fold } from '../../lib/search';
import { sampleUrl, voiceTraits } from '../../lib/voices';

// presetLang: renders a language landing page (/voices/language/<code>/) with only that language.
const { locale = 'fr' as Locale, presetLang = '' } = Astro.props as { locale?: Locale; presetLang?: string };
const base = import.meta.env.BASE_URL;
const L = (p: string) => localizedPath(base, locale, p);

const allModels = data.filter((m) => m.usable || m.piperPlus);
const models = allModels
  .filter((m) => !presetLang || m.lang === presetLang)
  .sort((a, b) => (b.updated || '').localeCompare(a.updated || '') || a.name.localeCompare(b.name));
const totalVoices = models.reduce((acc, m) => acc + m.voices, 0);
const freshCutoff = Date.now() - 14 * 864e5;

// ---- Derived attributes, one place -------------------------------------------------
const OPEN = /^(MIT|Apache|CC BY 4|CC0|GPL|BSD|MPL)/i;
const NC = /^CC BY-NC/i;
const licenseGroup = (l: string) => (!l ? 'none' : OPEN.test(l) ? 'open' : NC.test(l) ? 'nc' : 'restricted');
const COLLECTIONS: Record<string, string> = {
  valorant: 'Valorant', portal: 'Portal', hal: 'HAL 9000', fortune: 'Fortune', 'counter-strike': 'Counter-Strike',
  dota: 'Dota 2', kurmanci: 'Kurmancî', starwars: 'Star Wars', fuze: 'Fuze', tf2: 'Team Fortress 2',
};
const langLabel = (m: (typeof models)[number]) => languageLabel(m.lang, m.langName, locale);
const qKey = (q: string) => (q === 'high' ? 'quality.high' : q === 'medium' ? 'quality.medium' : q === 'low' ? 'quality.low' : 'quality.unknown') as MessageKey;
const shortName = (n: string) => n.replace(/\s+(?:x[_\s]?)?(?:high|medium|low|unknown)$/i, '');

const rows = models.map((m) => ({
  m,
  lang: m.lang,
  quality: m.quality,
  speakers: m.voices > 1 ? 'multi' : 'single',
  source: m.avatar?.certified ? 'official' : 'community',
  license: licenseGroup(m.license || ''),
  collection: m.avatar?.universe && m.avatar.universe !== 'default' ? m.avatar.universe : '',
  engine: m.piperPlus ? 'plus' : 'piper',
  phonemes: m.phonemeType || 'espeak',
  rate: String(m.sampleRate),
  author: m.author,
  dataset: m.dataset ? '1' : '',
  recent: m.updated && new Date(m.updated + 'T00:00:00Z').getTime() >= freshCutoff ? '1' : '',
  traits: voiceTraits(m as any).join(' '),
}));

type Opt = { v: string; label: string; n: number };
// Space-separated values = multi-valued facet (traits).
const count = (key: keyof (typeof rows)[number], order?: string[]): [string, number][] => {
  const c = new Map<string, number>();
  for (const r of rows) for (const v of String(r[key] || '').split(' ').filter(Boolean)) c.set(v, (c.get(v) || 0) + 1);
  const entries = [...c.entries()];
  return order ? order.filter((o) => c.has(o)).map((o) => [o, c.get(o)!]) : entries.sort((a, b) => b[1] - a[1]);
};
const opts = (pairs: [string, number][], label: (v: string) => string): Opt[] => pairs.map(([v, n]) => ({ v, n, label: label(v) }));

const allFacets: { id: string; title: string; search?: boolean; open?: boolean; options: Opt[] }[] = [
  { id: 'lang', title: t(locale, 'filter.language'), search: true, open: true, options: opts(count('lang'), (v) => langLabel(models.find((m) => m.lang === v)!)).sort((a, b) => b.n - a.n || a.label.localeCompare(b.label)) },
  { id: 'traits', title: t(locale, 'filter.traits'), open: true, options: opts(count('traits', ['expressive', 'character', 'female', 'male']), (v) => t(locale, `trait.${v}` as MessageKey)) },
  { id: 'quality', title: t(locale, 'filter.quality'), open: true, options: opts(count('quality', ['high', 'medium', 'low', 'unknown']), (v) => t(locale, qKey(v))) },
  { id: 'speakers', title: t(locale, 'filter.speakers'), open: true, options: opts(count('speakers', ['single', 'multi']), (v) => (v === 'multi' ? t(locale, 'filter.multiVoice') : t(locale, 'common.oneSpeaker'))) },
  { id: 'source', title: t(locale, 'filter.source'), open: true, options: opts(count('source', ['official', 'community']), (v) => t(locale, v === 'official' ? 'filter.official' : 'filter.community')) },
  { id: 'license', title: t(locale, 'filter.license'), open: true, options: opts(count('license', ['open', 'nc', 'restricted', 'none']), (v) => t(locale, `license.${v}` as MessageKey)) },
  { id: 'collection', title: t(locale, 'filter.collection'), options: opts(count('collection'), (v) => COLLECTIONS[v] || v) },
  { id: 'engine', title: t(locale, 'filter.engine'), options: opts(count('engine', ['piper', 'plus']), (v) => (v === 'plus' ? 'Piper Plus' : 'Piper')) },
  { id: 'phonemes', title: t(locale, 'detail.phonemes'), options: opts(count('phonemes'), (v) => (v === 'text' ? t(locale, 'detail.textPhoneme') : v === 'espeak' ? 'eSpeak NG' : v.charAt(0).toUpperCase() + v.slice(1))) },
  { id: 'rate', title: t(locale, 'detail.sampleRate'), options: opts(count('rate').sort((a, b) => Number(b[0]) - Number(a[0])), (v) => `${formatNumber(locale, Number(v))} Hz`) },
  { id: 'author', title: t(locale, 'detail.author'), search: true, options: opts(count('author'), (v) => v) },
];
// A language page has a single language: drop that facet, and any facet left with one option.
const facets = allFacets.filter((f) => !(presetLang && f.id === 'lang') && f.options.length > 0 && !(presetLang && f.options.length < 2 && f.id !== 'traits'));
const langs = new Set(models.map((m) => m.lang)).size;
const presetLabel = presetLang ? languageLabel(presetLang, models[0]?.langName || presetLang, locale) : '';
// Lower-case form for languages that write language names in lower case mid-sentence (fr, es, it, pt…).
const presetLower = ['en', 'de'].includes(locale) ? presetLabel : presetLabel.toLocaleLowerCase(localeMeta(locale).tag);
const pageUrl = presetLang ? `/voices/language/${presetLang}/` : '/voices/';
const metaDescription = presetLang
  ? t(locale, 'langPage.metaDescription', { language: presetLabel, languageLower: presetLower, models: formatNumber(locale, models.length), voices: formatNumber(locale, totalVoices) })
  : t(locale, 'voices.metaDescription', {
      models: formatNumber(locale, models.length),
      langs: formatNumber(locale, langs),
      voices: formatNumber(locale, totalVoices),
    });
const pageTitle = presetLang ? t(locale, 'langPage.title', { language: presetLabel, languageLower: presetLower }) : t(locale, 'voices.title');
const crumbs = [{ name: t(locale, 'nav.home'), path: '/' }, { name: t(locale, 'nav.voices'), path: '/voices/' }, ...(presetLang ? [{ name: presetLabel, path: pageUrl }] : [])];
// Other languages, for the language page footer links (internal linking for SEO).
const otherLangs = presetLang
  ? [...new Map(allModels.filter((m) => m.lang !== presetLang).map((m) => [m.lang, m])).values()]
      .map((m) => ({ code: m.lang, label: languageLabel(m.lang, m.langName, locale), n: allModels.filter((x) => x.lang === m.lang).length }))
      .sort((a, b) => b.n - a.n)
  : [];
const ui = {
  tag: localeMeta(locale).tag,
  results: t(locale, 'voices.resultsCount'),
  facetTitles: Object.fromEntries(facets.map((f) => [f.id, f.title])),
  dataset: t(locale, 'filter.withDataset'),
  recent: t(locale, 'filter.recent'),
  remove: t(locale, 'filter.remove'),
  showAll: t(locale, 'filter.showAll'),
  showLess: t(locale, 'filter.showLess'),
};
---
<Layout title={pageTitle} active="voices" locale={locale} pageUrl={pageUrl} breadcrumbs={crumbs} description={metaDescription}>
  <header class="page-head">
    <div class="page-head-grid">
      <div>
        {presetLang
          ? <p class="label"><a class="crumb-link" href={L('/voices/')}>{t(locale, 'nav.voices')}</a> / {presetLabel}</p>
          : <p class="label">{t(locale, 'voices.eyebrow')}</p>}
        <h1 class={presetLang ? 'h1-lang' : ''}>{presetLang && <Flag lang={presetLang} class="flag-xl" />}{presetLang ? t(locale, 'langPage.heading', { language: presetLabel }) : t(locale, 'voices.heading')}</h1>
      </div>
      <div>
        <p class="lead">{presetLang ? t(locale, 'langPage.intro', { language: presetLabel, languageLower: presetLower }) : t(locale, 'voices.intro')}</p>
        <div class="page-stats">
          <div><strong>{formatNumber(locale, models.length)}</strong><span>{t(locale, 'voices.models')}</span></div>
          <div><strong>{formatNumber(locale, totalVoices)}</strong><span>{t(locale, 'voices.speakers')}</span></div>
          {!presetLang && <div><strong>{formatNumber(locale, langs)}</strong><span>{t(locale, 'search.languages')}</span></div>}
        </div>
      </div>
    </div>
  </header>

  <main class="catalog" data-local-search>
    <div class="facets-scrim" id="scrim"></div>
    <aside class="facets" id="facets" aria-label={t(locale, 'voices.filters')}>
      <div class="facets-head"><span>{t(locale, 'filter.filters')}</span><button class="icon-btn" type="button" id="facets-close" aria-label={t(locale, 'search.hintClose')}><Icon name="close" size={18} /></button></div>
      <div class="facet">
        <div class="facet-body" style="padding-top:0">
          <label class="switch"><span>{t(locale, 'filter.withDataset')}</span><input type="checkbox" data-toggle="dataset" /></label>
          <label class="switch"><span>{t(locale, 'filter.recent')}</span><input type="checkbox" data-toggle="recent" /></label>
        </div>
      </div>
      {facets.map((f) => (
        <details class="facet" open={f.open} data-facet={f.id}>
          <summary>{f.title}<Icon name="chevronDown" size={16} /></summary>
          <div class="facet-body">
            {f.search && <label class="textbox facet-search"><Icon name="search" size={14} /><input type="text" data-facet-filter={f.id} placeholder={t(locale, 'filter.find')} aria-label={`${t(locale, 'filter.find')} · ${f.title}`} /></label>}
            <div class={`facet-list${f.options.length > 8 ? ' is-collapsed' : ''}`}>
              {f.options.map((o) => <label class="check" data-label={fold(o.label + ' ' + o.v)}><input type="checkbox" name={f.id} value={o.v} />{f.id === 'lang' && <Flag lang={o.v} />}<span class="check-label">{o.label}</span><span class="count" data-count>{formatNumber(locale, o.n)}</span></label>)}
            </div>
            <p class="facet-empty" hidden>{t(locale, 'voices.empty')}</p>
            {f.options.length > 8 && <button type="button" class="facet-more" data-more>{t(locale, 'filter.showAll')} ({formatNumber(locale, f.options.length)})</button>}
          </div>
        </details>
      ))}
    </aside>

    <div class="catalog-main">
      <div class="catalog-toolbar">
        <button class="btn filters-btn" type="button" id="facets-open"><Icon name="filter" size={16} />{t(locale, 'filter.filters')}<span class="n" id="filters-n" hidden>0</span></button>
        <label class="textbox">
          <Icon name="search" size={18} />
          <input id="search" type="search" placeholder={t(locale, 'voices.searchPlaceholder')} autocomplete="off" spellcheck="false" aria-label={t(locale, 'voices.searchLabel')} />
          <button type="button" class="clear-q" id="clear-q" aria-label={t(locale, 'filter.clearSearch')} hidden><Icon name="close" size={14} /></button>
          <kbd class="kbd" id="slash-hint">/</kbd>
        </label>
        <div class="toolbar-group">
          <label class="sort-field"><span>{t(locale, 'filter.sort')}</span>
            <select id="sort">
              <option value="relevance">{t(locale, 'sort.relevance')}</option>
              <option value="updated-desc">{t(locale, 'sort.updatedDesc')}</option>
              <option value="name">{t(locale, 'sort.name')}</option>
              <option value="voices-desc">{t(locale, 'sort.voicesDesc')}</option>
              <option value="voices-asc">{t(locale, 'sort.voicesAsc')}</option>
              <option value="updated-asc">{t(locale, 'sort.updatedAsc')}</option>
            </select>
          </label>
          <div class="segmented" role="group" aria-label={t(locale, 'filter.view')}>
            <button type="button" data-view="list" aria-pressed="true" aria-label={t(locale, 'filter.viewList')} title={t(locale, 'filter.viewList')}><Icon name="list" size={16} /></button>
            <button type="button" data-view="grid" aria-pressed="false" aria-label={t(locale, 'filter.viewGrid')} title={t(locale, 'filter.viewGrid')}><Icon name="grid" size={16} /></button>
          </div>
        </div>
      </div>

      <div class="results-head">
        <p class="results-count" id="count" aria-live="polite">{t(locale, 'voices.resultsCount', { visible: formatNumber(locale, models.length), total: formatNumber(locale, models.length) })}</p>
        <div class="active-chips" id="chips"></div>
      </div>

      <div id="grid" class="vlist" data-view="list">
        {rows.map((r) => {
          const m = r.m;
          const sid = (m.voiceIds || [])[0] ?? 0;
          return <div class="vrow" data-play-row data-href={L(`/model/${m.slug}/`)}
            data-lang={r.lang} data-quality={r.quality} data-speakers={r.speakers} data-source={r.source} data-license={r.license}
            data-collection={r.collection} data-engine={r.engine} data-phonemes={r.phonemes} data-rate={r.rate} data-author={r.author}
            data-dataset={r.dataset} data-recent={r.recent} data-traits={r.traits}
            data-name={m.name} data-voices={m.voices} data-updated={m.updated || ''}
            data-title={fold(m.name)}
            data-search={fold(`${m.name} ${m.author} ${m.langName} ${langLabel(m)} ${m.lang} ${m.repo} ${m.license || ''} ${r.collection} ${r.traits.split(' ').filter(Boolean).map((x) => t(locale, `trait.${x}` as MessageKey)).join(' ')} ${(m.voiceNames || []).filter((v: string) => !/^voice-\d+$/.test(v)).join(' ')}`)}>
            <span class="vrow-lead">
              <ModelAvatar model={m} locale={locale} />
              <button type="button" class="vrow-play" data-play={sampleUrl(m.repo, m.onnx, sid, 0)} data-play-label={t(locale, 'voices.playSample', { name: shortName(m.name) })} data-pause-label={t(locale, 'voices.pauseSample', { name: shortName(m.name) })} aria-label={t(locale, 'voices.playSample', { name: shortName(m.name) })} aria-pressed="false">
                <svg class="i-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M6.5 4.6v10.8a.6.6 0 0 0 .9.5l8.6-5.4a.6.6 0 0 0 0-1L7.4 4.1a.6.6 0 0 0-.9.5Z"/></svg>
                <svg class="i-pause" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10M13 5v10"/></svg>
              </button>
            </span>
            <span class="vrow-title"><strong><a class="vrow-link" href={L(`/model/${m.slug}/`)}><span data-hl>{shortName(m.name)}</span></a>{r.recent && <span class="new-pill">{t(locale, 'common.new')}</span>}{m.piperPlus && <span class="plus-pill">Piper+</span>}</strong><small>{m.author} · {m.repo}</small></span>
            <span class="vrow-tags">
              <span class="vrow-lang"><Flag lang={m.lang} />{langLabel(m)}</span>
              <span class="vrow-q"><span class={`badge badge-q-${m.quality}`}>{t(locale, qKey(m.quality))}</span></span>
              <span class="vrow-speakers">{m.voices > 1 ? tp(locale, 'voices.speakerCount', m.voices, { count: formatNumber(locale, m.voices) }) : t(locale, 'common.oneSpeaker')}</span>
            </span>
            <button type="button" class="vrow-fav" data-fav={m.slug} aria-pressed="false" aria-label={t(locale, 'fav.toggle', { name: shortName(m.name) })} title={t(locale, 'fav.add')}>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16.5s-6.25-3.6-6.25-8.1A3.4 3.4 0 0 1 10 6.3a3.4 3.4 0 0 1 6.25 2.1c0 4.5-6.25 8.1-6.25 8.1Z"/></svg>
            </button>
          </div>;
        })}
      </div>

      <div class="empty-state" id="empty-results" hidden>
        <Icon name="search" size={40} />
        <h2>{t(locale, 'voices.empty')}</h2>
        <p>{t(locale, 'voices.emptyCopy')}</p>
        <button class="btn" type="button" id="reset-filters">{t(locale, 'voices.clearFilters')}</button>
      </div>
    </div>
  </main>
  {presetLang && otherLangs.length > 0 && (
    <section class="section other-langs" aria-labelledby="other-langs">
      <div class="section-head"><div><h2 id="other-langs">{t(locale, 'langPage.others')}</h2></div><div class="section-head-side"><a class="link-arrow" href={L('/voices/')}>{t(locale, 'langPage.allVoices')}<Icon name="arrowRight" size={16} /></a></div></div>
      <ul class="lang-links">
        {otherLangs.map((o) => <li><a href={L(`/voices/language/${o.code}/`)}><Flag lang={o.code} /><span>{o.label}</span><small>{formatNumber(locale, o.n)}</small></a></li>)}
      </ul>
    </section>
  )}
  <script is:inline type="application/json" id="catalog-ui" set:html={JSON.stringify(ui)} />

  <script>
    import { fold, scoreItem, tokens } from '../../lib/search';
    import { bindFavButtons } from '../../lib/favorites';
    import { bindQuickPlay } from '../../lib/quickplay';

    const ui = JSON.parse(document.getElementById('catalog-ui')!.textContent || '{}');
    const nf = new Intl.NumberFormat(ui.tag);
    const search = document.getElementById('search') as HTMLInputElement;
    const clearQ = document.getElementById('clear-q') as HTMLButtonElement;
    const slashHint = document.getElementById('slash-hint') as HTMLElement;
    const sort = document.getElementById('sort') as HTMLSelectElement;
    const grid = document.getElementById('grid') as HTMLElement;
    const countEl = document.getElementById('count') as HTMLElement;
    const chipsEl = document.getElementById('chips') as HTMLElement;
    const empty = document.getElementById('empty-results') as HTMLElement;
    const facetsEl = document.getElementById('facets') as HTMLElement;
    const scrim = document.getElementById('scrim') as HTMLElement;
    const filtersN = document.getElementById('filters-n') as HTMLElement;
    const rows = [...grid.querySelectorAll<HTMLElement>('.vrow')];
    const original = new Map(rows.map((r) => [r, r.querySelector<HTMLElement>('[data-hl]')!.textContent || '']));
    const FACETS = [...document.querySelectorAll<HTMLElement>('[data-facet]')].map((el) => el.dataset.facet!);
    const TOGGLES = ['dataset', 'recent'];
    const boxes = (id: string) => [...document.querySelectorAll<HTMLInputElement>(`input[name="${id}"]`)];
    const toggle = (id: string) => document.querySelector<HTMLInputElement>(`input[data-toggle="${id}"]`)!;

    // ---- State <-> URL ----
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') || '';
    for (const f of FACETS) {
      const vals = (params.get(f) || '').split(',').filter(Boolean);
      boxes(f).forEach((b) => (b.checked = vals.includes(b.value)));
    }
    for (const tg of TOGGLES) toggle(tg).checked = params.get(tg) === '1';
    const legacyMulti = params.get('multi') === '1';
    if (legacyMulti) boxes('speakers').forEach((b) => (b.checked = b.value === 'multi'));
    sort.value = params.get('sort') || 'relevance';
    if (![...sort.options].some((o) => o.value === sort.value)) sort.value = 'relevance';
    let view = params.get('view') === 'grid' ? 'grid' : (localStorage.getItem('piper-view') || 'list');

    const selected = () => Object.fromEntries(FACETS.map((f) => [f, new Set(boxes(f).filter((b) => b.checked).map((b) => b.value))])) as Record<string, Set<string>>;

    function writeUrl(sel: Record<string, Set<string>>) {
      const next = new URLSearchParams();
      if (search.value.trim()) next.set('q', search.value.trim());
      for (const f of FACETS) if (sel[f].size) next.set(f, [...sel[f]].join(','));
      for (const tg of TOGGLES) if (toggle(tg).checked) next.set(tg, '1');
      if (sort.value !== 'relevance') next.set('sort', sort.value);
      if (view === 'grid') next.set('view', 'grid');
      const qs = next.toString();
      history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : ''));
    }

    // ---- Highlight (diacritic-insensitive) ----
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    function highlight(text: string, toks: string[]): string {
      if (!toks.length) return esc(text);
      let folded = '';
      const map: number[] = [];
      for (let i = 0; i < text.length; i++) {
        const f = text[i].normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[_\-./·,()]/g, ' ');
        for (const ch of f) { folded += ch; map.push(i); }
      }
      const marks = new Array(text.length).fill(false);
      for (const tok of toks) {
        let at = folded.indexOf(tok);
        while (at >= 0) { for (let k = at; k < at + tok.length; k++) marks[map[k]] = true; at = folded.indexOf(tok, at + tok.length); }
      }
      let out = '', open = false;
      for (let i = 0; i < text.length; i++) {
        if (marks[i] && !open) { out += '<mark>'; open = true; }
        if (!marks[i] && open) { out += '</mark>'; open = false; }
        out += esc(text[i]);
      }
      return out + (open ? '</mark>' : '');
    }

    // ---- Core ----
    const scores = new Map<HTMLElement, number>();
    // Facet values of a row; multi-valued facets (traits) are space-separated.
    const vals = (r: HTMLElement, f: string) => (r.dataset[f] || '').split(' ').filter(Boolean);
    function matchesFacets(r: HTMLElement, sel: Record<string, Set<string>>, skip?: string) {
      for (const f of FACETS) if (f !== skip && sel[f].size && !vals(r, f).some((v) => sel[f].has(v))) return false;
      for (const tg of TOGGLES) if (toggle(tg).checked && r.dataset[tg] !== '1') return false;
      return true;
    }

    function apply() {
      const toks = tokens(search.value);
      const sel = selected();
      clearQ.hidden = !search.value;
      slashHint.hidden = !!search.value;
      // Text pass
      const textOk: HTMLElement[] = [];
      for (const r of rows) {
        const sc = toks.length ? scoreItem(r.dataset.search!, r.dataset.title!, toks) : 1;
        scores.set(r, sc);
        if (sc > 0) textOk.push(r);
      }
      // Visibility
      let visible = 0;
      for (const r of rows) {
        const ok = scores.get(r)! > 0 && matchesFacets(r, sel);
        r.hidden = !ok;
        if (ok) visible++;
        const hl = r.querySelector<HTMLElement>('[data-hl]')!;
        hl.innerHTML = highlight(original.get(r)!, ok ? toks : []);
      }
      // Facet counts: each facet counts against every other active filter (disjunctive faceting).
      for (const f of FACETS) {
        const c = new Map<string, number>();
        for (const r of textOk) if (matchesFacets(r, sel, f)) for (const v of vals(r, f)) c.set(v, (c.get(v) || 0) + 1);
        for (const b of boxes(f)) {
          const n = c.get(b.value) || 0;
          const label = b.closest('.check') as HTMLElement;
          label.querySelector('[data-count]')!.textContent = nf.format(n);
          label.classList.toggle('is-zero', n === 0 && !b.checked);
        }
      }
      // Count + empty
      countEl.innerHTML = ui.results.replace('{visible}', `<strong>${nf.format(visible)}</strong>`).replace('{total}', nf.format(rows.length));
      empty.hidden = visible > 0;
      grid.hidden = visible === 0;
      renderChips(sel);
      order(toks.length > 0);
      writeUrl(sel);
    }

    function order(hasQuery: boolean) {
      const byName = (a: HTMLElement, b: HTMLElement) => a.dataset.name!.localeCompare(b.dataset.name!);
      const v = (r: HTMLElement) => Number(r.dataset.voices || 0);
      const u = (r: HTMLElement) => r.dataset.updated || '0000';
      const mode = sort.value === 'relevance' && !hasQuery ? 'updated-desc' : sort.value;
      const cmp: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        relevance: (a, b) => scores.get(b)! - scores.get(a)! || u(b).localeCompare(u(a)) || byName(a, b),
        name: byName,
        'voices-desc': (a, b) => v(b) - v(a) || byName(a, b),
        'voices-asc': (a, b) => v(a) - v(b) || byName(a, b),
        'updated-desc': (a, b) => u(b).localeCompare(u(a)) || byName(a, b),
        'updated-asc': (a, b) => u(a).localeCompare(u(b)) || byName(a, b),
      };
      const sorted = [...rows].sort(cmp[mode] || cmp['updated-desc']);
      const frag = document.createDocumentFragment();
      sorted.forEach((r) => frag.append(r));
      grid.append(frag);
    }

    function chip(label: string, key: string, onRemove: () => void) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'chip';
      b.setAttribute('aria-label', `${ui.remove}: ${label}`);
      b.innerHTML = `${key ? `<span class="chip-k">${esc(key)}</span>` : ''}${esc(label)}<span class="chip-x" aria-hidden="true"><svg viewBox="0 0 20 20" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m5 5 10 10M15 5 5 15"/></svg></span>`;
      b.addEventListener('click', () => { onRemove(); apply(); });
      return b;
    }

    function renderChips(sel: Record<string, Set<string>>) {
      chipsEl.replaceChildren();
      let n = 0;
      for (const f of FACETS) for (const b of boxes(f)) if (b.checked) {
        n++;
        chipsEl.append(chip(b.closest('.check')!.querySelector('.check-label')!.textContent || b.value, ui.facetTitles[f], () => { b.checked = false; }));
      }
      for (const tg of TOGGLES) if (toggle(tg).checked) { n++; chipsEl.append(chip(ui[tg], '', () => { toggle(tg).checked = false; })); }
      filtersN.hidden = n === 0;
      filtersN.textContent = String(n);
      if (n > 1 || (n && search.value)) {
        const all = document.createElement('button');
        all.type = 'button';
        all.className = 'clear-all';
        all.textContent = (document.getElementById('reset-filters') as HTMLElement).textContent || '';
        all.addEventListener('click', reset);
        chipsEl.append(all);
      }
      void sel;
    }

    function reset() {
      search.value = '';
      FACETS.forEach((f) => boxes(f).forEach((b) => (b.checked = false)));
      TOGGLES.forEach((tg) => (toggle(tg).checked = false));
      apply();
      search.focus();
    }

    function setView(next: string) {
      view = next;
      grid.dataset.view = next;
      document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => { if (b !== grid) b.setAttribute('aria-pressed', String(b.dataset.view === next)); });
      try { localStorage.setItem('piper-view', next); } catch {}
    }

    // ---- Events ----
    let tId = 0;
    search.addEventListener('input', () => { clearTimeout(tId); tId = window.setTimeout(apply, 60); });
    search.addEventListener('keydown', (e) => { if (e.key === 'Escape' && search.value) { e.stopPropagation(); search.value = ''; apply(); } });
    clearQ.addEventListener('click', () => { search.value = ''; apply(); search.focus(); });
    document.addEventListener('keydown', (e) => {
      const typing = (e.target as HTMLElement).closest('input, textarea, select');
      if (e.key === '/' && !typing) { e.preventDefault(); search.focus(); search.select(); }
    });
    facetsEl.addEventListener('change', apply);
    sort.addEventListener('change', apply);
    document.querySelectorAll<HTMLButtonElement>('.segmented [data-view]').forEach((b) => b.addEventListener('click', () => { setView(b.dataset.view!); writeUrl(selected()); }));
    document.getElementById('reset-filters')!.addEventListener('click', reset);

    // Facet "show all" + in-facet filtering
    document.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((btn) => {
      const list = btn.parentElement!.querySelector('.facet-list')!;
      const more = btn.textContent;
      btn.addEventListener('click', () => {
        const collapsed = list.classList.toggle('is-collapsed');
        btn.textContent = collapsed ? more : ui.showLess;
      });
    });
    document.querySelectorAll<HTMLInputElement>('[data-facet-filter]').forEach((inp) => {
      const body = inp.closest('.facet-body')!;
      const list = body.querySelector('.facet-list')!;
      const emptyMsg = body.querySelector<HTMLElement>('.facet-empty')!;
      const more = body.querySelector<HTMLElement>('[data-more]');
      inp.addEventListener('input', () => {
        const q = fold(inp.value);
        let shown = 0;
        list.classList.toggle('is-filtering', !!q);
        list.querySelectorAll<HTMLElement>('.check').forEach((c) => {
          const ok = !q || c.dataset.label!.includes(q);
          c.hidden = !ok;
          if (ok) shown++;
        });
        emptyMsg.hidden = shown > 0;
        if (more) more.hidden = !!q;
      });
    });

    // Mobile filter drawer
    const openDrawer = (open: boolean) => { facetsEl.classList.toggle('is-open', open); scrim.classList.toggle('is-open', open); };
    document.getElementById('facets-open')!.addEventListener('click', () => openDrawer(true));
    document.getElementById('facets-close')!.addEventListener('click', () => openDrawer(false));
    scrim.addEventListener('click', () => openDrawer(false));

    // Prefetch detail pages on intent
    const prefetched = new Set<string>();
    const prefetch = (e: Event) => {
      const a = (e.target as Element).closest('.vrow')?.querySelector<HTMLAnchorElement>('a.vrow-link');
      if (!a || prefetched.has(a.href)) return;
      prefetched.add(a.href);
      fetch(a.href).catch(() => {});
    };
    grid.addEventListener('pointerover', prefetch);
    grid.addEventListener('focusin', prefetch);

    // Open facets that hold an active selection
    for (const f of FACETS) if (boxes(f).some((b) => b.checked)) (document.querySelector(`[data-facet="${f}"]`) as HTMLDetailsElement).open = true;
    // Whole row opens the model page; buttons and links inside keep their own action.
    grid.addEventListener('click', (e) => {
      const el = e.target as Element;
      if (el.closest('button, a')) return;
      const row = el.closest<HTMLElement>('.vrow');
      if (!row) return;
      const me = e as MouseEvent;
      if (me.ctrlKey || me.metaKey) window.open(row.dataset.href, '_blank');
      else location.href = row.dataset.href!;
    });
    bindFavButtons(grid);
    bindQuickPlay(grid);
    setView(view);
    apply();
  </script>
</Layout>
