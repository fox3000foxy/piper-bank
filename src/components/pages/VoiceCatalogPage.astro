---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/models.json';
import { formatNumber, languageLabel, localizedPath, t, type Locale } from '../../i18n/ui';

const { locale = 'fr' as Locale } = Astro.props;

const models = data.filter((m) => m.usable);
const languages = [...new Set(models.map((m) => m.lang))].sort();
const availableQualities = new Set(models.map((m) => m.quality));
const qualities = ['high', 'medium', 'low', 'unknown'].filter((q) => availableQualities.has(q));
const totalVoices = models.reduce((acc, m) => acc + m.voices, 0);
const base = import.meta.env.BASE_URL;
---
<Layout title={t(locale, 'voices.title')} active="voices" locale={locale} pageUrl="/voices/" description={t(locale, 'voices.description')}>
  <main class="catalog-page">
    <section class="catalog-intro editorial-intro">
      <div><p class="eyebrow">{t(locale, 'voices.eyebrow')}</p><h1>{t(locale, 'voices.heading')}</h1></div>
      <div class="catalog-description"><p>{t(locale, 'voices.intro')}</p><span class="catalog-count">{formatNumber(locale, models.length)} {t(locale, 'voices.models')} <i>·</i> {formatNumber(locale, totalVoices)} {t(locale, 'voices.speakers')}</span></div>
    </section>
    <section class="catalog-controls" aria-label={t(locale, 'voices.filters')}>
      <label class="search-field"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.7" cy="8.7" r="5.8"/><path d="m13 13 4.2 4.2"/></svg><input id="search" type="search" placeholder={t(locale, 'voices.searchPlaceholder')} autocomplete="off" aria-label={t(locale, 'voices.searchLabel')} /></label>
      <label class="filter-select"><span>{t(locale, 'filter.language')}</span><select id="lang-filter"><option value="">{t(locale, 'filter.all')}</option>{languages.map((l) => <option value={l}>{languageLabel(l, models.find((m) => m.lang === l)?.langName || l, locale)}</option>)}</select></label>
      <label class="filter-select"><span>{t(locale, 'filter.quality')}</span><select id="quality-filter"><option value="">{t(locale, 'filter.all')}</option>{qualities.map((q) => <option value={q}>{t(locale, q === 'high' ? 'quality.high' : q === 'medium' ? 'quality.medium' : q === 'low' ? 'quality.low' : 'quality.unknown')}</option>)}</select></label>
      <label class="multi-filter"><input type="checkbox" id="multivoice-only" /><span>{t(locale, 'filter.multiVoice')}</span></label>
    </section>
    <div class="results-bar"><span id="count" class="count" data-template={t(locale, 'voices.results')} data-number-locale={locale === 'fr' ? 'fr-FR' : 'en-US'}></span><label class="sort-select"><span>{t(locale, 'filter.sort')}</span><select id="sort"><option value="name">{t(locale, 'sort.name')}</option><option value="voices-desc">{t(locale, 'sort.voicesDesc')}</option><option value="voices-asc">{t(locale, 'sort.voicesAsc')}</option></select></label></div>
    <div id="grid" class="voice-index">
      {models.map((m, i) => <a class="voice-row" href={localizedPath(base, locale, `/model/${m.slug}/`)} style={`--model-hue:${m.avatar?.hue ?? 260}`} data-name={m.name} data-lang={m.lang} data-quality={m.quality} data-multivoice={m.voices > 1 ? '1' : '0'} data-voices={m.voices} data-search={`${m.name} ${m.author} ${m.langName} ${m.repo} ${(m.voiceNames || []).join(' ')}`.toLowerCase()}>
        <span class="voice-row-avatar" style={`--h:${m.avatar?.hue ?? 260}`} aria-hidden="true">{m.avatar?.icon ? <img src={`${base}${m.avatar.icon}`} alt="" loading="lazy" /> : m.avatar?.universe === 'default' ? <svg class="avatar-wave" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 13v6m5-11v16m5-19v22m5-17v12m5-8v4" /></svg> : (m.avatar?.emoji || m.name[0])}</span><span class="voice-row-title">{m.name.replace(/\s+(?:x[_\s]?)?(?:high|medium|low|unknown)$/i, '')}<small>{m.author} <i>·</i> {m.repo}</small></span><span class="voice-row-language">{languageLabel(m.lang, m.langName, locale)}</span><span class="voice-row-spec"><span class="quality-label">{t(locale, m.quality === 'high' ? 'quality.high' : m.quality === 'medium' ? 'quality.medium' : m.quality === 'low' ? 'quality.low' : 'quality.unknown')}</span>{m.updated && (Date.now() - new Date(m.updated + 'T00:00:00Z').getTime()) < 14 * 864e5 && <span class="new-pill">{t(locale, 'common.new')}</span>}{m.voices > 1 && <small>{t(locale, 'voices.speakerCount', { count: formatNumber(locale, m.voices) })}</small>}</span><span class="voice-row-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
    <p class="empty-results" hidden id="empty-results">{t(locale, 'voices.empty')} <button id="reset-filters">{t(locale, 'voices.clearFilters')}</button></p>
  </main>
  <script>
    const search = document.getElementById('search');
    const langFilter = document.getElementById('lang-filter');
    const qualityFilter = document.getElementById('quality-filter');
    const multivoiceOnly = document.getElementById('multivoice-only');
    const count = document.getElementById('count');
    const grid = document.getElementById('grid');
    const empty = document.getElementById('empty-results');
    const reset = document.getElementById('reset-filters');
    const sort = document.getElementById('sort');
    const rows = [...grid.querySelectorAll('.voice-row')];
    const state = new URLSearchParams(location.search);
    search.value = state.get('q') || '';
    langFilter.value = state.get('lang') || '';
    qualityFilter.value = state.get('quality') || '';
    multivoiceOnly.checked = state.get('multi') === '1';
    function apply() {
      const q = search.value.toLowerCase().trim(); let visible = 0;
      for (const row of rows) {
        const ok = (!q || row.dataset.search.includes(q)) && (!langFilter.value || row.dataset.lang === langFilter.value) && (!qualityFilter.value || row.dataset.quality === qualityFilter.value) && (!multivoiceOnly.checked || row.dataset.multivoice === '1');
        row.hidden = !ok; if (ok) visible++;
      }
      count.textContent = count.dataset.template.replace('{visible}', new Intl.NumberFormat(count.dataset.numberLocale).format(visible)).replace('{total}', new Intl.NumberFormat(count.dataset.numberLocale).format(rows.length));
      empty.hidden = visible > 0;
      const next = new URLSearchParams();
      if (search.value.trim()) next.set('q', search.value.trim());
      if (langFilter.value) next.set('lang', langFilter.value);
      if (qualityFilter.value) next.set('quality', qualityFilter.value);
      if (multivoiceOnly.checked) next.set('multi', '1');
      history.replaceState(null, '', `${location.pathname}${next.size ? `?${next}` : ''}`);
    }
    [search, langFilter, qualityFilter, multivoiceOnly].forEach((el) => el.addEventListener(el === search ? 'input' : 'change', apply));
    sort.addEventListener('change', () => {
      const byName = (a, b) => a.dataset.name.localeCompare(b.dataset.name);
      const voicesOf = (row) => Number(row.dataset.voices || 0);
      rows.sort(sort.value === 'name' ? byName : sort.value === 'voices-desc' ? (a,b) => voicesOf(b)-voicesOf(a) || byName(a,b) : (a,b) => voicesOf(a)-voicesOf(b) || byName(a,b)).forEach(row => grid.append(row));
    });
    reset.addEventListener('click', () => { search.value = ''; langFilter.value = ''; qualityFilter.value = ''; multivoiceOnly.checked = false; apply(); search.focus(); });
    apply();
  </script>
</Layout>
