---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/models.json';
import { formatNumber, languageLabel, localizedPath, t, type Locale } from '../../i18n/ui';

const { locale = 'fr' as Locale } = Astro.props;

const models = data
  .filter((m) => m.usable || m.piperPlus)
  .sort((a, b) => (b.updated || '').localeCompare(a.updated || '') || a.name.localeCompare(b.name));
const languages = [...new Set(models.map((m) => m.lang))].sort();
const availableQualities = new Set(models.map((m) => m.quality));
const qualities = ['high', 'medium', 'low', 'unknown'].filter((q) => availableQualities.has(q));
const totalVoices = models.reduce((acc, m) => acc + m.voices, 0);
// Description meta (og:, twitter:, SEO) avec les compteurs du catalogue,
// calculés au build depuis les données : exacts à chaque déploiement.
const metaDescription = t(locale, 'voices.metaDescription', {
  models: formatNumber(locale, models.length),
  langs: formatNumber(locale, languages.length),
  voices: formatNumber(locale, totalVoices),
});
const base = import.meta.env.BASE_URL;
---
<Layout title={t(locale, 'voices.title')} active="voices" locale={locale} pageUrl="/voices/" breadcrumbs={[{ name: t(locale, 'nav.home'), path: '/' }, { name: t(locale, 'nav.voices'), path: '/voices/' }]} description={metaDescription}>
  <main class="catalog-page">
    <section class="catalog-intro editorial-intro">
      <div><p class="eyebrow">{t(locale, 'voices.eyebrow')}</p><h1>{t(locale, 'voices.heading')}</h1></div>
      <div class="catalog-description"><p>{t(locale, 'voices.intro')}</p><span class="catalog-count">{formatNumber(locale, models.length)} {t(locale, 'voices.models')} <i>·</i> {formatNumber(locale, totalVoices)} {t(locale, 'voices.speakers')}</span><a class="rss-link" href={localizedPath(base, locale, '/rss.xml')} title={t(locale, 'voices.rss')} aria-label={t(locale, 'voices.rss')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 11a8 8 0 0 1 8 8M5 4a15 15 0 0 1 15 15" /><circle cx="5.6" cy="18.4" r="1.6" fill="currentColor" stroke="none" /></svg></a></div>
    </section>
    <section class="catalog-controls" aria-label={t(locale, 'voices.filters')}>
      <label class="search-field"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.7" cy="8.7" r="5.8"/><path d="m13 13 4.2 4.2"/></svg><input id="search" type="search" placeholder={t(locale, 'voices.searchPlaceholder')} autocomplete="off" aria-label={t(locale, 'voices.searchLabel')} /></label>
      <label class="filter-select"><span>{t(locale, 'filter.language')}</span><select id="lang-filter"><option value="">{t(locale, 'filter.all')}</option>{languages.map((l) => <option value={l}>{languageLabel(l, models.find((m) => m.lang === l)?.langName || l, locale)}</option>)}</select></label>
      <label class="filter-select"><span>{t(locale, 'filter.quality')}</span><select id="quality-filter"><option value="">{t(locale, 'filter.all')}</option>{qualities.map((q) => <option value={q}>{t(locale, q === 'high' ? 'quality.high' : q === 'medium' ? 'quality.medium' : q === 'low' ? 'quality.low' : 'quality.unknown')}</option>)}</select></label>
      <label class="multi-filter"><input type="checkbox" id="multivoice-only" /><span>{t(locale, 'filter.multiVoice')}</span></label>
    </section>
    <div class="results-bar"><span id="count" class="count" data-template={t(locale, 'voices.results')} data-number-locale={locale === 'fr' ? 'fr-FR' : 'en-US'}>{t(locale, 'voices.results', { visible: formatNumber(locale, models.length), total: formatNumber(locale, models.length) })}</span><label class="sort-select"><span>{t(locale, 'filter.sort')}</span><select id="sort"><option value="updated-desc">{t(locale, 'sort.updatedDesc')}</option><option value="name">{t(locale, 'sort.name')}</option><option value="voices-desc">{t(locale, 'sort.voicesDesc')}</option><option value="voices-asc">{t(locale, 'sort.voicesAsc')}</option><option value="updated-asc">{t(locale, 'sort.updatedAsc')}</option></select></label></div>
    <div id="grid" class="voice-index">
      {models.map((m) => <a class="voice-row" href={localizedPath(base, locale, `/model/${m.slug}/`)} style={`--model-hue:${m.avatar?.hue ?? 260}`} data-name={m.name} data-lang={m.lang} data-quality={m.quality} data-multivoice={m.voices > 1 ? '1' : '0'} data-voices={m.voices} data-updated={m.updated || ''} data-search={`${m.name} ${m.author} ${m.langName} ${m.repo} ${(m.voiceNames || []).join(' ')}`.toLowerCase()}>
        <span class="voice-row-avatar" style={`--h:${m.avatar?.hue ?? 260}`} aria-hidden="true">{m.avatar?.icon ? <img src={`${base}${m.avatar.icon}`} alt="" loading="lazy" /> : m.avatar?.universe === 'default' ? <svg class="avatar-wave" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 13v6m5-11v16m5-19v22m5-17v12m5-8v4" /></svg> : (m.avatar?.emoji || m.name[0])}</span><span class="voice-row-title">{m.name.replace(/\s+(?:x[_\s]?)?(?:high|medium|low|unknown)$/i, '')}{m.updated && (Date.now() - new Date(m.updated + 'T00:00:00Z').getTime()) < 14 * 864e5 && <span class="new-pill">{t(locale, 'common.new')}</span>}{m.piperPlus && <span class="plus-pill">Piper+</span>}<small>{m.author} <i>·</i> {m.repo}{m.updated && <span> <i>·</i> {m.updated}</span>}</small></span><span class="voice-row-language">{languageLabel(m.lang, m.langName, locale)}</span><span class="voice-row-spec"><span class="quality-label">{t(locale, m.quality === 'high' ? 'quality.high' : m.quality === 'medium' ? 'quality.medium' : m.quality === 'low' ? 'quality.low' : 'quality.unknown')}</span>{m.voices > 1 && <small>{t(locale, 'voices.speakerCount', { count: formatNumber(locale, m.voices) })}</small>}</span><span class="voice-row-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
    <p class="empty-results" hidden id="empty-results">{t(locale, 'voices.empty')} <button id="reset-filters">{t(locale, 'voices.clearFilters')}</button></p>
  </main>
  <script>
    // Les ids ci-dessous sont tous présents dans le balisage de cette page : casts ciblés, aucune garde runtime ajoutée.
    const search = document.getElementById('search') as HTMLInputElement;
    const langFilter = document.getElementById('lang-filter') as HTMLSelectElement;
    const qualityFilter = document.getElementById('quality-filter') as HTMLSelectElement;
    const multivoiceOnly = document.getElementById('multivoice-only') as HTMLInputElement;
    const count = document.getElementById('count') as HTMLElement;
    const grid = document.getElementById('grid') as HTMLElement;
    const empty = document.getElementById('empty-results') as HTMLElement;
    const reset = document.getElementById('reset-filters') as HTMLButtonElement;
    const sort = document.getElementById('sort') as HTMLSelectElement;
    const rows = [...grid.querySelectorAll<HTMLAnchorElement>('.voice-row')];
    const prefetched = new Set();
    const prefetch = (a: HTMLAnchorElement | null) => {
      if (!a || prefetched.has(a.href)) return;
      prefetched.add(a.href);
      fetch(a.href).catch(() => {});
    };
    grid.addEventListener('pointerover', (e) => { const a = (e.target as Element).closest<HTMLAnchorElement>('a.voice-row'); if (a) prefetch(a); });
    grid.addEventListener('focusin', (e) => { const a = (e.target as Element).closest<HTMLAnchorElement>('a.voice-row'); if (a) prefetch(a); });
    const state = new URLSearchParams(location.search);
    search.value = state.get('q') || '';
    langFilter.value = state.get('lang') || '';
    qualityFilter.value = state.get('quality') || '';
    multivoiceOnly.checked = state.get('multi') === '1';
    function apply() {
      const q = search.value.toLowerCase().trim(); let visible = 0;
      for (const row of rows) {
        const ok = (!q || row.dataset.search!.includes(q)) && (!langFilter.value || row.dataset.lang === langFilter.value) && (!qualityFilter.value || row.dataset.quality === qualityFilter.value) && (!multivoiceOnly.checked || row.dataset.multivoice === '1');
        row.hidden = !ok; if (ok) visible++;
      }
      count.textContent = count.dataset.template!.replace('{visible}', new Intl.NumberFormat(count.dataset.numberLocale).format(visible)).replace('{total}', new Intl.NumberFormat(count.dataset.numberLocale).format(rows.length));
      empty.hidden = visible > 0;
      const next = new URLSearchParams();
      if (search.value.trim()) next.set('q', search.value.trim());
      if (langFilter.value) next.set('lang', langFilter.value);
      if (qualityFilter.value) next.set('quality', qualityFilter.value);
      if (multivoiceOnly.checked) next.set('multi', '1');
      history.replaceState(null, '', `${location.pathname}${next.size ? `?${next}` : ''}`);
    }
    [search, langFilter, qualityFilter, multivoiceOnly].forEach((el) => el.addEventListener(el === search ? 'input' : 'change', apply));
    sort.addEventListener('change', () => {
      const byName = (a: HTMLAnchorElement, b: HTMLAnchorElement) => a.dataset.name!.localeCompare(b.dataset.name!);
      const voicesOf = (row: HTMLAnchorElement) => Number(row.dataset.voices || 0);
      const updatedOf = (row: HTMLAnchorElement) => row.dataset.updated || '0000';
      rows.sort(sort.value === 'name' ? byName : sort.value === 'voices-desc' ? (a,b) => voicesOf(b)-voicesOf(a) || byName(a,b) : sort.value === 'voices-asc' ? (a,b) => voicesOf(a)-voicesOf(b) || byName(a,b) : sort.value === 'updated-desc' ? (a,b) => updatedOf(b).localeCompare(updatedOf(a)) || byName(a,b) : (a,b) => updatedOf(a).localeCompare(updatedOf(b)) || byName(a,b)).forEach(row => grid.append(row));
    });
    reset.addEventListener('click', () => { search.value = ''; langFilter.value = ''; qualityFilter.value = ''; multivoiceOnly.checked = false; apply(); search.focus(); });
    apply();
  </script>
</Layout>
