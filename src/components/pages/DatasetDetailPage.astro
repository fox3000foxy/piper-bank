---
import Layout from '../../layouts/Layout.astro';
import { languageLabel, localizedPath, t, type Locale } from '../../i18n/ui';

const { locale = 'fr' as Locale } = Astro.props;
const { ds: d } = Astro.props;
const base = import.meta.env.BASE_URL;
const hasModel = !!(d.model && d.modelSlug);
// Dépôt Hugging Face privé (champ `private` de datasets_mapping.csv) :
// son URL publique renvoie une erreur 401, donc pas de lien cliquable.
const repo = d.repo && !d.repo.startsWith('↔') ? d.repo : '';
const repoIsPrivate = d.private === true;
// Schema.org Dataset (résultats enrichis Google + Dataset Search) :
// name + description requis, le reste recommandé.
const datasetSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: d.name,
  description: `Speech dataset "${d.name}" (${d.langName || d.lang}) used to train Piper TTS voices. Hosted on Hugging Face.`,
  url: `https://piperhub.org${base === '/' ? '' : base}/dataset/${d.slug}/`,
  inLanguage: d.lang,
  isAccessibleForFree: true,
};
if (repo) datasetSchema.sameAs = `https://huggingface.co/datasets/${repo}`;
// creator = propriétaire du dépôt Hub (champ `license` vient de datasets.json,
// alimenté par scripts/dataset_licenses.json ; absent si inconnue).
if (repo && repo.includes('/')) {
  const owner = repo.split('/')[0];
  datasetSchema.creator = {
    '@type': 'Person',
    name: owner,
    url: `https://huggingface.co/${owner}`,
  };
}
if (d.license) datasetSchema.license = d.license.startsWith('http')
  ? d.license
  : { '@type': 'CreativeWork', name: d.license };
---

<Layout title={`${d.name} – ${t(locale, 'dataset.metaTitle')}`} active="datasets" locale={locale} pageUrl={`/dataset/${d.slug}/`}
  jsonLdExtra={[datasetSchema]}
  breadcrumbs={[
    { name: t(locale, 'nav.home'), path: '/' },
    { name: t(locale, 'nav.datasets'), path: '/datasets/' },
    { name: d.name, path: `/dataset/${d.slug}/` },
  ]}
  description={t(locale, 'dataset.description', { class: d.class || '-', source: d.source || '-', language: languageLabel(d.lang, d.langName || d.lang, locale) })} subtitle={`${d.source || t(locale, 'dataset.titleFallback')} · ${languageLabel(d.lang, d.langName || d.lang, locale)}`}>
  <a class="back" href={localizedPath(base, locale, '/datasets/')}>{t(locale, 'detail.backDatasets')}</a>

  <div class="hero model-hero">
    <span class="avatar big dataset-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 7.5h6l2 2h9v9h-17z"/><path d="M3.5 7.5v-2h6l2 2"/></svg></span>
    <div>
      <h1>{d.name}</h1>
      <p class="subtitle">{d.class} · {d.source}</p>
    </div>
  </div>

  <section class="tags">
    <span class="tag lang">{languageLabel(d.lang, d.langName || d.lang, locale)}</span>
    <span class="tag">{d.source || '-'}</span>
    {hasModel
      ? <a class="tag voices" href={localizedPath(base, locale, `/model/${d.modelSlug}/`)}>{t(locale, 'dataset.modelAssociated', { model: d.model })}</a>
      : <span class="tag q-medium">{t(locale, 'datasets.toTrain')}</span>}
  </section>

  <div class="model-cols">
    <div class="model-main">
      <section class="sec first">
        <h2>{t(locale, 'dataset.information')}</h2>
        <dl class="details">
          <div><dt>{t(locale, 'dataset.class')}</dt><dd>{d.class || '-'}</dd></div>
          <div><dt>{t(locale, 'dataset.source')}</dt><dd>{d.source || '-'}</dd></div>
          <div><dt>{t(locale, 'detail.language')}</dt><dd>{languageLabel(d.lang, d.langName || d.lang, locale)}</dd></div>
          <div><dt>{t(locale, 'detail.repository')}</dt><dd>{repo
            ? (repoIsPrivate
              ? <>{repo} <span class="dim">({t(locale, 'common.private')})</span></>
              : <a href={`https://huggingface.co/datasets/${repo}`}>{repo}</a>)
            : t(locale, 'common.none')}</dd></div>
          <div><dt>{t(locale, 'dataset.status')}</dt><dd>{hasModel ? t(locale, 'dataset.filesAndModel') : t(locale, 'dataset.filesAvailable')}</dd></div>
        </dl>
      </section>

      <section class="sec">
        <h2>{t(locale, 'dataset.trainVoice')}</h2>
        <p class="dim">
          {hasModel
            ? t(locale, 'dataset.modelAlreadyAssociated')
            : t(locale, 'dataset.noModelYet', { metadata: 'metadata.csv', wavs: 'wavs', onnx: 'model.onnx', json: 'model.onnx.json' })}
        </p>
      </section>
    </div>
    <aside class="model-side">
      <section class="sec first">
          <h2>{t(locale, 'dataset.links')}</h2>
        <div class="dl-row">
          {repo && !repoIsPrivate &&
            <a class="btn-dl" href={`https://huggingface.co/datasets/${repo}`}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.5v10m0 0 4-4m-4 4-4-4M3.5 14.5v2h13v-2"/></svg>{t(locale, 'dataset.openDataset')}</a>}
          {d.thread &&
            <a class="btn-dl ghost" href={`https://discord.com/channels/1523276835712929946/${d.thread}`}>{t(locale, 'detail.discussion')}</a>}
        </div>
        {repoIsPrivate && <p class="dim">{t(locale, 'dataset.privateRepoNote')}</p>}
      </section>

      {hasModel && (
        <section class="sec">
          <h2>{t(locale, 'dataset.model')}</h2>
          <div class="dl-row">
            <a class="btn-dl" href={localizedPath(base, locale, `/model/${d.modelSlug}/`)}>→ {d.model}</a>
          </div>
        </section>
      )}
    </aside>
  </div>

</Layout>
