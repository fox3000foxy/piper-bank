---
import Layout from '../../layouts/Layout.astro';
import { formatNumber, languageLabel, localizedPath, t, type Locale } from '../../i18n/ui';

const { locale = 'fr' as Locale } = Astro.props;
const { model: m } = Astro.props;
const base = import.meta.env.BASE_URL;
const avatar = m.avatar || { emoji: '?', hue: 260, icon: null };
const voicePairs: { name: string; sid: number }[] = (m.voiceNames || []).map((vn: string, i: number) => ({
  name: vn, sid: (m.voiceIds || [])[i] ?? i,
}));
const updatedDate = m.updated ? new Date(m.updated + 'T00:00:00Z') : null;
const isFresh = !!updatedDate && (Date.now() - updatedDate.getTime()) < 14 * 864e5;
const updatedLabel = updatedDate ? updatedDate.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
const HF_SAMPLES = 'https://huggingface.co/datasets/fox3000foxy/piper-samples/resolve/main/';
// Product (résultats enrichis) : modèle = téléchargement gratuit.
// Sans avis utilisateurs, seul le prix "0" peut s'afficher : modeste mais valide.
const nVoices = (m.voiceNames || []).length || 1;
const productSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: m.name,
  description: `Piper TTS voice model "${m.name}" (${m.langName || m.lang}, ${m.quality || 'n/a'}). ${nVoices} voice(s) by ${m.author}. Free download on Hugging Face.`,
  url: `https://piperhub.org${base === '/' ? '' : base}/model/${m.slug}/`,
  image: 'https://piperhub.org' + base + 'logo.png',
  inLanguage: m.lang,
  brand: { '@type': 'Brand', name: m.author },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: `https://huggingface.co/${m.repo}`,
  },
};
if (m.license) productSchema.license = String(m.license).startsWith('http')
  ? m.license
  : { '@type': 'CreativeWork', name: m.license };
const sampleBaseSrv = (m.repo.replace('/', '--') + '__' + m.onnx.replace('/', '_').replace(/\.onnx$/, '')).replace(/[^a-zA-Z0-9\-_.]/g, '_');
const sampleUrlSrv = (sid: number, n: number) => `${HF_SAMPLES}${sampleBaseSrv}__sp${sid}__${n}.wav`;
const seedOf = (slug: string, sid: number) => {
  let h = 0x811c9dc5;
  const s = `${slug}:${sid}`;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return h >>> 0;
};
const waveformPath = (seed: number) => {  let state = (Math.abs(Math.trunc(seed)) || 1) >>> 0;
  let height = 4;
  return Array.from({ length: 68 }, (_, i) => {
    state = (state * 1664525 + 1013904223) >>> 0;
    height = Math.round(height * 0.52 + (3 + (state % 23)) * 0.48);
    return `M${4 + i * 8} ${28 - height / 2}v${height}`;
  }).join(' ');
};
// Demo sentence for the npm snippet, in the voice's own language.
// Keyed by base language code; unknown codes fall back to English.
const SAMPLE_SENTENCE: Record<string, string> = {
  en: 'Hello from Piper.', fr: 'Bonjour de la part de Piper.', de: 'Hallo von Piper.',
  es: 'Hola de parte de Piper.', it: 'Ciao da parte di Piper.', pt: 'Olá da parte do Piper.',
  ru: 'Привет от Piper.', ar: 'مرحباً من Piper.', zh: '你好，这是 Piper。',
  ja: 'こんにちは、Piper です。', ko: '안녕하세요, Piper입니다。', hi: 'Piper की ओर से नमस्ते।',
  vi: 'Xin chào từ Piper.', th: 'สวัสดีจาก Piper', tr: "Piper'dan merhaba.",
  nl: 'Hallo van Piper.', pl: 'Cześć od Piper.', uk: 'Привіт від Piper.',
  fa: 'سلام از Piper.', ur: 'Piper کی طرف سے سلام۔', ta: 'Piper இடமிருந்து வணக்கம்.',
  te: 'Piper నుండి నమస్కారం.', ml: 'Piper-ൽ നിന്ന് നമസ്കാരം.', bn: 'Piper-এর পক্ষ থেকে হ্যালো।',
  ne: 'Piper बाट नमस्कार।', si: 'Piper ගෙන් ආයුබෝවන්.', mr: 'Piper कडून नमस्कार.',
  kn: 'Piper ನಿಂದ ನಮಸ್ಕಾರ.', cs: 'Ahoj od Piper.', sk: 'Ahoj od Piper.',
  hu: 'Üdvözlet Piper-től.', ro: 'Salut din partea lui Piper.', el: 'Γεια σας από το Piper.',
  sv: 'Hej från Piper.', da: 'Hej fra Piper.', fi: 'Tervehdys Piperilta.',
  no: 'Hei fra Piper.', is: 'Halló frá Piper.', et: 'Tere Piperilt.',
  lv: 'Sveiki no Piper.', lt: 'Sveiki nuo Piper.', sl: 'Pozdravljeni od Piper.',
  sr: 'Поздрав од Piper-a.', bg: 'Здравей от Piper.', ca: 'Hola de part de Piper.',
  eu: 'Kaixo Piper-en partetik.', cy: 'Helo gan Piper.', id: 'Halo dari Piper.',
  ms: 'Halo dari Piper.', he: "שלום מ-Piper.", ka: 'გამარჯობა Piper-ისგან.',
  hy: 'Ողջույն Piper-ից:', kk: 'Piper-ден сәлем.', sw: 'Hujambo kutoka Piper.',
  ha: 'Sannu daga Piper.', lb: 'Hallo vum Piper.', tet: 'Ola husi Piper.',
  tdt: 'Ola husi Piper.', rw: 'Murakaza neza kuva Piper.', kmr: 'Silav ji Piper.',
  ku: 'Silav ji Piper.', nya: 'Moni kuchokera kwa Piper.', sat: 'Johar Piper khon.',
};
const sampleSentence = SAMPLE_SENTENCE[String(m.lang || 'en').toLowerCase().split(/[-_]/)[0]] ?? SAMPLE_SENTENCE.en;
const speakerMax = (m.voices || 1) - 1;
const synthCall = m.voices > 1
  ? `// ${m.voices} speakers: set speakerId 0–${speakerMax}.\nconst { audio } = await tts.synthesize("${sampleSentence}", { speakerId: 0 });`
  : `const { audio } = await tts.synthesize("${sampleSentence}");`;
const jsSnippet = `import { PiperNativeTTS } from "pipertts";\n\nconst tts = await PiperNativeTTS.load({\n  model: "hub:${m.slug}",\n  modelsDir: "./models",\n});\n\n${synthCall}`;
// Coloration JS/TS minimale, rendue au build (HTML statique, aucun JS client).
function hlJS(src: string): string {
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const re = /(\/\/[^\n]*)|("(?:[^"\\\n]|\\.)*")|\b(import|from|const|await|new|return|export|async|function)\b|\b(\d[\d_]*)\b/g;
  let out = '', last = 0, m: RegExpExecArray | null;
  while ((m = re.exec(src))) {
    out += esc(src.slice(last, m.index));
    const cls = m[1] ? 'tok-com' : m[2] ? 'tok-str' : m[3] ? 'tok-kw' : 'tok-num';
    out += `<span class="${cls}">${esc(m[0])}</span>`;
    last = m.index + m[0].length;
  }
  return out + esc(src.slice(last));
}
---

<Layout title={`${m.name} – Piper TTS`} active="voices" locale={locale} pageUrl={`/model/${m.slug}/`}
  breadcrumbs={[
    { name: t(locale, 'nav.home'), path: '/' },
    { name: t(locale, 'nav.voices'), path: '/voices/' },
    { name: m.name, path: `/model/${m.slug}/` },
  ]}
  description={t(locale, 'detail.metaDescription', {
    name: m.name,
    language: languageLabel(m.lang, m.langName || m.lang, locale),
    quality: m.quality || 'n/a',
    author: m.author,
  })} subtitle={`${t(locale, 'common.by')} ${m.author}`}
  jsonLdExtra={[productSchema]}>

    <a class="back" href={localizedPath(base, locale, '/voices/')}>{t(locale, 'detail.backVoices')}</a>
    <div class="hero model-hero">
      <span class="avatar-wrap">
        <span class="avatar big" style={`--h:${avatar.hue ?? 260}`} aria-hidden="true">
          {avatar.icon
            ? <img src={`${base}${avatar.icon}`} alt="" />
            : avatar.universe === 'default'
              ? <svg class="avatar-wave" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 13v6m5-11v16m5-19v22m5-17v12m5-8v4" /></svg>
              : avatar.emoji}
        </span>
        {avatar.certified && <img class="cert big-cert" src={`${base}icons/certified.svg`} alt={t(locale, 'detail.modelOfficial')} title={t(locale, 'detail.modelOfficial')} />}
      </span>
      <div>
        <h1>{m.name}</h1>
        <p class="subtitle">{t(locale, 'common.by')} {m.author} · {m.repo}</p>
      </div>
    </div>

    <section class="tags">
      <span class="tag lang">{languageLabel(m.lang, m.langName, locale)}</span>
      <span class={`tag q-${m.quality}`}>{t(locale, m.quality === 'high' ? 'quality.high' : m.quality === 'medium' ? 'quality.medium' : m.quality === 'low' ? 'quality.low' : 'quality.unknown')}</span>
      {m.piperPlus && <span class="plus-pill" title="piper-plus">Piper+</span>}
      {m.voices > 1
        ? <span class="tag voices">{formatNumber(locale, m.voices)} {t(locale, 'common.voicesUnit')}</span>
        : <span class="tag">{t(locale, 'common.oneSpeaker')}</span>}
      {m.dataset
        ? <a class="tag voices" href={localizedPath(base, locale, `/dataset/${m.dataset.slug || ''}/`)} title={m.dataset.repo}>{t(locale, 'detail.dataset')}</a>
        : <span class="tag q-medium">{t(locale, 'detail.noDataset')}</span>}
      <span class="tag type">{m.phonemeType === 'text' ? `${t(locale, 'detail.phonemes')}: ${t(locale, 'detail.textPhoneme')}` : `${t(locale, 'detail.phonemes')}: ${((m.configs || {}).espeak || {}).voice || 'espeak'}`}</span>
      <span class="tag">{formatNumber(locale, m.sampleRate)} Hz</span>
      {isFresh && <span class="tag new-pill">{t(locale, 'common.new')}</span>}
      {m.updated && <span class="tag">{t(locale, 'detail.updatedOn', { date: updatedLabel })}</span>}
    </section>

    <div class="model-cols">
      <div class="model-main">
    {!m.usable && <section class="sec"><p class="dim">{t(locale, 'detail.piperPlusNote')}</p></section>}
    <section class="sec first" hidden={!m.usable}>
      <h2>{t(locale, 'detail.synthesis')}</h2>
      <textarea id="text" rows="7" placeholder={t(locale, 'detail.enterText')}></textarea>
      <div class="editor-submit"><span id="status" class="dim" aria-live="polite"></span><button id="go">{t(locale, 'detail.generateAudio')} <span aria-hidden="true">→</span></button></div>
      <div id="synthesis-player" class="synthesis-player" style={`--synth-hue:${avatar.hue ?? 260}`} hidden>
        <button id="synthesis-toggle" class="sample-play" type="button" aria-label={t(locale, 'detail.playSynthesis')} data-play-label={t(locale, 'detail.playSynthesis')} data-pause-label={t(locale, 'detail.pauseSynthesis')}>
          <svg class="play-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4.8 8 5.2-8 5.2z"/></svg>
          <svg class="pause-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10m6-10v10"/></svg>
        </button>
        <div class="synthesis-track">
          <div class="synthesis-wave">
            <svg viewBox="0 0 540 56" preserveAspectRatio="none" aria-hidden="true">
              <defs><clipPath id="synthesis-progress-clip" clipPathUnits="userSpaceOnUse"><rect id="synthesis-progress" x="0" y="0" width="0" height="56" /></clipPath></defs>
              <path class="synthesis-wave-rest" d={waveformPath(m.sampleRate + m.name.length)} />
              <path class="synthesis-wave-played" d={waveformPath(m.sampleRate + m.name.length)} clip-path="url(#synthesis-progress-clip)" />
            </svg>
            <input id="synthesis-seek" type="range" min="0" max="1000" value="0" aria-label={t(locale, 'detail.synthesisPosition')} />
          </div>
          <div class="synthesis-time"><span id="synthesis-current">0:00</span><span id="synthesis-duration">0:00</span><a id="synthesis-download" class="synthesis-dl" href="#" download="synthesis.wav" aria-label={t(locale, 'detail.downloadAudio')} title={t(locale, 'detail.downloadAudio')}>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v10m0 0 4-4m-4 4-4-4M4 17h12"/></svg>
          </a></div>
        </div>
      </div>
      <audio id="player" preload="none" hidden></audio>
    </section>

    {m.usable && voicePairs.length > 1 && (
    <section class="sec">
      <h2>{t(locale, 'detail.compareVoices')}</h2>
      <p class="dim">{t(locale, 'detail.compareHelp')}</p>
      <div class="cmp-selects">
        {['cmp-a', 'cmp-b', 'cmp-c'].map((id, k) => (
          <label>{t(locale, 'detail.compareSlot', { letter: 'ABC'[k] })}
            <select id={id}>
              {k > 0 && <option value="">-</option>}
              {voicePairs.map((voice, vi) => <option value={voice.sid} selected={(k === 0 && vi === 0) || (k === 1 && vi === 1)}>{voice.name}</option>)}
            </select>
          </label>
        ))}
        <button id="cmp-go" class="btn-dl">{t(locale, 'detail.compareRun')}</button>
      </div>
      <div id="cmp-status" class="dim" aria-live="polite"></div>
      <div id="cmp-results" class="cmp-results"></div>
    </section>
    )}

      <section class="sec">
        <h2>{t(locale, 'detail.information')}</h2>
      <dl class="details">
        <div><dt>{t(locale, 'detail.author')}</dt><dd>{m.author}</dd></div>
        <div><dt>{t(locale, 'detail.repository')}</dt><dd><a href={`https://huggingface.co/${m.repo}`}>{m.repo}</a></dd></div>
        <div><dt>{t(locale, 'detail.language')}</dt><dd>{languageLabel(m.lang, m.langName, locale)}</dd></div>
        <div><dt>{t(locale, 'detail.quality')}</dt><dd class="cap">{t(locale, m.quality === 'high' ? 'quality.high' : m.quality === 'medium' ? 'quality.medium' : m.quality === 'low' ? 'quality.low' : 'quality.unknown')}</dd></div>
        <div><dt>{t(locale, 'detail.speakers')}</dt><dd>{formatNumber(locale, m.voices)}</dd></div>
        <div><dt>{t(locale, 'detail.phonemes')}</dt><dd>{m.phonemeType === 'text' ? t(locale, 'detail.textPhoneme') : (((m.configs || {}).espeak || {}).voice || 'espeak')}</dd></div>
        <div><dt>{t(locale, 'detail.sampleRate')}</dt><dd>{formatNumber(locale, m.sampleRate)} Hz</dd></div>
        <div><dt>{t(locale, 'detail.license')}</dt><dd>{m.license || t(locale, 'detail.noLicense')}</dd></div>
      </dl>
    </section>

    <section class="sec">
      <h2>{t(locale, 'detail.dataset')}</h2>
      {m.dataset
        ? <div><a href={localizedPath(base, locale, m.dataset.slug ? `/dataset/${m.dataset.slug}/` : '/datasets/')}>{m.dataset.name}</a> <span class="dim">· {m.dataset.source} · {m.dataset.repo}</span></div>
        : <div><p class="dim">{t(locale, 'detail.noDataset')}</p></div>}
    </section>


      </div>
      <aside class="model-side">
    <section class="sec first setting-section" hidden={!m.usable}>
      <h2>{t(locale, 'detail.voiceSettings')}</h2>
      {voicePairs.length > 1 ? <label class="synthesis-voice">{t(locale, 'detail.voiceToSynthesize')}
        <select id="voice-select" aria-label={t(locale, 'detail.selectVoice')}>
          {voicePairs.map((voice) => <option value={voice.sid}>{voice.name}</option>)}
        </select>
      </label> : <p class="dim synthesis-single-voice">{t(locale, 'detail.singleVoice')}: {voicePairs[0]?.name || t(locale, 'detail.defaultVoice')}</p>}
      <div class="setting-grid">
        <label>{t(locale, 'detail.speed')} <input id="len" type="number" step="0.05" min="0.2" max="3" placeholder={t(locale, 'detail.speedPlaceholder')} /></label>
        <label>{t(locale, 'detail.noise')} <input id="noise" type="number" step="0.05" min="0" max="1.5" placeholder={t(locale, 'detail.noisePlaceholder')} /></label>
      </div>
    </section>
    <section class="sec download-section">
      <h2>{t(locale, 'detail.downloads')}</h2>
      <div class="dl-row">
        <a class="btn-dl" href={`https://huggingface.co/${m.repo}/resolve/main/${m.onnx}`} aria-label={t(locale, 'detail.downloadOnnx')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.5v10m0 0 4-4m-4 4-4-4M3.5 14.5v2h13v-2"/></svg>model.onnx</a>
        <a class="btn-dl" href={`https://huggingface.co/${m.repo}/resolve/main/${m.json}`} aria-label={t(locale, 'detail.downloadJson')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.5v10m0 0 4-4m-4 4-4-4M3.5 14.5v2h13v-2"/></svg>model.onnx.json</a>
        <a class="btn-dl ghost" href={`https://huggingface.co/${m.repo}`}>{t(locale, 'detail.huggingFace')}</a>
        {m.thread && <a class="btn-dl ghost" href={`https://discord.com/channels/1523276835712929946/${m.thread}`}>{t(locale, 'detail.discussion')}</a>}
      </div>
    </section>

    {m.usable &&
    <section class="sec">
      <h2>{t(locale, 'detail.nodeUse')}</h2>
      <p class="dim">{t(locale, 'detail.nodeUseCopy')}</p>
      <div class="snippet-wrap">
      <pre class="guide-code guide-code-command"><code>npm install pipertts</code></pre>
      <div class="snippet-code">
      <pre class="guide-code lang-js"><code set:html={hlJS(jsSnippet)} /></pre>
      <button type="button" class="snippet-copy" data-copied={t(locale, 'detail.copied')} aria-label={t(locale, 'detail.copySnippet')}>{t(locale, 'detail.copySnippet')}</button>
      </div>
      </div>
      <div class="dl-row">
        <a class="btn-dl ghost" href="https://www.npmjs.com/package/pipertts">pipertts · npm ↗</a>
        <a class="btn-dl ghost" href="https://itsrealfortune.fr/pipertts/">{t(locale, 'detail.apiReference')} ↗</a>
      </div>
    </section>
    }

    <section class="sec">
      <h2>{t(locale, 'detail.voiceSamples', { count: formatNumber(locale, m.voices) })}</h2>
      <p class="dim">{t(locale, 'detail.sampleHelp')}</p>
      <div id="voice-list" class="voice-list">
        {voicePairs.slice(0, 120).map((v, i) => {
          const clipId = `voice-progress-${m.slug}-${i}`;
          return (
          <div class="player" style={`--voice-hue:${(i * 51.43 + 18) % 360}`} data-sid={v.sid} data-vname={v.name}>
            <button class="pp" aria-label={t(locale, 'detail.listenVoice', { name: v.name })}>
              <svg class="icon-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4.5 14 10l-8 5.5z"/></svg>
              <svg class="icon-pause" viewBox="0 0 20 20" aria-hidden="true"><path d="M6.5 5v10m7-10v10"/></svg>
            </button>
            <div class="pbody">
              <div class="prow">
                <button class="pname" title={v.name}>{v.name}</button>
                <span class="ex-sw">
                  <button class="ex on" data-n="0" title={t(locale, 'detail.sampleN', { number: 1 })}>1</button><button class="ex" data-n="1" title={t(locale, 'detail.sampleN', { number: 2 })}>2</button>
                </span>
                <span class="ptime"></span>
              </div>
              <div class="pwave">
                <svg class="pwave-svg" data-seed={seedOf(m.slug, v.sid)} viewBox="0 0 540 56" preserveAspectRatio="none" aria-hidden="true">
                  <defs><clipPath id={clipId} clipPathUnits="userSpaceOnUse"><rect class="pwave-progress" x="0" y="0" width="0" height="56" /></clipPath></defs>
                  <path class="pwave-rest" d="" />
                  <path class="pwave-played" d="" clip-path={`url(#${clipId})`} />
                </svg>
                <input class="pbar" type="range" min="0" max="1000" value="0" aria-label={t(locale, 'detail.samplePosition', { name: v.name })} />
              </div>
              <div class="psamples">
                <audio preload="none" data-n="0" src={sampleUrlSrv(v.sid, 0)}></audio>
                <audio preload="none" data-n="1" src={sampleUrlSrv(v.sid, 1)}></audio>
              </div>
            </div>
          </div>
          );
        })}
        {voicePairs.length > 120 && <p class="dim">{t(locale, 'detail.moreSpeakers', { count: formatNumber(locale, voicePairs.length - 120) })}</p>}
      </div>
    </section>
      </aside>
    </div>

    <script type="application/json" id="model-data" set:html={JSON.stringify(m)} />
    <script type="application/json" id="ui-messages" set:html={JSON.stringify({ locale, labels: { enterText: t(locale, 'detail.enterTextStatus'), audioReady: t(locale, 'detail.audioReady'), sampleUnavailable: t(locale, 'detail.sampleUnavailable'), listenVoice: t(locale, 'detail.listenVoice'), pauseVoice: t(locale, 'detail.pauseVoice'), durationPair: t(locale, 'detail.durationPair'), synthProgress: t(locale, 'detail.synthProgress'), synthFailure: t(locale, 'detail.synthFailure'), downloadSample: t(locale, 'detail.downloadSample'), compareStatus: t(locale, 'detail.compareStatus') } })} />
    <script define:vars={{ siteBase: base }}>window.__BASE__ = siteBase;</script>
    <script type="module">
      const model = JSON.parse(document.getElementById('model-data').textContent);
      const ui = JSON.parse(document.getElementById('ui-messages').textContent);
      const message = (template, values = {}) => template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));

      // Waveforms décoratives générées côté client (même PRNG que le build).
      const wavePath = (seed) => {
        let state = (Math.abs(Math.trunc(seed)) || 1) >>> 0, height = 4;
        const out = [];
        for (let i = 0; i < 68; i++) {
          state = (state * 1664525 + 1013904223) >>> 0;
          height = Math.round(height * 0.52 + (3 + (state % 23)) * 0.48);
          out.push(`M${4 + i * 8} ${28 - height / 2}v${height}`);
        }
        return out.join(' ');
      };
      document.querySelectorAll('.pwave-svg[data-seed]').forEach((svg) => {
        const d = wavePath(Number(svg.dataset.seed));
        svg.querySelector('.pwave-rest')?.setAttribute('d', d);
        svg.querySelector('.pwave-played')?.setAttribute('d', d);
      });
      // Keep one preview active and expose seeking through a native range control.
      let currentAudio = null, currentCard = null, progressFrame = 0;
      const voiceSelect = document.getElementById('voice-select');
      if (voiceSelect) window.__selSid = Number(voiceSelect.value);
      voiceSelect?.addEventListener('change', () => { window.__selSid = Number(voiceSelect.value); });
      try {
        const params = new URLSearchParams(location.search);
        const preText = params.get('text');
        if (preText) document.getElementById('text').value = preText;
        const preSid = params.get('sid');
        if (preSid !== null && voiceSelect && [...voiceSelect.options].some((o) => o.value === preSid)) {
          voiceSelect.value = preSid;
          voiceSelect.dispatchEvent(new Event('change'));
        }
      } catch {}
      const fmt = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
      const resetCard = (card) => {
        if (!card) return;
        card.classList.remove('playing');
        const button = card.querySelector('.pp');
        button?.classList.remove('is-playing');
        button?.setAttribute('aria-label', message(ui.labels.listenVoice, { name: card.dataset.vname }));
      };
      const stopCurrent = () => {
        cancelAnimationFrame(progressFrame);
        if (currentAudio) currentAudio.pause();
        resetCard(currentCard);
        currentAudio = null;
        currentCard = null;
      };
      document.querySelectorAll('.player').forEach((card) => {
        const sid = Number(card.dataset.sid);
        const btn = card.querySelector('.pp');
        const time = card.querySelector('.ptime');
        const seek = card.querySelector('.pbar');
        const waveformProgress = card.querySelector('.pwave-progress');
        const audios = [...card.querySelectorAll('audio')];
        const exBtns = [...card.querySelectorAll('.ex')];
        let idx = 0;
        const audio = () => audios[idx];
        const paint = () => {
          const a = audio(), d = a.duration || 0, c = a.currentTime || 0;
          const progress = d ? Math.min(1, Math.max(0, c / d)) : 0;
          seek.value = String(Math.round(progress * Number(seek.max)));
          waveformProgress.setAttribute('width', String(540 * progress));
          seek.setAttribute('aria-valuetext', d ? message(ui.labels.durationPair, { current: fmt(c), duration: fmt(d) }) : fmt(c));
        };
        const animateProgress = () => {
          if (currentAudio !== audio() || audio().paused) return;
          paint();
          progressFrame = requestAnimationFrame(animateProgress);
        };
        const play = async (sampleIndex = idx) => {
          idx = sampleIndex;
          exBtns.forEach((item, n) => item.classList.toggle('on', n === idx));
          const a = audio();
          if (currentAudio && currentAudio !== a) stopCurrent();
          if (!a.paused) { stopCurrent(); return; }
          if (a.error) a.load();
          if (a.ended) a.currentTime = 0;
          currentAudio = a; currentCard = card;
          try {
            await a.play();
            if (currentAudio === a && !a.paused) {
              card.classList.add('playing');
              btn.classList.add('is-playing');
              btn.setAttribute('aria-label', message(ui.labels.pauseVoice, { name: card.dataset.vname }));
              cancelAnimationFrame(progressFrame);
              progressFrame = requestAnimationFrame(animateProgress);
            }
          } catch {
            if (currentAudio === a) {
              resetCard(card);
              time.textContent = ui.labels.sampleUnavailable;
              currentAudio = null; currentCard = null;
            }
          }
        };
        audios.forEach((a) => {
          a.addEventListener('timeupdate', () => { if (a === audio()) paint(); });
          a.addEventListener('loadedmetadata', () => { if (a === audio()) paint(); });
          a.addEventListener('waiting', () => { if (a === audio()) card.classList.add('loading'); });
          a.addEventListener('playing', () => { if (a === audio()) { card.classList.remove('loading'); paint(); } });
          a.addEventListener('pause', () => {
            if (a === currentAudio && !a.ended) {
              resetCard(card);
              currentAudio = null; currentCard = null;
            }
          });
          a.addEventListener('ended', () => { if (a === currentAudio) stopCurrent(); paint(); });
          a.addEventListener('error', () => {
            if (a === audio()) {
              card.classList.remove('loading');
              time.textContent = ui.labels.sampleUnavailable;
              resetCard(card);
              if (a === currentAudio) { currentAudio = null; currentCard = null; }
            }
          });
        });
        btn.addEventListener('click', () => { void play(); });
        exBtns.forEach((item, n) => item.addEventListener('click', (event) => {
          event.stopPropagation();
          void play(n);
        }));
        seek.addEventListener('input', () => {
          const a = audio();
          if (Number.isFinite(a.duration) && a.duration > 0) {
            a.currentTime = (Number(seek.value) / Number(seek.max)) * a.duration;
            paint();
          }
        });
        card.querySelector('.pname').addEventListener('click', () => {
          document.querySelectorAll('.pname').forEach((item) => item.classList.remove('sel'));
          card.querySelector('.pname').classList.add('sel');
          window.__selSid = sid;
          if (voiceSelect) voiceSelect.value = String(sid);
        });
      });

      // Copy buttons on npm snippets (textContent yields the raw, unescaped code).
      document.querySelectorAll('.snippet-copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const code = btn.closest('.snippet-wrap')?.querySelector('.lang-js code')?.textContent ?? '';
          try { await navigator.clipboard.writeText(code); }
          catch {
            const ta = document.createElement('textarea');
            ta.value = code; document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); } catch {}
            ta.remove();
          }
          const original = btn.textContent;
          btn.textContent = btn.dataset.copied || 'Copied';
          setTimeout(() => { btn.textContent = original; }, 1500);
        });
      });
      // Onnxruntime (vendor-ort) n'est chargé qu'au premier clic sur Générer :
      // la page reste légère au chargement initial.
      const loadStack = () => new Function('u', 'return import(u)')(window.__BASE__ + 'piper-infer.js');
      const go = document.getElementById('go');
      if (go) {
      document.getElementById('text').addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); go.click(); }
      });
      const synthesisAudio = document.getElementById('player');
      const synthesisControl = document.getElementById('synthesis-player');
      const synthesisToggle = document.getElementById('synthesis-toggle');
      const synthesisSeek = document.getElementById('synthesis-seek');
      const synthesisProgress = document.getElementById('synthesis-progress');
      const synthesisCurrent = document.getElementById('synthesis-current');
      const synthesisDuration = document.getElementById('synthesis-duration');
      const synthesisDownload = document.getElementById('synthesis-download');
      let synthesisUrl = '', synthesisFrame = 0;
      const paintSynthesis = () => {
        const duration = Number.isFinite(synthesisAudio.duration) ? synthesisAudio.duration : 0;
        const current = synthesisAudio.currentTime || 0;
        const progress = duration ? Math.min(1, Math.max(0, current / duration)) : 0;
        synthesisSeek.value = String(Math.round(progress * Number(synthesisSeek.max)));
        synthesisProgress.setAttribute('width', String(540 * progress));
        synthesisCurrent.textContent = fmt(current);
        synthesisDuration.textContent = fmt(duration);
        synthesisSeek.setAttribute('aria-valuetext', message(ui.labels.durationPair, { current: fmt(current), duration: fmt(duration) }));
      };
      const animateSynthesis = () => {
        paintSynthesis();
        if (!synthesisAudio.paused && !synthesisAudio.ended) synthesisFrame = requestAnimationFrame(animateSynthesis);
      };
      synthesisToggle.addEventListener('click', () => {
        if (synthesisAudio.paused) {
          if (synthesisAudio.ended) synthesisAudio.currentTime = 0;
          synthesisAudio.play().catch(() => {});
        } else synthesisAudio.pause();
      });
      synthesisAudio.addEventListener('play', () => {
        synthesisToggle.classList.add('is-playing');
        synthesisToggle.setAttribute('aria-label', synthesisToggle.dataset.pauseLabel);
        cancelAnimationFrame(synthesisFrame);
        synthesisFrame = requestAnimationFrame(animateSynthesis);
      });
      synthesisAudio.addEventListener('pause', () => {
        synthesisToggle.classList.remove('is-playing');
        synthesisToggle.setAttribute('aria-label', synthesisToggle.dataset.playLabel);
        cancelAnimationFrame(synthesisFrame);
        paintSynthesis();
      });
      synthesisAudio.addEventListener('timeupdate', paintSynthesis);
      synthesisAudio.addEventListener('loadedmetadata', paintSynthesis);
      synthesisAudio.addEventListener('ended', paintSynthesis);
      synthesisSeek.addEventListener('input', () => {
        if (Number.isFinite(synthesisAudio.duration) && synthesisAudio.duration > 0) {
          synthesisAudio.currentTime = Number(synthesisSeek.value) / Number(synthesisSeek.max) * synthesisAudio.duration;
          paintSynthesis();
        }
      });
      go.addEventListener('click', async () => {
        const text = document.getElementById('text').value.trim();
        const status = document.getElementById('status');
        if (!text) { status.textContent = ui.labels.enterText; return; }
        try {
          const params = new URLSearchParams();
          params.set('text', text);
          if (window.__selSid !== null && window.__selSid !== undefined) params.set('sid', String(window.__selSid));
          history.replaceState(null, '', `${location.pathname}?${params}`);
        } catch {}
        synthesisAudio.pause();
        synthesisAudio.removeAttribute('src');
        synthesisAudio.load();
        synthesisControl.hidden = true;
        if (synthesisUrl) URL.revokeObjectURL(synthesisUrl);
        synthesisUrl = '';
        go.disabled = true;
        try {
          const { synthesize } = await loadStack();
          const blob = await synthesize({
            repo: model.repo, onnx: model.onnx, configs: model.configs,
            phonemeType: model.phonemeType, phonemeIdMap: model.phonemeIdMap,
            sampleRate: model.sampleRate, text,
            speakerId: window.__selSid ?? null,
            lengthScale: parseFloat(document.getElementById('len').value) || undefined,
            noiseScale: parseFloat(document.getElementById('noise').value) || undefined,
          }, (s) => { status.textContent = message(ui.labels.synthProgress, { progress: s }); });
          synthesisUrl = URL.createObjectURL(blob);
          synthesisAudio.src = synthesisUrl;
          synthesisDownload.href = synthesisUrl;
          const sidPart = (window.__selSid === null || window.__selSid === undefined) ? '' : '-sp' + window.__selSid;
          synthesisDownload.download = `${(model.slug || model.repo || 'synthesis').split('/').pop()}${sidPart}.wav`;
          synthesisAudio.hidden = true;
          synthesisControl.hidden = false;
          synthesisAudio.load();
          paintSynthesis();
          status.textContent = ui.labels.audioReady;
          synthesisAudio.play().catch(() => {});
        } catch (e) { status.textContent = message(ui.labels.synthFailure, { message: e.message || e }); }
        finally { go.disabled = false; }
      });
      const cmpGo = document.getElementById('cmp-go');
      if (cmpGo) {
        const cmpRes = document.getElementById('cmp-results');
        const cmpStatus = document.getElementById('cmp-status');
        const cmpNames = Object.fromEntries([...document.getElementById('voice-select').options].map((o) => [o.value, o.text]));
        let cmpCurrent = null;
        const cmpUrls = [];
        const clearCmp = () => {
          cmpUrls.forEach((u) => URL.revokeObjectURL(u));
          cmpUrls.length = 0;
          cmpRes.innerHTML = '';
        };
        cmpGo.addEventListener('click', async () => {
          const text = document.getElementById('text').value.trim();
          const status = document.getElementById('status');
          if (!text) { status.textContent = ui.labels.enterText; return; }
          const sids = ['cmp-a', 'cmp-b', 'cmp-c']
            .map((id) => document.getElementById(id).value)
            .filter((v, i, a) => v !== '' && a.indexOf(v) === i);
          if (!sids.length) return;
          cmpGo.disabled = true;
          clearCmp();
          if (cmpCurrent) { cmpCurrent.pause(); cmpCurrent = null; }
          let done = 0;
          const { synthesize } = await loadStack();
          for (const sid of sids) {
            cmpStatus.textContent = message(ui.labels.compareStatus, { done: done + 1, total: sids.length, name: cmpNames[sid] || sid });
            try {
              const blob = await synthesize({
                repo: model.repo, onnx: model.onnx, configs: model.configs,
                phonemeType: model.phonemeType, phonemeIdMap: model.phonemeIdMap,
                sampleRate: model.sampleRate, text, speakerId: Number(sid),
                lengthScale: parseFloat(document.getElementById('len').value) || undefined,
                noiseScale: parseFloat(document.getElementById('noise').value) || undefined,
              });
              const url = URL.createObjectURL(blob);
              cmpUrls.push(url);
              const row = document.createElement('div');
              row.className = 'cmp-row';
              row.innerHTML = `<button class="sample-play cmp-toggle" type="button" aria-label="play"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4.5 14 10l-8 5.5z" fill="currentColor" stroke="none"/></svg></button><span class="cmp-name"></span><audio preload="none"></audio>`;
              row.querySelector('.cmp-name').textContent = cmpNames[sid] || ('sp' + sid);
              const audio = row.querySelector('audio');
              audio.src = url;
              const dl = document.createElement('a');
              dl.className = 'synthesis-dl';
              dl.href = url;
              dl.download = `${model.slug}-sp${sid}-compare.wav`;
              dl.setAttribute('aria-label', ui.labels.downloadSample);
              dl.innerHTML = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v10m0 0 4-4m-4 4-4-4M4 17h12"/></svg>';
              row.append(dl);
              row.querySelector('.cmp-toggle').addEventListener('click', () => {
                if (audio.paused) {
                  if (cmpCurrent && cmpCurrent !== audio) cmpCurrent.pause();
                  cmpCurrent = audio;
                  audio.play().catch(() => {});
                } else audio.pause();
              });
              cmpRes.append(row);
            } catch { /* on garde les autres voix */ }
            done++;
          }
          cmpStatus.textContent = '';
          cmpGo.disabled = false;
        });
      }
      }
    </script>
</Layout>
