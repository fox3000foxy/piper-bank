---
import Layout from '../../layouts/Layout.astro';
import { type Locale } from '../../i18n/ui';
import contactFr from '../../i18n/contact/fr.json';
import contactEn from '../../i18n/contact/en.json';
import contactde from '../../i18n/contact/de.json';
import contactes from '../../i18n/contact/es.json';
import contactit from '../../i18n/contact/it.json';
import contactpt from '../../i18n/contact/pt.json';
import contactru from '../../i18n/contact/ru.json';
import contacttr from '../../i18n/contact/tr.json';
import contactja from '../../i18n/contact/ja.json';
import contactko from '../../i18n/contact/ko.json';
import contactzh from '../../i18n/contact/zh.json';
import contactid from '../../i18n/contact/id.json';
import contacthi from '../../i18n/contact/hi.json';
import contactar from '../../i18n/contact/ar.json';
import contactvi from '../../i18n/contact/vi.json';
import contactth from '../../i18n/contact/th.json';

const { locale = 'fr' as Locale } = Astro.props as { locale?: Locale };

// Traductions : un fichier par locale (src/i18n/contact/<code>.json).
// Les locales sans fichier retombent sur l'anglais (repli ci-dessous).
const copyByLocale = { fr: contactFr, en: contactEn, de: contactde, es: contactes, it: contactit, pt: contactpt, ru: contactru, tr: contacttr, ja: contactja, ko: contactko, zh: contactzh, id: contactid, hi: contacthi, ar: contactar, vi: contactvi, th: contactth };
// Pages annexes : repli anglais tant que la locale n'a pas sa version.
const copy = (copyByLocale as unknown as Record<string, typeof copyByLocale.en>)[locale] ?? copyByLocale.en; // repli anglais (pages annexes non traduites)

const WEBHOOK_B64 = 'aHR0cHM6Ly9kaXNjb3JkLmNvbS9hcGkvd2ViaG9va3MvMTU1NjY5MTI1ODkwNTQ2MDc4Ny9KZDhNaFl4bFlvdkFoaWM3TkJERkF6MXNuM3JNQ0t5WnNtb1JZWGJybmJCUkY1a3ktS0NMSWNVcnBXMldXTElENVl0Rw==';
---

<Layout title={copy.title} active="" locale={locale} pageUrl="/contact/"
  description={copy.intro}>
  <main class="legal-page">
    <p class="eyebrow">{copy.title}</p>
    <h1>{copy.title}</h1>
    <p class="lede">{copy.intro}</p>
    <form id="contact-form" class="contact-form" novalidate>
      <label>{copy.name}
        <input id="contact-name" name="name" type="text" maxlength="80" autocomplete="nickname" placeholder={copy.namePlaceholder} required />
      </label>
      <label>{copy.email}
        <input id="contact-email" name="email" type="email" maxlength="120" autocomplete="email" placeholder={copy.emailPlaceholder} />
      </label>
      <label>{copy.message}
        <textarea id="contact-message" name="message" rows="6" maxlength="1800" placeholder={copy.messagePlaceholder} required></textarea>
      </label>
      <div class="editor-submit">
        <span id="contact-status" class="dim" aria-live="polite"></span>
        <button id="contact-send" type="submit">{copy.send} <span aria-hidden="true">→</span></button>
      </div>
      <p class="dim">{copy.hint}</p>
    </form>
    <script define:vars={{ webhook: WEBHOOK_B64, sending: copy.sending, okMsg: copy.ok, failMsg: copy.fail, errMsg: copy.err, errEmail: copy.errEmail }}>
      const form = document.getElementById('contact-form');
      const send = document.getElementById('contact-send');
      const status = document.getElementById('contact-status');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nameField = document.getElementById('contact-name');
        const emailField = document.getElementById('contact-email');
        const msgField = document.getElementById('contact-message');
        const name = nameField.value.trim().slice(0, 80);
        const email = emailField.value.trim().slice(0, 120);
        const text = msgField.value.trim().slice(0, 1800);
        if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
          status.textContent = errEmail;
          status.classList.add('is-error');
          emailField.focus();
          return;
        }
        if (name.length < 2 || text.length < 10) {
          status.textContent = errMsg;
          status.classList.add('is-error');
          (name.length < 2 ? nameField : msgField).focus();
          return;
        }
        status.classList.remove('is-error');
        send.disabled = true;
        status.textContent = sending;
        try {
          const res = await fetch(atob(webhook), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              content: `**${name}**${email ? ' · ' + email : ''} (via piperhub.org)\n${text}`.slice(0, 2000),
              allowed_mentions: { parse: [] },
            }),
          });
          if (!res.ok) throw new Error(res.status);
          status.classList.remove('is-error');
          status.textContent = okMsg;
          form.reset();
        } catch {
          status.classList.add('is-error');
          status.textContent = failMsg;
        } finally {
          send.disabled = false;
        }
      });
    </script>
  </main>
</Layout>
