---
import Layout from '../../layouts/Layout.astro';
import DocsShell from '../DocsShell.astro';
import Icon from '../Icon.astro';
import { localizedPath, t, type Locale } from '../../i18n/ui';
import { guideCopy } from '../../i18n/guides';

const { locale = 'en' as Locale } = Astro.props as { locale?: Locale };
const base = import.meta.env.BASE_URL;
const L = (p: string) => localizedPath(base, locale, p);
const { str } = guideCopy(locale);

const piperPlusRepoUrl = 'https://github.com/ayutaz/piper-plus';
const piperPlusModelsUrl = 'https://github.com/ayutaz/piper-plus/blob/dev/docs/guides/development/pretrained-models.md';
const discordInviteUrl = 'https://discord.gg/xDmDJwfbfp';
---
<Layout title={str('ppTitle')} description={str('ppIntro')} active="guides" locale={locale} pageUrl="/guides-piper-plus/"
  breadcrumbs={[
    { name: t(locale, 'nav.home'), path: '/' },
    { name: t(locale, 'nav.docs'), path: '/guides/' },
    { name: str('ppTitle'), path: '/guides-piper-plus/' },
  ]}>
  <DocsShell locale={locale} current="/guides-piper-plus/">
    <header class="docs-head" id="top">
      <p class="label">{t(locale, 'nav.docs')} · Piper Plus</p>
      <h1>{str('ppTitle')}</h1>
      <p class="lead">{str('ppIntro')}</p>
    </header>

    <section id="piperplus-guide" class="doc-section">
      <p class="doc-section-label">Piper Plus</p>
      <h2>{t(locale, 'docs.ppSetup')}</h2>
      <ol class="doc-steps">
        <li class="doc-step"><span class="doc-step-n">1</span><div><h3>{str('ppStep1')}</h3><p>{str('ppStep1Copy')}</p><pre class="guide-code"><code>{str('ppInstallCommand')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">2</span><div><h3>{str('ppStep2')}</h3><p>{str('ppStep2Copy')}</p><pre class="guide-code"><code>{str('ppDownloadCommand')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">3</span><div><h3>{str('ppStep3')}</h3><p>{str('ppStep3Copy')}</p><pre class="guide-code"><code>{str('ppSynthCommand')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">4</span><div><h3>{str('ppStep4')}</h3><p>{str('ppStep4Copy')}</p>
          <div class="doc-links">
            <a class="doc-link" href={L('/model/tsukuyomi-chan-multilingual-6-language-voice/')}><Icon name="mic" size={14} />Tsukuyomi-chan</a>
            <a class="doc-link" href={L('/model/css10-japanese-6-lang-piper-plus/')}><Icon name="mic" size={14} />CSS10</a>
            <a class="doc-link" href={L('/model/mera-chan-multilingual-6-lang-medium/')}><Icon name="mic" size={14} />Mera</a>
            <a class="doc-link doc-link-primary" href={L('/voices/?engine=plus')}><Icon name="filter" size={14} />{t(locale, 'docs.allPiperPlus')}</a>
          </div>
        </div></li>
      </ol>
      <div class="doc-links">
        <a class="doc-link" href={piperPlusRepoUrl} target="_blank" rel="noreferrer"><Icon name="github" size={14} />{str('ppRepo')}</a>
        <a class="doc-link" href={piperPlusModelsUrl} target="_blank" rel="noreferrer">{str('ppModels')}<Icon name="external" size={14} /></a>
        <a class="doc-link" href={discordInviteUrl} target="_blank" rel="noreferrer"><Icon name="discord" size={14} />{str('ppDiscord')}</a>
      </div>
      <div class="callout"><Icon name="info" size={20} /><div><p>{str('ppHelp')}</p></div></div>
    </section>

    <nav class="doc-pager" aria-label={t(locale, 'nav.docs')}>
      <a href={L('/guides/#pipertts-guide')}><span>{t(locale, 'docs.previous')}</span><strong>{str('npmTitle')}</strong></a>
    </nav>
  </DocsShell>
</Layout>
