---
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import ModelAvatar from '../ModelAvatar.astro';
import Flag from '../Flag.astro';
import data from '../../data/models.json';
import datasets from '../../data/datasets.json';
import { formatNumber, languageLabel, localizedPath, t, tp, type Locale, type MessageKey } from '../../i18n/ui';
import { docsNav } from '../../lib/docs-nav';
import { modelTraits } from '../../lib/traits';

const { locale = 'fr' as Locale } = Astro.props;

const models = data.filter((m) => m.usable || m.piperPlus);
const sample = models.find((m) => m.slug === 'glados-french-medium-voice');
const totalVoices = models.reduce((sum, model) => sum + model.voices, 0);
const langCounts = new Map<string, { n: number; name: string }>();
for (const m of models) {
  const cur = langCounts.get(m.lang) || { n: 0, name: m.langName };
  cur.n++;
  langCounts.set(m.lang, cur);
}
const langCount = langCounts.size;
const topLangs = [...langCounts.entries()].sort((a, b) => b[1].n - a[1].n).slice(0, 12);
const metaDescription = t(locale, 'home.metaDescription', {
  models: formatNumber(locale, models.length),
  langs: formatNumber(locale, langCount),
  voices: formatNumber(locale, totalVoices),
});
type Model = (typeof models)[number];
const featured = [
  models.find((m) => m.slug === 'glados-french-medium-voice'),
  models.find((m) => m.slug === 'siwis-french-fr-medium'),
  models.find((m) => m.slug === 'gilles-french-fr-low'),
  ...models.filter((m) => m.quality === 'high' && m.avatar?.certified).slice(0, 5),
].filter(Boolean).slice(0, 8) as Model[];
const fresh = [...models]
  .filter((m) => m.updated)
  .sort((a, b) => (b.updated || '').localeCompare(a.updated || ''))
  .slice(0, 8);
// Closing call to action: voice icons bursting up from the button.
// Hand-placed fan (x from the button centre, y above it, size), big and close
// at the bottom, small and spread out at the top.
const burstSpots = [
  [-118, 14, 36], [-58, 6, 40], [2, 18, 38], [62, 8, 40], [122, 16, 34],
  [-152, 66, 28], [-90, 76, 30], [-26, 64, 30], [38, 78, 28], [102, 66, 30], [162, 76, 26],
  [-122, 126, 22], [-44, 120, 22], [32, 130, 20], [112, 122, 22],
  [-82, 170, 16], [8, 174, 14], [88, 168, 16],
];
const iconVoices = [...new Map(models.filter((m) => m.avatar?.icon).map((m) => [m.avatar!.icon, m])).values()];
const burst = iconVoices.length ? burstSpots.map(([x, y, size], i) => ({ x: Math.round(x * 0.78), y, size, m: iconVoices[i % iconVoices.length] })) : [];
const provenance = models.find((model) => model.dataset?.slug && model.avatar?.icon);
const base = import.meta.env.BASE_URL;
const L = (p: string) => localizedPath(base, locale, p);
const docs = docsNav(locale).flatMap((g) => g.items).slice(1);
const qKey = (q: string) => (q === 'high' ? 'quality.high' : q === 'medium' ? 'quality.medium' : q === 'low' ? 'quality.low' : 'quality.unknown') as 'quality.high';
const shortName = (n: string) => n.replace(/\s+(?:x[_\s]?)?(?:high|medium|low|unknown)$/i, '');
const userLang = locale === 'en' ? 'en' : locale;
---
<Layout title={t(locale, 'home.title')} rawTitle={t(locale, 'home.rawTitle')} active="home" locale={locale} pageUrl="/" description={metaDescription}>
  <main>
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-grid">
        <div>
          <p class="label">{t(locale, 'home.eyebrow')}</p>
          <h1 id="home-title">{t(locale, 'home.headline')}<br /><span>{t(locale, 'home.headlineSecond')}</span></h1>
          <p class="lead">{t(locale, 'home.deck')}</p>
          <form class="hero-search" action={L('/voices/')} method="get" role="search">
            <label class="textbox">
              <Icon name="search" size={20} />
              <input name="q" type="search" autocomplete="off" placeholder={t(locale, 'voices.searchPlaceholder')} aria-label={t(locale, 'voices.searchLabel')} />
            </label>
            <button class="btn btn-primary" type="submit"><span>{t(locale, 'home.searchButton')}</span><Icon name="arrowRight" size={18} /></button>
          </form>
          <div class="hero-suggest-wrap">
          <div class="hero-suggest">
            <span>{t(locale, 'home.popular')}</span>
            {langCounts.has(userLang) && <a class="chip chip-plain chip-ico" href={L(`/voices/?lang=${userLang}`)}><Flag lang={userLang} />{languageLabel(userLang, langCounts.get(userLang)!.name, locale)}</a>}
            {userLang !== 'en' && <a class="chip chip-plain chip-ico" href={L('/voices/?lang=en')}><Flag lang="en" />{languageLabel('en', 'English', locale)}</a>}
            <a class="chip chip-plain chip-ico" href={L('/voices/?quality=high')}><span class="chip-dot" aria-hidden="true"></span>{t(locale, 'filter.highQuality')}</a>
            <a class="chip chip-plain chip-ico" href={L('/voices/?speakers=multi')}><Icon name="users" size={15} />{t(locale, 'filter.multiVoice')}</a>
            <a class="chip chip-plain chip-ico" href={L('/voices/?source=official')}><img class="chip-logo" src={`${base}brand/piper-mark.png`} alt="" width="16" height="16" loading="lazy" />{t(locale, 'filter.official')}</a>
          </div>
          {/* Mouse helper only: keyboard users reach every chip with Tab, which scrolls it into view. */}
          <button type="button" class="suggest-next" aria-hidden="true" tabindex="-1"><Icon name="chevronRight" size={16} /></button>
          </div>
        </div>

        {sample && <figure class="sample-card" data-sample-player>
          <div class="sample-topline">
            <span class="label">{t(locale, 'home.sampleIndex')}</span>
            <a class="link-arrow" href={L(`/model/${sample.slug}/`)} aria-label={t(locale, 'home.openSampleModel', { name: sample.name })}>{t(locale, 'home.modelDetails')}<Icon name="arrowRight" size={16} /></a>
          </div>
          <div class="sample-voice">
            <ModelAvatar model={sample} size="lg" locale={locale} lazy={false} />
            <div><strong>{sample.name}</strong><span>{languageLabel(sample.lang, sample.langName, locale)} · {t(locale, qKey(sample.quality))} · {sample.author}</span></div>
          </div>
          <div class="sample-playback">
            <button class="sample-play" type="button" data-play-label={t(locale, 'home.listenSample')} data-pause-label={t(locale, 'home.pauseSample')} data-unavailable-label={t(locale, 'home.sampleUnavailable')} aria-label={t(locale, 'home.listenSample')}><svg class="play-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M6.5 4.6v10.8a.6.6 0 0 0 .9.5l8.6-5.4a.6.6 0 0 0 0-1L7.4 4.1a.6.6 0 0 0-.9.5Z"/></svg><svg class="pause-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10m6-10v10"/></svg></button>
            <div class="wave-wrap"><div class="wave-display"><svg class="waveform" viewBox="0 0 540 56" preserveAspectRatio="none" role="img" aria-label={t(locale, 'home.waveform')}><path class="wave-bars" d="M4 27.5v1 M12 27.5v1 M20 26.995v2.01 M28 25.31v5.38 M36 23.845v8.31 M44 24.165v7.67 M52 25.24v5.52 M60 25.75v4.5 M68 23.945v8.11 M76 22.855v10.29 M84 23.24v9.52 M92 23.395v9.21 M100 24.445v7.11 M108 26.675v2.65 M116 27.29v1.42 M124 27.49v1.02 M132 27.5v1 M140 27.5v1 M148 27.5v1 M156 27.5v1 M164 27.5v1 M172 27.435v1.13 M180 26.935v2.13 M188 26.65v2.7 M196 24.89v6.22 M204 25.265v5.47 M212 26.395v3.21 M220 26.54v2.92 M228 26.52v2.96 M236 25.41v5.18 M244 23.85v8.3 M252 25.42v5.16 M260 27.315v1.37 M268 25.185v5.63 M276 24.75v6.5 M284 25.92v4.16 M292 27.45v1.1 M300 25.36v5.28 M308 24.325v7.35 M316 25.51v4.98 M324 26.13v3.74 M332 26.935v2.13 M340 24.48v7.04 M348 25.83v4.34 M356 26.59v2.82 M364 24.39v7.22 M372 25.85v4.3 M380 26.095v3.81 M388 25.17v5.66 M396 24.555v6.89 M404 26.81v2.38 M412 25.905v4.19 M420 24.19v7.62 M428 25.43v5.14 M436 26.955v2.09 M444 25.535v4.93 M452 25.565v4.87 M460 27.305v1.39 M468 27.465v1.07 M476 25.62v4.76 M484 24.83v6.34 M492 25.425v5.15 M500 25.44v5.12 M508 25.315v5.37 M516 25.775v4.45 M524 26.23v3.54 M532 27.08v1.84 M540 27.48v1.04"/></svg><input class="sample-seek" type="range" min="0" max="1000" value="0" aria-label={t(locale, 'home.samplePosition')} /></div><div class="sample-time"><span data-current-time>0:00</span><span>0:03</span></div></div>
          </div>
          <figcaption>{t(locale, 'home.sampleProvidedBy')} <a href="https://huggingface.co/datasets/fox3000foxy/piper-samples" target="_blank" rel="noreferrer">Piper samples</a></figcaption>
          <audio preload="none" src={`${base}audio/glados-fr.wav`}></audio>
        </figure>}
      </div>
    </section>

    <section class="stat-band" aria-label={t(locale, 'home.catalogStats')}>
      <div class="stat-band-grid">
        <div class="stat"><span class="stat-ico"><Icon name="wave" size={18} /></span><strong>{formatNumber(locale, models.length)}</strong><span>{tp(locale, 'home.modelsInCatalog', models.length)}</span></div>
        <div class="stat"><span class="stat-ico"><Icon name="users" size={18} /></span><strong>{formatNumber(locale, totalVoices)}</strong><span>{tp(locale, 'home.speakersListed', totalVoices)}</span></div>
        <div class="stat"><span class="stat-ico"><Icon name="globe" size={18} /></span><strong>{formatNumber(locale, langCount)}</strong><span>{tp(locale, 'home.languagesListed', langCount)}</span></div>
        <div class="stat"><span class="stat-ico"><Icon name="database" size={18} /></span><strong>{formatNumber(locale, datasets.length)}</strong><span>{tp(locale, 'datasets.count', datasets.length)}</span></div>
      </div>
    </section>

    <section class="section" aria-labelledby="langs-title">
      <div class="section-head">
        <div><h2 id="langs-title">{t(locale, 'home.langsTitle')}</h2><p>{t(locale, 'home.langsCopy')}</p></div>
        <a class="link-arrow" href={L('/voices/')}>{t(locale, 'home.browseModels', { count: formatNumber(locale, models.length) })}<Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="lang-grid">
        {topLangs.map(([code, info]) => <a class="lang-tile" href={L(`/voices/language/${code}/`)}>
          <span class="lang-tile-top"><span class="lang-tile-flag"><Flag lang={code} /><span class="lang-tile-code">{code}</span></span><Icon name="arrowUpRight" size={18} /></span>
          <span><strong>{languageLabel(code, info.name, locale)}</strong><span class="n">{formatNumber(locale, info.n)} {t(locale, 'voices.models')}</span></span>
        </a>)}
      </div>
    </section>

    <section class="section" aria-labelledby="featured-title">
      <div class="section-head">
        <div><h2 id="featured-title">{t(locale, 'home.listenDifferences')}</h2><p>{t(locale, 'home.catalogCopy')}</p></div>
        <a class="link-arrow" href={L('/voices/')}>{t(locale, 'home.openCatalog')}<Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="vcards">
        {featured.map((m) => <a class="vcard" href={L(`/model/${m.slug}/`)}>
          <div class="vcard-top"><ModelAvatar model={m} locale={locale} /><Icon name="arrowUpRight" size={18} class="go" /></div>
          <div><h3>{shortName(m.name)}</h3><p class="vcard-meta">{m.author}</p></div>
          <div class="vcard-tags"><span class="badge">{languageLabel(m.lang, m.langName, locale)}</span><span class={`badge badge-q-${m.quality}`}>{t(locale, qKey(m.quality))}</span>{m.voices > 1 && <span class="badge">{tp(locale, 'voices.speakerCount', m.voices, { count: formatNumber(locale, m.voices) })}</span>}{modelTraits(m as any).traits.slice(0, 2).map((x) => <span class="badge">{t(locale, `traitShort.${x}` as MessageKey)}</span>)}</div>
        </a>)}
      </div>
    </section>

    {provenance && <section class="section" aria-labelledby="source-title">
      <div class="feature" style={`--h:${provenance.avatar?.hue ?? 220}`}>
        <div class="feature-visual" aria-hidden="true">
          <div class="feature-pair"><ModelAvatar model={provenance} size="xl" locale={locale} /><span class="feature-link-line"></span><span class="feature-ds"><Icon name="database" size={36} /></span></div>
        </div>
        <div class="feature-body">
          <p class="label">{t(locale, 'home.sourceEyebrow')}</p>
          <h2 id="source-title">{t(locale, 'home.sourceHeadline')} {t(locale, 'home.sourceHeadlineSecond')}</h2>
          <p><strong>{provenance.name}</strong> {t(locale, 'home.sourceCopy', { dataset: provenance.dataset!.name })}</p>
          <div class="feature-actions">
            <a class="btn" href={L(`/model/${provenance.slug}/`)}><Icon name="mic" size={16} />{t(locale, 'home.modelSheet')}</a>
            <a class="btn" href={L(`/dataset/${provenance.dataset!.slug}/`)}><Icon name="database" size={16} />{t(locale, 'home.datasetSheet')}</a>
          </div>
        </div>
      </div>
    </section>}

    <section class="section" aria-labelledby="fresh-title">
      <div class="section-head">
        <div><h2 id="fresh-title">{t(locale, 'home.freshTitle')}</h2><p>{t(locale, 'home.freshCopy')}</p></div>
        <a class="link-arrow" href={L('/voices/?sort=updated-desc')}>{t(locale, 'home.seeAllNew')}<Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="vlist">
        {fresh.map((m) => <a class="vrow" href={L(`/model/${m.slug}/`)}>
          <ModelAvatar model={m} locale={locale} />
          <span class="vrow-title"><strong><span>{shortName(m.name)}</span></strong><small>{m.author} · {m.updated}</small></span>
          <span class="vrow-lang">{languageLabel(m.lang, m.langName, locale)}</span>
          <span class="vrow-q"><span class={`badge badge-q-${m.quality}`}>{t(locale, qKey(m.quality))}</span></span>
          <span class="vrow-speakers">{m.voices > 1 ? tp(locale, 'voices.speakerCount', m.voices, { count: formatNumber(locale, m.voices) }) : t(locale, 'common.oneSpeaker')}</span>
          <Icon name="chevronRight" size={18} class="go" />
        </a>)}
      </div>
    </section>

    <section class="section" aria-labelledby="guides-title">
      <div class="section-head">
        <div><h2 id="guides-title">{t(locale, 'home.guidesTitle')}</h2><p>{t(locale, 'home.guidesCopy')}</p></div>
        <a class="link-arrow" href={L('/guides/')}>{t(locale, 'home.allGuides')}<Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="doc-cards">
        {docs.map((d) => <a class="doc-card" href={L(d.path)}>
          <span class="doc-card-icon"><Icon name={d.icon} size={20} /></span>
          <h3>{d.title}</h3>
          <Icon name="arrowRight" size={18} class="go" />
          <p>{d.summary}</p>
        </a>)}
      </div>
    </section>

    <section class="section">
      <div class="cta">
        <div><h2>{t(locale, 'home.findVoice')}</h2><p>{t(locale, 'home.findVoiceCopy')}</p></div>
        <div class="cta-action">
          {burst.length > 0 && (
            <div class="cta-burst" aria-hidden="true">
              {burst.map((b) => (
                <span class="mavatar burst-item" style={`--x:${b.x}px;--y:${b.y}px;--s:${b.size}px;--h:${b.m.avatar?.hue ?? 220};--d:${Math.round(b.y * 2.2 + Math.abs(b.x) * .6)}ms`}>
                  <span class="mavatar-face"><img src={`${base}${b.m.avatar!.icon}`} alt="" loading="lazy" decoding="async" /></span>
                </span>
              ))}
            </div>
          )}
          <a href={L('/voices/')} class="btn btn-lg">{t(locale, 'home.openCatalog')}<Icon name="arrowRight" size={18} /></a>
        </div>
      </div>
    </section>
  </main>
  <script>
    // Popular shortcuts: fade the end of the row only while some of it is hidden.
    const suggest = document.querySelector<HTMLElement>('.hero-suggest');
    if (suggest) {
      const sync = () => {
        suggest.classList.toggle('is-overflow', suggest.scrollWidth > suggest.clientWidth + 1);
        suggest.classList.toggle('is-end', suggest.scrollLeft + suggest.clientWidth >= suggest.scrollWidth - 2);
      };
      sync();
      suggest.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      // A vertical wheel scrolls the row sideways while there is somewhere to go.
      suggest.addEventListener('wheel', (e) => {
        if (!suggest.classList.contains('is-overflow') || Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
        const max = suggest.scrollWidth - suggest.clientWidth;
        if ((e.deltaY > 0 && suggest.scrollLeft >= max - 1) || (e.deltaY < 0 && suggest.scrollLeft <= 0)) return;
        e.preventDefault();
        suggest.scrollLeft += e.deltaY;
      }, { passive: false });
      // Drag with the mouse; a drag does not count as a click on a chip.
      let startX = 0, startLeft = 0, dragged = false, down = false;
      suggest.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || !suggest.classList.contains('is-overflow')) return;
        down = true; dragged = false; startX = e.clientX; startLeft = suggest.scrollLeft;
      });
      window.addEventListener('pointermove', (e) => {
        if (!down) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 5) { dragged = true; suggest.classList.add('is-dragging'); }
        if (dragged) suggest.scrollLeft = startLeft - dx;
      });
      window.addEventListener('pointerup', () => { down = false; suggest.classList.remove('is-dragging'); });
      suggest.addEventListener('click', (e) => { if (dragged) { e.preventDefault(); dragged = false; } }, true);
      suggest.addEventListener('dragstart', (e) => e.preventDefault());
      document.querySelector('.suggest-next')?.addEventListener('click', () => {
        suggest.scrollBy({ left: suggest.clientWidth * 0.7, behavior: 'smooth' });
      });
    }
    // Play the icon burst once, when the call to action scrolls into view.
    const cta = document.querySelector('.cta');
    if (cta && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { cta.classList.add('is-in'); io.disconnect(); }
      }, { threshold: 0.45 });
      io.observe(cta);
    } else cta?.classList.add('is-in');
    const card = document.querySelector('[data-sample-player]');
    if (card) {
      const audio = card.querySelector('audio') as HTMLAudioElement;
      const button = card.querySelector('.sample-play') as HTMLButtonElement;
      const seek = card.querySelector('.sample-seek') as HTMLInputElement;
      const current = card.querySelector('[data-current-time]') as HTMLElement;
      const bars = card.querySelector('.wave-bars') as SVGPathElement;
      const svg = card.querySelector('.waveform') as SVGSVGElement;
      let playbackFrame = 0;
      const clip = document.createElementNS('http://www.w3.org/2000/svg', 'clipPath');
      const clipRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      clip.id = 'wave-progress-clip';
      clip.setAttribute('clipPathUnits', 'userSpaceOnUse');
      clipRect.setAttribute('x', '0');
      clipRect.setAttribute('y', '0');
      clipRect.setAttribute('width', '0');
      clipRect.setAttribute('height', '56');
      clip.append(clipRect);
      const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
      defs.append(clip);
      svg.prepend(defs);
      const rest = bars.cloneNode(true) as SVGPathElement;
      rest.classList.remove('wave-bars');
      rest.classList.add('wave-rest');
      bars.before(rest);
      bars.setAttribute('clip-path', 'url(#wave-progress-clip)');
      const format = (value: number) => `${Math.floor(value / 60)}:${String(Math.floor(value % 60)).padStart(2, '0')}`;
      const update = () => {
        const progress = audio.duration ? Math.min(1, Math.max(0, audio.currentTime / audio.duration)) : 0;
        seek.value = String(Math.round(progress * 1000));
        current.textContent = format(audio.currentTime);
        clipRect.setAttribute('width', String(540 * progress));
        seek.setAttribute('aria-valuetext', `${format(audio.currentTime)} / ${format(audio.duration || 0)}`);
      };
      const animateProgress = () => {
        update();
        if (!audio.paused && !audio.ended) playbackFrame = requestAnimationFrame(animateProgress);
      };
      button.addEventListener('click', async () => {
        if (audio.paused) {
          try { await audio.play(); } catch { current.textContent = button.dataset.unavailableLabel!; }
        } else audio.pause();
      });
      audio.addEventListener('play', () => { button.classList.add('is-playing'); button.setAttribute('aria-label', button.dataset.pauseLabel!); cancelAnimationFrame(playbackFrame); playbackFrame = requestAnimationFrame(animateProgress); });
      audio.addEventListener('pause', () => { button.classList.remove('is-playing'); button.setAttribute('aria-label', button.dataset.playLabel!); cancelAnimationFrame(playbackFrame); });
      audio.addEventListener('timeupdate', update);
      audio.addEventListener('ended', () => { audio.currentTime = 0; update(); });
      seek.addEventListener('input', () => { if (audio.duration) { audio.currentTime = (Number(seek.value) / 1000) * audio.duration; update(); } });
      audio.addEventListener('loadedmetadata', update);
      audio.addEventListener('durationchange', update);
      audio.addEventListener('error', () => { current.textContent = button.dataset.unavailableLabel!; });
    }
  </script>
</Layout>
