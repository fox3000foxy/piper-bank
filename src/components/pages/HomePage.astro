---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/models.json';
import { formatNumber, languageLabel, localizedPath, t, type Locale } from '../../i18n/ui';

const { locale = 'fr' as Locale } = Astro.props;

const models = data.filter((m) => m.usable || m.piperPlus);
const sample = models.find((m) => m.slug === 'glados-french-medium-voice');
const totalVoices = models.reduce((sum, model) => sum + model.voices, 0);
const freshCutoff = Date.now() - 14 * 864e5;
const fresh = models
  .filter((m) => m.updated && new Date(m.updated + 'T00:00:00Z').getTime() >= freshCutoff)
  .sort((a, b) => (b.updated || '').localeCompare(a.updated || ''))
  .slice(0, 8);
const provenance = models.find((model) => model.dataset?.slug && model.avatar?.icon);
type Model = (typeof models)[number];
const featured = [
  models.find((m) => m.slug === 'glados-french-medium-voice'),
  models.find((m) => m.slug === 'siwis-french-fr-medium'),
  models.find((m) => m.slug === 'gilles-french-fr-low'),
  models.find((m) => m.langName === 'English' && m.quality === 'high'),
].filter(Boolean) as Model[];
const base = import.meta.env.BASE_URL;
---
<Layout title={t(locale, 'home.title')} rawTitle={locale === 'fr' ? 'PiperHub – Catalogue de voix Piper TTS' : 'PiperHub – Piper TTS voices catalogue'} active="home" locale={locale} pageUrl="/" description={t(locale, 'home.description')}>
  <main class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot"></span>PiperHub <span class="eyebrow-divider">/</span> {t(locale, 'home.eyebrow')}</p>
        <h1 id="home-title">{t(locale, 'home.headline')}<br /><span>{t(locale, 'home.headlineSecond')}</span></h1>
        <p class="hero-deck">{t(locale, 'home.deck')}</p>
        <div class="hero-actions">
          <a class="button-primary" href={localizedPath(base, locale, '/voices/')}>{t(locale, 'home.exploreVoices')} <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={localizedPath(base, locale, '/datasets/')}>{t(locale, 'home.seeDatasets')} <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-footnote">{t(locale, 'home.freeNote')}</p>
      </div>
      {sample && <figure class="sample-card" data-sample-player style={`--model-hue:${sample.avatar?.hue ?? 260}`}>
        <div class="sample-topline"><span class="sample-index">{t(locale, 'home.sampleIndex')}</span><a href={localizedPath(base, locale, `/model/${sample.slug}/`)} aria-label={t(locale, 'home.openSampleModel', { name: sample.name })}>{t(locale, 'home.modelDetails')} <span aria-hidden="true">↗</span></a></div>
        <div class="sample-voice"><span class="sample-avatar" style={`--h:${sample.avatar?.hue ?? 260}`} aria-hidden="true">{sample.avatar?.icon ? <img src={`${base}${sample.avatar.icon}`} alt="" /> : sample.avatar?.universe === 'default' ? <svg class="avatar-wave" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 13v6m5-11v16m5-19v22m5-17v12m5-8v4" /></svg> : sample.avatar?.emoji || sample.name[0]}</span><div><strong>{sample.name}</strong><span>{languageLabel(sample.lang, sample.langName, locale)} <i>·</i> {t(locale, 'quality.medium')} <i>·</i> {locale === 'fr' ? 'par' : 'by'} {sample.author}</span></div></div>
        <div class="sample-playback">
          <button class="sample-play" type="button" data-play-label={t(locale, 'home.listenSample')} data-pause-label={t(locale, 'home.pauseSample')} data-unavailable-label={t(locale, 'home.sampleUnavailable')} aria-label={t(locale, 'home.listenSample')}><svg class="play-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4.8 8 5.2-8 5.2z"/></svg><svg class="pause-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10m6-10v10"/></svg></button>
          <div class="wave-wrap"><div class="wave-display"><svg class="waveform" viewBox="0 0 540 56" preserveAspectRatio="none" role="img" aria-label={t(locale, 'home.waveform')}><path class="wave-base" d="M0 28 H540"/><path class="wave-bars" d="M4 27.5v1 M12 27.5v1 M20 26.995v2.01 M28 25.31v5.38 M36 23.845v8.31 M44 24.165v7.67 M52 25.24v5.52 M60 25.75v4.5 M68 23.945v8.11 M76 22.855v10.29 M84 23.24v9.52 M92 23.395v9.21 M100 24.445v7.11 M108 26.675v2.65 M116 27.29v1.42 M124 27.49v1.02 M132 27.5v1 M140 27.5v1 M148 27.5v1 M156 27.5v1 M164 27.5v1 M172 27.435v1.13 M180 26.935v2.13 M188 26.65v2.7 M196 24.89v6.22 M204 25.265v5.47 M212 26.395v3.21 M220 26.54v2.92 M228 26.52v2.96 M236 25.41v5.18 M244 23.85v8.3 M252 25.42v5.16 M260 27.315v1.37 M268 25.185v5.63 M276 24.75v6.5 M284 25.92v4.16 M292 27.45v1.1 M300 25.36v5.28 M308 24.325v7.35 M316 25.51v4.98 M324 26.13v3.74 M332 26.935v2.13 M340 24.48v7.04 M348 25.83v4.34 M356 26.59v2.82 M364 24.39v7.22 M372 25.85v4.3 M380 26.095v3.81 M388 25.17v5.66 M396 24.555v6.89 M404 26.81v2.38 M412 25.905v4.19 M420 24.19v7.62 M428 25.43v5.14 M436 26.955v2.09 M444 25.535v4.93 M452 25.565v4.87 M460 27.305v1.39 M468 27.465v1.07 M476 25.62v4.76 M484 24.83v6.34 M492 25.425v5.15 M500 25.44v5.12 M508 25.315v5.37 M516 25.775v4.45 M524 26.23v3.54 M532 27.08v1.84 M540 27.48v1.04"/></svg><input class="sample-seek" type="range" min="0" max="1000" value="0" aria-label={t(locale, 'home.samplePosition')} /></div><div class="sample-time"><span data-current-time>0:00</span><span>0:03</span></div></div>
        </div>
        <figcaption>{t(locale, 'home.sampleProvidedBy')} <a href="https://huggingface.co/datasets/fox3000foxy/piper-samples" target="_blank" rel="noreferrer">Piper samples ↗</a></figcaption>
        <audio preload="none" src={`${base}audio/glados-fr.wav`}></audio>
      </figure>}

    </section>

    <section class="home-statline" aria-label={t(locale, 'home.catalogStats')}>
      <p><span>{t(locale, 'home.openIndex')}</span><strong>{formatNumber(locale, models.length)}</strong> {t(locale, 'home.modelsInCatalog')}</p>
      <p><span>{t(locale, 'home.international')}</span><strong>{formatNumber(locale, new Set(models.map((model) => model.lang)).size)}</strong> {t(locale, 'home.languagesListed')}</p>
      <p><span>{t(locale, 'home.voicesNoCredits')}</span><strong>{formatNumber(locale, totalVoices)}</strong> {t(locale, 'home.speakersListed')}</p>
    </section>

    <section class="voices-preview" aria-labelledby="preview-title">
      <div class="section-heading preview-heading"><p class="eyebrow">{t(locale, 'home.catalogEyebrow')}</p><h2 id="preview-title">{t(locale, 'home.listenDifferences')}<br />{t(locale, 'home.differencesSecond')}</h2><p>{t(locale, 'home.catalogCopy')}</p><a class="text-link" href={localizedPath(base, locale, '/voices/')}>{t(locale, 'home.browseModels', { count: formatNumber(locale, models.length) })} <span aria-hidden="true">→</span></a></div>
      <div class="featured-list" aria-label={t(locale, 'home.openSamples')}>
        {featured.map((m, i) => <a class="featured-row" href={localizedPath(base, locale, `/model/${m.slug}/`)} style={`--model-hue:${m.avatar?.hue ?? 260}`}>
          <span class="row-number">0{i + 1}</span><span class="featured-avatar" style={`--h:${m.avatar?.hue ?? 260}`} aria-hidden="true">{m.avatar?.icon ? <img src={`${base}${m.avatar.icon}`} alt="" loading="lazy" /> : m.avatar?.universe === 'default' ? <svg class="avatar-wave" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 13v6m5-11v16m5-19v22m5-17v12m5-8v4" /></svg> : (m.avatar?.emoji || m.name[0])}</span><span class="row-name">{m.name.replace(/\s+(?:x[_\s]?)?(?:high|medium|low|unknown)$/i, '')}<small>{languageLabel(m.lang, m.langName, locale)} <i>·</i> {m.author}</small></span><span class="row-quality">{t(locale, m.quality === 'high' ? 'quality.high' : m.quality === 'medium' ? 'quality.medium' : m.quality === 'low' ? 'quality.low' : 'quality.unknown')}</span><span class="row-arrow" aria-hidden="true">↗</span>
        </a>)}
        <a class="all-voices" href={localizedPath(base, locale, '/voices/')}>{t(locale, 'home.allCollection')} <span>{t(locale, 'home.modelCount', { count: formatNumber(locale, models.length) })}</span><b aria-hidden="true">↗</b></a>
      </div>
    </section>

    {fresh.length > 0 && (
    <section class="voices-preview" aria-labelledby="fresh-title">
      <div class="section-heading preview-heading"><p class="eyebrow">{t(locale, 'home.freshEyebrow')}</p><h2 id="fresh-title">{t(locale, 'home.freshTitle')}</h2><p>{t(locale, 'home.freshCopy')}</p></div>
      <div class="featured-list" aria-label={t(locale, 'home.freshEyebrow')}>
        {fresh.map((m, i) => <a class="featured-row" href={localizedPath(base, locale, `/model/${m.slug}/`)} style={`--model-hue:${m.avatar?.hue ?? 260}`}>
          <span class="row-number">0{i + 1}</span><span class="featured-avatar" style={`--h:${m.avatar?.hue ?? 260}`} aria-hidden="true">{m.avatar?.icon ? <img src={`${base}${m.avatar.icon}`} alt="" loading="lazy" /> : m.avatar?.universe === 'default' ? <svg class="avatar-wave" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 13v6m5-11v16m5-19v22m5-17v12m5-8v4" /></svg> : (m.avatar?.emoji || m.name[0])}</span><span class="row-name">{m.name.replace(/\s+(?:x[_\s]?)?(?:high|medium|low|unknown)$/i, '')}<small>{languageLabel(m.lang, m.langName, locale)} <i>·</i> {m.author}</small></span><span class="row-quality">{m.updated}</span><span class="row-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </section>
    )}

    {provenance && <section class="source-feature" aria-labelledby="source-title" style={`--model-hue:${provenance.avatar?.hue ?? 260}`}>
      <div class="source-mark" style={`--h:${provenance.avatar?.hue ?? 260}`} aria-hidden="true"><img src={`${base}${provenance.avatar.icon}`} alt="" /></div>
      <div class="source-copy"><p class="eyebrow">{t(locale, 'home.sourceEyebrow')}</p><h2 id="source-title">{t(locale, 'home.sourceHeadline')}<br />{t(locale, 'home.sourceHeadlineSecond')}</h2><p><strong>{provenance.name}</strong> {t(locale, 'home.sourceCopy', { dataset: provenance.dataset!.name })}</p><div class="source-links"><a class="text-link text-link-inverse" href={localizedPath(base, locale, `/model/${provenance.slug}/`)}>{t(locale, 'home.modelSheet')} <span aria-hidden="true">↗</span></a><a class="text-link text-link-inverse" href={localizedPath(base, locale, `/dataset/${provenance.dataset!.slug}/`)}>{t(locale, 'home.datasetSheet')} <span aria-hidden="true">↗</span></a></div></div>
      <div class="source-meta"><span>{t(locale, 'home.modelDatasetPair')}</span><p>{languageLabel(provenance.lang, provenance.langName, locale)}<br /><b>·</b><br />{provenance.author}<br /><b>·</b><br />{t(locale, provenance.quality === 'high' ? 'quality.high' : provenance.quality === 'medium' ? 'quality.medium' : provenance.quality === 'low' ? 'quality.low' : 'quality.unknown')}</p><span>{t(locale, 'home.linkedResources')}</span></div>
    </section>}

    <section class="voices-preview" aria-labelledby="guides-title">
      <div class="section-heading preview-heading"><p class="eyebrow">{t(locale, 'home.guidesEyebrow')}</p><h2 id="guides-title">{t(locale, 'home.guidesTitle')}</h2><p>{t(locale, 'home.guidesCopy')}</p><a class="text-link" href={localizedPath(base, locale, '/guides/')}>{locale === 'fr' ? 'Tous les guides' : 'All guides'} <span aria-hidden="true">→</span></a></div>
      <div class="featured-list" aria-label={t(locale, 'home.guidesEyebrow')}>
        {([
          ['01', t(locale, 'home.guideDataset'), '#dataset-guide'],
          ['02', t(locale, 'home.guideTraining'), '#training-guide'],
          ['03', t(locale, 'home.guideUsage'), '#use-voice-guide'],
        ] as [string, string, string][]).map(([num, label, anchor]) => <a class="featured-row" href={localizedPath(base, locale, `/guides/${anchor}`)}>
          <span class="row-number">{num}</span><span class="row-name">{label}</span><span class="row-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </section>

    <section class="closing-note"><p class="eyebrow">{t(locale, 'home.yourTurn')}</p><div class="closing-copy"><h2>{t(locale, 'home.findVoice')}</h2><p>{t(locale, 'home.findVoiceCopy')}</p></div><a href={localizedPath(base, locale, '/voices/')} class="button-primary">{t(locale, 'home.openCatalog')} <span aria-hidden="true">↗</span></a></section>
  </main>
  <script>
    const card = document.querySelector('[data-sample-player]');
    if (card) {
      const audio = card.querySelector('audio') as HTMLAudioElement;
      const button = card.querySelector('.sample-play') as HTMLButtonElement;
      const seek = card.querySelector('.sample-seek') as HTMLInputElement;
      const current = card.querySelector('[data-current-time]') as HTMLElement;
      const bars = card.querySelector('.wave-bars') as SVGPathElement;
      const svg = card.querySelector('.waveform') as SVGSVGElement;
      let playbackFrame = 0;
      const clip = document.createElementNS('http://www.w3.org/2000/svg', 'clipPath');
      const clipRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      clip.id = 'wave-progress-clip';
      clip.setAttribute('clipPathUnits', 'userSpaceOnUse');
      clipRect.setAttribute('x', '0');
      clipRect.setAttribute('y', '0');
      clipRect.setAttribute('width', '0');
      clipRect.setAttribute('height', '56');
      clip.append(clipRect);
      svg.querySelector('defs')?.remove();
      const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
      defs.append(clip);
      svg.prepend(defs);
      const rest = bars.cloneNode(true) as SVGPathElement;
      rest.classList.remove('wave-bars');
      rest.classList.add('wave-rest');
      bars.before(rest);
      bars.setAttribute('clip-path', 'url(#wave-progress-clip)');
      const format = (value: number) => `${Math.floor(value / 60)}:${String(Math.floor(value % 60)).padStart(2, '0')}`;
      const update = () => {
        const progress = audio.duration ? Math.min(1, Math.max(0, audio.currentTime / audio.duration)) : 0;
        seek.value = String(Math.round(progress * 1000));
        current.textContent = format(audio.currentTime);
        clipRect.setAttribute('width', String(540 * progress));
        seek.setAttribute('aria-valuetext', `${format(audio.currentTime)} / ${format(audio.duration || 0)}`);
      };
      const animateProgress = () => {
        update();
        if (!audio.paused && !audio.ended) playbackFrame = requestAnimationFrame(animateProgress);
      };
      // Les attributs data-*-label du bouton sont toujours présents dans le balisage : pas de garde runtime.
      button.addEventListener('click', async () => {
        if (audio.paused) {
          try { await audio.play(); } catch { current.textContent = button.dataset.unavailableLabel!; }
        } else audio.pause();
      });
      audio.addEventListener('play', () => { button.classList.add('is-playing'); button.setAttribute('aria-label', button.dataset.pauseLabel!); cancelAnimationFrame(playbackFrame); playbackFrame = requestAnimationFrame(animateProgress); });
      audio.addEventListener('pause', () => { button.classList.remove('is-playing'); button.setAttribute('aria-label', button.dataset.playLabel!); cancelAnimationFrame(playbackFrame); });
      audio.addEventListener('timeupdate', update);
      audio.addEventListener('ended', () => { audio.currentTime = 0; update(); });
      seek.addEventListener('input', () => { if (audio.duration) { audio.currentTime = (Number(seek.value) / 1000) * audio.duration; update(); } });
      audio.addEventListener('loadedmetadata', update);
      audio.addEventListener('durationchange', update);
      audio.addEventListener('error', () => { current.textContent = button.dataset.unavailableLabel!; });
    }
  </script>
</Layout>
