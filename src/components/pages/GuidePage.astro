---
import Layout from '../../layouts/Layout.astro';
import DocsShell from '../DocsShell.astro';
import Icon from '../Icon.astro';
import { localizedPath, t, type Locale } from '../../i18n/ui';
import { guideCopy } from '../../i18n/guides';
import { docsNav } from '../../lib/docs-nav';

const { locale = 'en' as Locale } = Astro.props as { locale?: Locale };
const base = import.meta.env.BASE_URL;
const L = (p: string) => localizedPath(base, locale, p);
const { str, list } = guideCopy(locale);
const overview = docsNav(locale).flatMap((g) => g.items).slice(1);

const kaggleQuotaUrl = 'https://www.kaggle.com/docs/efficient-gpu-usage';
const kaggleNotebooksUrl = 'https://www.kaggle.com/docs/notebooks';
const p100NoticeUrl = 'https://www.kaggle.com/product-announcements/735239';
const discordUrl = 'https://discord.com/channels/1523276835712929946/1523277508378886156';
const voiceForumUrl = 'https://discord.com/channels/1523276835712929946/1523277617996894259';
const piperttsUrl = 'https://www.npmjs.com/package/pipertts';
const piperttsRepoUrl = 'https://github.com/itsrealfortune/pipertts';
const piperttsTypedocUrl = 'https://itsrealfortune.fr/pipertts/';

// HowTo rich result: both ordered lists of the page, in the page language.
const stepPairs: [string, string][] = [
  ['step1', 'step1copy'], ['step2', 'step2copy'], ['step3', 'step3copy'],
  ['step4', 'step4copy'], ['step5', 'step5copy'], ['step6', 'step6copy'],
  ['installTitle', 'installCopy'], ['downloadTitle', 'downloadCopy'],
  ['synthTitle', 'synthCopy'], ['textFileTitle', 'textFileTitle'],
  ['pythonTitle', 'pythonTitle'], ['homeAssistantTitle', 'homeAssistantCopy'],
  ['adviceTitle', 'adviceCopy'], ['npmHubTitle', 'npmHubCopy'],
];
const howtoSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: str('title'),
  description: str('description'),
  inLanguage: locale,
  step: stepPairs.filter(([n]) => str(n)).map(([n, tx], i) => ({ '@type': 'HowToStep', position: i + 1, name: str(n), text: str(tx) || str(n) })),
};
const headline = str('headline').split('\n');
---
<Layout title={str('title')} description={str('description')} active="guides" locale={locale} pageUrl="/guides/"
  breadcrumbs={[{ name: t(locale, 'nav.home'), path: '/' }, { name: t(locale, 'nav.docs'), path: '/guides/' }]}
  jsonLdExtra={[howtoSchema]}>
  <DocsShell locale={locale} current="/guides/">
    <header class="docs-head" id="top">
      <p class="label">{t(locale, 'nav.docs')}</p>
      <h1>{headline[0]} {headline[1]}</h1>
      <p class="lead">{str('intro')}</p>
    </header>

    <section id="overview" class="doc-section">
      <p class="doc-section-label">{t(locale, 'docs.groupStart')}</p>
      <h2>{t(locale, 'docs.overview')}</h2>
      <p class="doc-lede">{t(locale, 'docs.overviewCopy')}</p>
      <div class="overview-grid">
        {overview.map((d) => <a class="doc-card" href={L(d.path)}>
          <span class="doc-card-icon"><Icon name={d.icon} size={20} /></span>
          <h3>{d.title}</h3>
          <p>{d.summary}</p>
        </a>)}
      </div>
      <div class="callout"><Icon name="info" size={20} /><div><h3>{t(locale, 'docs.calloutTitle')}</h3><p>{t(locale, 'docs.calloutCopy')}</p></div></div>
    </section>

    <section id="dataset-guide" class="doc-section">
      <p class="doc-section-label">{str('archiveLabel')}</p>
      <h2>{str('datasetTitle')}</h2>
      <p class="doc-lede">{str('datasetIntro')}</p>
      <pre class="guide-code"><code>{str('archive')}</code></pre>
      <ol class="doc-steps">
        <li class="doc-step"><span class="doc-step-n">1</span><div><h3>{str('step1')}</h3><p>{str('step1copy')}</p><div class="doc-links"><a class="doc-link" href="https://huggingface.co/datasets?search=ljspeech" target="_blank" rel="noreferrer">{str('hfSearch')}<Icon name="external" size={14} /></a></div><p class="doc-note">{str('ytDlp')}</p></div></li>
        <li class="doc-step"><span class="doc-step-n">2</span><div><h3>{str('step2')}</h3><p>{str('step2copy')}</p><ul>{list('tools').map((tool) => <li>{tool}</li>)}</ul></div></li>
        <li class="doc-step"><span class="doc-step-n">3</span><div><h3>{str('step3')}</h3><p>{str('step3copy')}</p><pre class="guide-code"><code>{str('metadata')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">4</span><div><h3>{str('step4')}</h3><p>{str('step4copy')}</p><pre class="guide-code guide-code-command"><code>{str('zip')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">5</span><div><h3>{str('step5')}</h3><p>{str('step5copy')}</p><pre class="guide-code"><code>{str('yaml')}</code></pre><div class="doc-links"><a class="doc-link" href="https://huggingface.co/new-dataset" target="_blank" rel="noreferrer">{str('newDataset')}<Icon name="external" size={14} /></a><a class="doc-link" href="https://huggingface.co/fox3000foxy" target="_blank" rel="noreferrer">{str('exampleProfile')}<Icon name="external" size={14} /></a></div></div></li>
        <li class="doc-step"><span class="doc-step-n">6</span><div><h3>{str('step6')}</h3><p>{str('step6copy')}</p><div class="doc-links"><a class="doc-link doc-link-primary" href={discordUrl} target="_blank" rel="noreferrer"><Icon name="discord" size={14} />{str('forum')}</a></div></div></li>
      </ol>
    </section>

    <section id="training-guide" class="doc-section">
      <p class="doc-section-label">Kaggle · GPU</p>
      <h2>{str('trainingTitle')}</h2>
      <p class="doc-lede">{str('trainingIntro')}</p>
      <div class="facts">
        <article><span>{str('quotaTitle')}</span><strong>{str('quotaValue')}</strong><p>{str('quotaCopy')}</p></article>
        <article><span>{str('sessionTitle')}</span><strong>{str('sessionValue')}</strong><p>{str('sessionCopy')}</p></article>
        <article><span>{str('acceleratorTitle')}</span><strong>T4 ×2</strong><p>{str('acceleratorCopy')}</p></article>
      </div>
      <div class="callout"><Icon name="clock" size={20} /><div><h3>{str('resumeTitle')}</h3><p>{str('resumeCopy')}</p></div></div>
      <div class="doc-checklist"><h3>{str('beforeTitle')}</h3><ul>{list('beforeList').map((item) => <li>{item}</li>)}</ul></div>
      <div class="doc-links">
        <a class="doc-link" href={kaggleQuotaUrl} target="_blank" rel="noreferrer">{str('kaggleQuota')}<Icon name="external" size={14} /></a>
        <a class="doc-link" href={kaggleNotebooksUrl} target="_blank" rel="noreferrer">{str('kaggleNotebooks')}<Icon name="external" size={14} /></a>
        <a class="doc-link" href={p100NoticeUrl} target="_blank" rel="noreferrer">{str('p100Notice')}<Icon name="external" size={14} /></a>
      </div>
      <div class="callout callout-warning"><Icon name="warning" size={20} /><div><p>{str('footnote')}</p></div></div>
    </section>

    <section id="use-voice-guide" class="doc-section">
      <p class="doc-section-label">Piper · CLI · Python</p>
      <h2>{str('useVoiceTitle')}</h2>
      <p class="doc-lede">{str('useVoiceIntro')}</p>
      <ol class="doc-steps">
        <li class="doc-step"><span class="doc-step-n">1</span><div><h3>{str('installTitle')}</h3><p>{str('installCopy')}</p><pre class="guide-code guide-code-command"><code>python -m pip install piper-tts</code></pre><pre class="guide-code guide-code-command"><code>python -m piper.download_voices en_US-lessac-medium</code></pre><div class="doc-links"><a class="doc-link" href="https://github.com/OHF-Voice/piper1-gpl/releases" target="_blank" rel="noreferrer">{str('piperProject')}<Icon name="external" size={14} /></a></div></div></li>
        <li class="doc-step"><span class="doc-step-n">2</span><div><h3>{str('downloadTitle')}</h3><p>{str('downloadCopy')}</p><pre class="guide-code"><code>voice.onnx{'\n'}voice.onnx.json</code></pre><div class="doc-links"><a class="doc-link doc-link-primary" href={L('/voices/')}><Icon name="mic" size={14} />{t(locale, 'docs.browseCatalog')}</a><a class="doc-link" href="https://huggingface.co/rhasspy/piper-voices" target="_blank" rel="noreferrer">{str('voiceCatalog')}<Icon name="external" size={14} /></a><a class="doc-link" href={voiceForumUrl} target="_blank" rel="noreferrer">{str('voiceForum')}<Icon name="external" size={14} /></a></div></div></li>
        <li class="doc-step"><span class="doc-step-n">3</span><div><h3>{str('synthTitle')}</h3><p>{str('synthCopy')}</p><pre class="guide-code"><code>{str('synthCommand')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">4</span><div><h3>{str('textFileTitle')}</h3><pre class="guide-code"><code>python -m piper -m ./voice.onnx -f output.wav --input-file input.txt</code></pre><h4>{str('rawTitle')}</h4><p>{str('rawCopy')}</p><pre class="guide-code"><code>{str('rawCommand')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">5</span><div><h3>{str('pythonTitle')}</h3><pre class="guide-code"><code>{str('pythonExample')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">6</span><div><h3>{str('homeAssistantTitle')}</h3><p>{str('homeAssistantCopy')}</p><div class="doc-links"><a class="doc-link" href="https://www.home-assistant.io/integrations/piper/" target="_blank" rel="noreferrer">{str('homeAssistantLink')}<Icon name="external" size={14} /></a></div><h4>{str('nodeRedTitle')}</h4><p>{str('nodeRedCopy')}</p><div class="doc-links"><a class="doc-link" href="https://nodered.org/docs/user-guide/nodes" target="_blank" rel="noreferrer">Node-RED<Icon name="external" size={14} /></a></div></div></li>
        <li class="doc-step"><span class="doc-step-n">7</span><div><h3>{str('adviceTitle')}</h3><p>{str('adviceCopy')}</p><pre class="guide-code"><code>{str('slowCommand')}</code></pre><div class="doc-links"><a class="doc-link" href="https://github.com/OHF-Voice/piper1-gpl/blob/main/docs/CLI.md" target="_blank" rel="noreferrer">{str('piperDocs')}<Icon name="external" size={14} /></a><a class="doc-link" href="https://github.com/OHF-Voice/piper1-gpl/blob/main/docs/API_PYTHON.md" target="_blank" rel="noreferrer">{str('pythonDocs')}<Icon name="external" size={14} /></a><a class="doc-link" href="https://github.com/rhasspy/piper" target="_blank" rel="noreferrer">rhasspy/piper<Icon name="external" size={14} /></a></div></div></li>
      </ol>
    </section>

    <section id="pipertts-guide" class="doc-section">
      <p class="doc-section-label">Node.js · TypeScript</p>
      <h2>{str('npmTitle')}</h2>
      <p class="doc-lede">{str('npmIntro')}</p>
      <ol class="doc-steps">
        <li class="doc-step"><span class="doc-step-n">1</span><div><h3>{str('npmInstall')}</h3><p>{str('npmInstallCopy')}</p><pre class="guide-code"><code>{str('npmInstallCommand')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">2</span><div><h3>{str('npmQuickStart')}</h3><pre class="guide-code"><code>{str('npmExample')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">3</span><div><h3>{str('npmHubTitle')}</h3><p>{str('npmHubCopy')}</p><pre class="guide-code"><code>{str('npmHubExample')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">4</span><div><h3>{str('npmCustomVoice')}</h3><p>{str('npmCustomCopy')}</p><pre class="guide-code"><code>{str('npmCustomExample')}</code></pre></div></li>
        <li class="doc-step"><span class="doc-step-n">5</span><div><h3>{str('npmApi')}</h3><p>{str('npmApiCopy')}</p></div></li>
        <li class="doc-step"><span class="doc-step-n">6</span><div><h3>{str('npmLegacy')}</h3><p>{str('npmLegacyCopy')}</p><pre class="guide-code"><code>{str('npmLegacyExample')}</code></pre><div class="doc-links"><a class="doc-link" href={piperttsUrl} target="_blank" rel="noreferrer">{str('npmHome')}<Icon name="external" size={14} /></a><a class="doc-link" href={piperttsRepoUrl} target="_blank" rel="noreferrer">{str('npmRepo')}<Icon name="external" size={14} /></a><a class="doc-link" href={piperttsTypedocUrl} target="_blank" rel="noreferrer">{str('npmTypedoc')}<Icon name="external" size={14} /></a></div></div></li>
      </ol>
    </section>

    <nav class="doc-pager" aria-label={t(locale, 'nav.docs')}>
      <a class="next" href={L('/guides-piper-plus/')}><span>{t(locale, 'docs.next')}</span><strong>{str('ppTitle')}</strong></a>
    </nav>
  </DocsShell>
</Layout>
