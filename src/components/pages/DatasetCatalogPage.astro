---
import Layout from '../../layouts/Layout.astro';
import datasetsData from '../../data/datasets.json';
import { formatNumber, languageLabel, localizedPath, t, type Locale } from '../../i18n/ui';

const { locale = 'fr' as Locale } = Astro.props;

const datasets = datasetsData;
const base = import.meta.env.BASE_URL;

const noModel = datasets.filter((d) => !d.modelSlug);
const hasModel = datasets.filter((d) => d.modelSlug);
---

<Layout title={t(locale, 'datasets.title')} active="datasets" locale={locale} pageUrl="/datasets/"
  description={t(locale, 'datasets.description')} subtitle={`${formatNumber(locale, datasets.length)} ${t(locale, 'datasets.count')} · LJSpeech`}>
    <header class="catalog-intro editorial-intro dataset-intro">
      <div><p class="eyebrow">{t(locale, 'datasets.eyebrow')}</p><h1>{t(locale, 'datasets.heading')}</h1></div>
      <div class="catalog-description"><p>{t(locale, 'datasets.intro')}</p><span class="catalog-count">{formatNumber(locale, datasets.length)} {t(locale, 'datasets.count')} <i>·</i> {t(locale, 'datasets.licenses')}</span></div>
    </header>

    <section class="dataset-filters" aria-label={t(locale, 'datasets.filters')}>
      <label class="search-field">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.7" cy="8.7" r="5.8"/><path d="m13 13 4.2 4.2"/></svg>
        <input id="search" type="search" placeholder={t(locale, 'datasets.searchPlaceholder')} autocomplete="off" aria-label={t(locale, 'datasets.searchLabel')} />
      </label>
      <div class="dataset-filter-options" role="group" aria-label={t(locale, 'datasets.modelState')}>
        <button class="filter-option is-on" data-f="all">{t(locale, 'datasets.all')} <span>{formatNumber(locale, datasets.length)}</span></button>
        <button class="filter-option" data-f="with">{t(locale, 'datasets.withModel')} <span>{formatNumber(locale, hasModel.length)}</span></button>
        <button class="filter-option" data-f="without">{t(locale, 'datasets.toTrain')} <span>{formatNumber(locale, noModel.length)}</span></button>
      </div>
      <span id="count" class="count" data-template={t(locale, 'datasets.results')} data-number-locale={locale === 'fr' ? 'fr-FR' : 'en-US'}></span>
    </section>

    <main id="grid" class="grid">
      {datasets.map((d) => (
          <a class="card ds" data-has={d.modelSlug ? '1' : '0'}
            href={localizedPath(base, locale, `/dataset/${d.slug}/`)}
            data-search={`${d.name} ${d.class} ${d.source} ${d.repo}`.toLowerCase()}>
            <h2>{d.name}</h2>
            <div class="meta">
              <span class="badge">{d.source || '-'}</span>
              <span class="badge">{languageLabel(d.lang, d.langName || d.lang, locale)}</span>
              {d.modelSlug
                ? <span class="badge ok">{t(locale, 'datasets.associated')}</span>
                : <span class="badge missing">{t(locale, 'datasets.toTrain')}</span>}
            </div>
            <p class="author">{d.repo && !d.repo.startsWith('↔') ? d.repo : (d.model || t(locale, 'datasets.noRepo'))}</p>
          </a>
      ))}
    </main>

    <script>
      const search = document.getElementById('search');
      const chips = [...document.querySelectorAll('.filter-option')];
      const cards = [...document.querySelectorAll('.card')];
      const count = document.getElementById('count');
      let f = 'all', q = '';
      function apply() {
        let n = 0;
        for (const c of cards) {
          const ok = (!q || c.dataset.search.includes(q))
            && (f === 'all' || (f === 'with') === (c.dataset.has === '1'));
          c.style.display = ok ? '' : 'none';
          if (ok) n++;
        }
        count.textContent = count.dataset.template.replace('{visible}', new Intl.NumberFormat(count.dataset.numberLocale).format(n)).replace('{total}', new Intl.NumberFormat(count.dataset.numberLocale).format(cards.length));
      }
      chips.forEach((c) => c.addEventListener('click', () => {
        chips.forEach((x) => x.classList.remove('is-on')); c.classList.add('is-on');
        f = c.dataset.f; apply();
      }));
      search.addEventListener('input', () => { q = search.value.toLowerCase().trim(); apply(); });
      apply();
    </script>
</Layout>
