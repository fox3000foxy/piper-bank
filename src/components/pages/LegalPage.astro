---
import Layout from '../../layouts/Layout.astro';
import { type Locale } from '../../i18n/ui';
import legalFr from '../../i18n/legal/fr.json';
import legalEn from '../../i18n/legal/en.json';
import legalde from '../../i18n/legal/de.json';
import legales from '../../i18n/legal/es.json';
import legalit from '../../i18n/legal/it.json';
import legalpt from '../../i18n/legal/pt.json';
import legalru from '../../i18n/legal/ru.json';
import legaltr from '../../i18n/legal/tr.json';
import legalja from '../../i18n/legal/ja.json';
import legalko from '../../i18n/legal/ko.json';
import legalzh from '../../i18n/legal/zh.json';
import legalid from '../../i18n/legal/id.json';
import legalhi from '../../i18n/legal/hi.json';
import legalar from '../../i18n/legal/ar.json';
import legalvi from '../../i18n/legal/vi.json';
import legalth from '../../i18n/legal/th.json';

const { locale = 'fr' as Locale, doc = 'privacy' as 'privacy' | 'terms' | 'legal' } = Astro.props as { locale?: Locale; doc?: 'privacy' | 'terms' | 'legal' };

// Traductions : un fichier par locale (src/i18n/legal/<code>.json).
// Les locales sans fichier retombent sur l'anglais (repli ci-dessous).
const copyByLocale = { fr: legalFr, en: legalEn, de: legalde, es: legales, it: legalit, pt: legalpt, ru: legalru, tr: legaltr, ja: legalja, ko: legalko, zh: legalzh, id: legalid, hi: legalhi, ar: legalar, vi: legalvi, th: legalth };
// Pages annexes : repli anglais tant que la locale n'a pas sa version.
const copy = (copyByLocale as unknown as Record<string, typeof copyByLocale.en>)[locale] ?? copyByLocale.en; // repli anglais (pages annexes non traduites)
---

<Layout title={doc === 'privacy' ? copy.privacyTitle : doc === 'terms' ? copy.termsTitle : copy.legalTitle} active="" locale={locale} pageUrl={`/${doc}/`} noindex
  description={doc === 'privacy' ? copy.privacyIntro : doc === 'terms' ? copy.termsIntro : copy.legalIntro}>
  <main class="legal-page">
    <p class="eyebrow">{doc === 'privacy' ? copy.privacyTitle : doc === 'terms' ? copy.termsTitle : copy.legalTitle}</p>
    <h1>{doc === 'privacy' ? copy.privacyTitle : doc === 'terms' ? copy.termsTitle : copy.legalTitle}</h1>
    {doc === 'privacy' ? (
      <>
        <p class="lede">{copy.privacyIntro}</p>
        <h2>{copy.privacyLocalTitle}</h2>
        <p>{copy.privacyLocal}</p>
        <h2>{copy.privacyThirdTitle}</h2>
        <p>{copy.privacyThird}</p>
        <h2>{copy.privacyContactTitle}</h2>
        <p>{copy.privacyContact} <a href="https://github.com/fox3000foxy/piper-bank">GitHub ↗</a></p>
        <p class="dim">{copy.effective}</p>
      </>
    ) : doc === 'terms' ? (
      <>
        <p class="lede">{copy.termsIntro}</p>
        <h2>{copy.termsVoicesTitle}</h2>
        <p>{copy.termsVoices}</p>
        <h2>{copy.termsUseTitle}</h2>
        <p>{copy.termsUse}</p>
        <h2>{copy.termsWarrantyTitle}</h2>
        <p>{copy.termsWarranty}</p>
        <p class="dim">{copy.effective}</p>
      </>
    ) : doc === 'legal' ? (
      <>
        <p class="lede">{copy.legalIntro}</p>
        <h2>{copy.legalEditorTitle}</h2>
        <p>{copy.legalEditor}</p>
        <h2>{copy.legalHostTitle}</h2>
        <p>{copy.legalHost}</p>
        <h2>{copy.legalIpTitle}</h2>
        <p>{copy.legalIp}</p>
        <p class="dim">{copy.effective}</p>
      </>
    ) : null}
  </main>
</Layout>
