---
import { t, type Locale } from '../i18n/ui';
const { model: m, size = 'md', locale = 'en' as Locale, lazy = true } = Astro.props as { model: any; size?: 'sm' | 'md' | 'lg' | 'xl'; locale?: Locale; lazy?: boolean };
const base = import.meta.env.BASE_URL;
const a = m.avatar || { hue: 220 };
const hue = a.hue ?? 220;
---
<span class={`mavatar mavatar-${size}`} style={`--h:${hue}`}>
  <span class="mavatar-face" aria-hidden="true">
    {a.icon
      ? <img src={`${base}${a.icon}`} alt="" loading={lazy ? 'lazy' : 'eager'} />
      : a.universe === 'default'
        ? <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 8.5v3M7 6v8M10 3.5v13M13 6.5v7M16 8.5v3" /></svg>
        : <span>{a.emoji || m.name[0]}</span>}
  </span>
  {a.certified && <span class="mavatar-badge" title={t(locale, 'detail.modelOfficial')}><svg viewBox="0 0 12 12" aria-hidden="true"><path d="m3.2 6.2 1.9 1.9 3.8-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr-only">{t(locale, 'detail.modelOfficial')}</span></span>}
</span>
